---
// The home screen's background: an aurora (after Aceternity's Aurora Background), recoloured to a dark, polished
// black. Two layers of repeating diagonal bands, one dark and one a silver sheen, are blurred together and drift
// slowly sideways; a radial mask keeps the light in the top right and the base fades into the page below. Plain CSS,
// decorative. Reduced motion holds it still.
---
<div class="aurora" aria-hidden="true"><div class="layer"></div></div>

<style>
  .aurora { position: absolute; inset: 0; z-index: -2; overflow: hidden; pointer-events: none; background: #050506;
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent); mask-image: linear-gradient(to bottom, #000 70%, transparent); }
  .layer {
    --dark: repeating-linear-gradient(100deg, #050506 0%, #050506 7%, transparent 10%, transparent 12%, #050506 16%);
    --sheen: repeating-linear-gradient(100deg, #2b2b31 10%, #75757f 15%, #3a3a41 20%, #c4c4cc 25%, #4b4b53 30%);
    position: absolute; inset: -10px; opacity: .55; filter: blur(10px); will-change: transform;
    background-image: var(--dark), var(--sheen); background-size: 300%, 200%; background-position: 50% 50%, 50% 50%;
    -webkit-mask-image: radial-gradient(ellipse at 100% 0%, #000 10%, transparent 70%); mask-image: radial-gradient(ellipse at 100% 0%, #000 10%, transparent 70%);
  }
  .layer::after { content: ''; position: absolute; inset: 0; background-image: var(--dark), var(--sheen); background-size: 200%, 100%; background-attachment: fixed;
    mix-blend-mode: difference; animation: aurora 60s linear infinite; }
  @keyframes aurora { from { background-position: 50% 50%, 50% 50%; } to { background-position: 350% 50%, 350% 50%; } }
  /* light: the same drifting bands on the page's paper, the sheen in soft silvers, multiplied in rather than inverted */
  :global(:root[data-theme="light"]) .aurora { background: #F4F4F2; }
  :global(:root[data-theme="light"]) .layer {
    --dark: repeating-linear-gradient(100deg, #F4F4F2 0%, #F4F4F2 7%, transparent 10%, transparent 12%, #F4F4F2 16%);
    --sheen: repeating-linear-gradient(100deg, #e4e4e0 10%, #b9b9b6 15%, #dadad6 20%, #9f9fa4 25%, #d0d0cc 30%);
    opacity: .7; }
  :global(:root[data-theme="light"]) .layer::after { mix-blend-mode: multiply; }
  :global(:root[data-motion="calm"]) .layer::after { animation: none; }
</style>
