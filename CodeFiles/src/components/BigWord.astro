---
// Oversized display words. With `fill`, they fill in as they scroll past (ref: 02-lusion; see motion.css).
interface Props { text: string; href?: string; label?: string; fill?: boolean }   // fill: fills in as it scrolls past
const { text, href, label, fill = false } = Astro.props;
---
{href
  ? <a class="big display" href={href} aria-label={label} data-fill={fill || undefined}>{text}</a>
  : <p class="big display" data-fill={fill || undefined}>{text}</p>}
<style>
  .big { display: block; font-size: var(--t-h2); max-width: none; }
  a.big:hover { color: var(--accent); }
</style>
