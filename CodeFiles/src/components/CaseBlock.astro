---
// One case-study block: full-bleed image, two-up, text with image, pull quote or video. Missing media shows a
// labelled placeholder at the same ratio, so the layout is final before the real files exist.
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import MediaBlock from './MediaBlock.astro';
import Placeholder from './Placeholder.astro';
import ClusterPlayer from './ClusterPlayer.astro';
type Block = CollectionEntry<'projects'>['data']['blocks'][number];
interface Props { block: Block; title: string; n: number }
const { block: b, title, n } = Astro.props;
const label = `${title}, ${b.type === 'video' ? 'video' : 'image'} ${n}`;
const poster = b.type === 'video' && b.poster ? (await getImage({ src: b.poster, width: 1600 })).src : undefined;
---
{b.type === 'cluster' && <ClusterPlayer block={b} />}

{b.type === 'full' && <div class="block full wrap"><MediaBlock src={b.src} alt={b.alt} ratio={b.ratio} caption={b.caption} label={label} sizes="100vw" /></div>}

{b.type === 'two' && (
  <div class="block two wrap">
    {b.items.map((m, i) => <MediaBlock src={m.src} alt={m.alt} ratio={m.ratio} caption={m.caption} label={`${title}, image ${n}${'ab'[i]}`} sizes="(min-width: 720px) 48vw, 100vw" />)}
  </div>
)}

{b.type === 'text-image' && (
  <div class:list={['block', 'text-image', 'wrap', 'grid', { flip: b.flip }]}>
    <p class="text" data-reveal>{b.text}</p>
    <div class="pic"><MediaBlock src={b.src} alt={b.alt} ratio={b.ratio} caption={b.caption} label={label} sizes="(min-width: 720px) 40vw, 100vw" /></div>
  </div>
)}

{b.type === 'quote' && (
  <figure class="block quote wrap grid" data-reveal>
    <blockquote class="display"><p>{b.text}</p></blockquote>
    {b.cite && <figcaption class="mono muted">{b.cite}</figcaption>}
  </figure>
)}

{b.type === 'video' && (
  <figure class="block video wrap">
    {b.src
      ? <video src={b.src} poster={poster} controls muted loop playsinline autoplay preload="metadata" data-autoplay aria-label={b.alt || label} style={`aspect-ratio:${b.ratio}`}></video>
      : <Placeholder ratio={b.ratio} label={label} size="1920 × 1080, MP4" />}
    {b.caption && <figcaption class="mono muted">{b.caption}</figcaption>}
  </figure>
)}

<style>
  .block { margin-top: var(--s12); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); align-items: start; }
  .text-image { align-items: end; row-gap: var(--s4); }
  .text-image .text { grid-column: 2 / span 4; font-size: var(--t-lead); }
  .text-image .pic { grid-column: 7 / span 5; }
  .text-image.flip .text { grid-column: 8 / span 4; order: 2; }
  .text-image.flip .pic { grid-column: 2 / span 5; }
  .quote blockquote { grid-column: 2 / span 9; margin: 0; font-size: clamp(2.25rem, 1rem + 4vw, 5.5rem); text-wrap: balance; }
  .quote blockquote p { max-width: none; }
  .quote blockquote p::before { content: "“"; } .quote blockquote p::after { content: "”"; }
  .quote figcaption { grid-column: 2 / span 9; margin-top: var(--s3); }
  video { display: block; width: 100%; background: var(--surface); }
  .video figcaption { margin-top: 10px; }
  @media (max-width: 720px) {
    .two { grid-template-columns: 1fr; }
    .text-image > *, .text-image.flip > *, .quote > * { grid-column: 1 / -1 !important; }
  }
</style>
