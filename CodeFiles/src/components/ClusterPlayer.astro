---
// The real cluster screens, one at a time, grouped by driving mode. Screens share one layout, so cross-fading
// between them reads as the cluster itself changing state. Each step pairs what the sensors do with what the
// driver sees. Plays through on its own while on screen (motion allowed); any click, hover or focus takes over.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
type Block = Extract<CollectionEntry<'projects'>['data']['blocks'][number], { type: 'cluster' }>;
interface Props { block: Block }
const { block } = Astro.props;
const all = block.modes.flatMap((m, mi) => m.steps.map((s, si) => ({ ...s, mi, si })));
---
<div class="cp" data-cp>
  <div class="screen" style={`aspect-ratio:${block.ratio}`}>
    {all.map((s, k) => <Image class:list={['shot', { on: k === 0 }]} src={s.src} alt={s.alt} widths={[640, 1280, 1920]} sizes="(min-width: 960px) 62vw, 100vw" data-shot={k} loading={k === 0 ? 'eager' : 'lazy'} />)}
    <div class="bar" aria-hidden="true"><i data-bar></i></div>
  </div>

  <div class="side">
    <div class="modes" role="group" aria-label="Driving mode" style={`--n:${block.modes.length}`}>
      <span class="thumb-bg" aria-hidden="true"></span>
      {block.modes.map((m, mi) => <button type="button" data-mode={mi} aria-pressed={mi === 0 ? 'true' : 'false'}>{m.name} <span class="count">{m.steps.length}</span></button>)}
    </div>
    {block.modes.map((m, mi) => (
      <ol class="steps" data-steps={mi} hidden={mi !== 0}>
        {m.steps.map((s, si) => {
          const k = all.findIndex((a) => a.mi === mi && a.si === si);
          return <li><button type="button" class="step" data-step={k} aria-current={k === 0 ? 'step' : undefined}>
            <Image class="tn" src={s.src} alt="" widths={[160]} sizes="80px" loading="lazy" />
            <span class="tt">{s.title}</span><svg class="go" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" /></svg>
            <i class="prog" aria-hidden="true"></i>
          </button></li>;
        })}
      </ol>
    ))}
    <div class="notes" aria-live="polite">
      {all.map((s, k) => (
        <div class:list={['note', { on: k === 0 }]} data-note={k} hidden={k !== 0}>
          {s.sensors && <p><span class="k">Sensors</span>{s.sensors}</p>}
          <p><span class="k">Screen</span>{s.screen}</p>
        </div>
      ))}
    </div>
    <button type="button" class="play" data-play><span class="ico" aria-hidden="true"></span><span data-play-label>Pause</span> autoplay</button>
  </div>
</div>

<style>
  .cp { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 32px; align-items: start; padding-inline: var(--inset); }
  .screen { position: relative; border-radius: var(--radius); overflow: hidden; background: #050505; }
  .shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; scale: 1.015;
    transition: opacity 600ms var(--ease-smooth-out), scale 900ms var(--ease-out-expo); }
  .shot.on { opacity: 1; scale: 1; }
  .bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(255, 255, 255, .12); }
  .bar i { position: absolute; inset: 0; background: var(--accent); transform-origin: 0 50%; scale: var(--t, 0) 1; }

  .side { display: grid; gap: 14px; align-content: start; }
  /* segmented control with a sliding thumb (transitions.dev tabs sliding) */
  .modes { position: relative; display: grid; grid-template-columns: repeat(var(--n), 1fr); padding: 4px; border-radius: 999px; background: var(--surface); }
  .thumb-bg { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc((100% - 8px) / var(--n)); border-radius: 999px;
    background: var(--ink); translate: calc(var(--m, 0) * 100%) 0; transition: translate 350ms var(--ease-smooth-out); }
  .modes button { position: relative; min-height: 44px; border-radius: 999px; color: var(--graphite); font-weight: 500; transition: color 250ms; }
  .modes button:hover { color: var(--ink); }
  .modes button[aria-pressed="true"] { color: var(--paper); }
  .count { margin-left: 4px; font-variant-numeric: tabular-nums; opacity: .7; }
  .steps { display: grid; gap: 6px; }
  .step { position: relative; overflow: hidden; display: grid; grid-template-columns: 64px 1fr auto; gap: 14px; align-items: center; width: 100%;
    padding: 8px 14px 8px 8px; border-radius: 12px; background: var(--surface); text-align: left; color: var(--graphite); font-size: var(--t-small); font-weight: 500;
    transition: background-color 200ms, color 200ms; }
  .step :global(.tn) { width: 64px; height: 32px; object-fit: cover; border-radius: 6px; opacity: .7; transition: opacity 200ms; }
  .go { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; opacity: .4; translate: -4px 0;
    transition: opacity 200ms, translate 300ms var(--ease-out-expo); }
  .step:hover { color: var(--ink); background: var(--surface-2); }
  .step:hover .go { opacity: 1; translate: 0 0; }
  .step:hover :global(.tn), .step[aria-current] :global(.tn) { opacity: 1; }
  .step[aria-current] { color: var(--ink); background: var(--surface-2); }
  .step[aria-current] .go { color: var(--accent); opacity: 1; }
  .prog { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: var(--accent); transform-origin: 0 50%; scale: 0 1; }
  .step[aria-current] .prog { scale: var(--t, 0) 1; }
  .notes { display: grid; min-height: 7.5em; margin-top: 6px; }
  .note { grid-area: 1 / 1; display: grid; gap: 10px; }
  .note p { font-size: var(--t-small); line-height: 1.5; color: var(--ink); }
  .note .k { display: block; color: var(--accent); font-weight: 500; margin-bottom: 2px; }
  .play { justify-self: start; display: inline-flex; align-items: center; gap: 10px; min-height: 40px; padding: 0 16px; border-radius: 999px; background: var(--surface); color: var(--graphite); font-weight: 500; font-size: var(--t-small); }
  .play:hover { color: var(--ink); background: var(--surface-2); }
  .ico { width: 10px; height: 10px; border-left: 3px solid currentColor; border-right: 3px solid currentColor; }
  .play.paused .ico { border: 0; width: 0; height: 0; border-left: 10px solid currentColor; border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
  :global(:root[data-motion="calm"]) .shot { scale: 1; transition: opacity 300ms; }
  @media (max-width: 960px) { .cp { grid-template-columns: 1fr; padding-inline: var(--edge); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cp]').forEach((cp) => {
    const shots = [...cp.querySelectorAll<HTMLElement>('[data-shot]')];
    const notes = [...cp.querySelectorAll<HTMLElement>('[data-note]')];
    const steps = [...cp.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const lists = [...cp.querySelectorAll<HTMLElement>('[data-steps]')];
    const modes = [...cp.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    const bar = cp.querySelector<HTMLElement>('[data-bar]')!, play = cp.querySelector<HTMLButtonElement>('[data-play]')!;
    const modeOf = (k: number) => lists.findIndex((l) => l.contains(steps.find((s) => +s.dataset.step! === k)!));
    const reduce = document.documentElement.dataset.motion === 'calm';
    const HOLD = 3600;
    let cur = 0, playing = !reduce, held = false, visible = false, elapsed = 0, last = performance.now();

    const show = (k: number) => {
      cur = (k + shots.length) % shots.length; elapsed = 0;
      shots.forEach((s, i) => s.classList.toggle('on', i === cur));
      notes.forEach((n, i) => (n.hidden = i !== cur));
      steps.forEach((s) => (+s.dataset.step! === cur ? s.setAttribute('aria-current', 'step') : s.removeAttribute('aria-current')));
      const m = modeOf(cur);
      lists.forEach((l, i) => (l.hidden = i !== m));
      modes.forEach((b, i) => b.setAttribute('aria-pressed', String(i === m)));
      cp.querySelector<HTMLElement>('.modes')!.style.setProperty('--m', String(m));
    };
    const label = play.querySelector<HTMLElement>('[data-play-label]')!;
    const setPlaying = (p: boolean) => { playing = p; elapsed = 0; label.textContent = p ? 'Pause' : 'Play'; play.classList.toggle('paused', !p); };
    setPlaying(playing);

    steps.forEach((s) => s.addEventListener('click', () => { show(+s.dataset.step!); setPlaying(false); }));
    modes.forEach((b, i) => b.addEventListener('click', () => { show(+lists[i].querySelector<HTMLElement>('[data-step]')!.dataset.step!); }));
    play.addEventListener('click', () => setPlaying(!playing));
    cp.addEventListener('pointerenter', () => (held = true)); cp.addEventListener('pointerleave', () => (held = false));
    cp.addEventListener('focusin', () => (held = true)); cp.addEventListener('focusout', () => (held = false));
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(cp);

    // the step timer only runs while playing, on screen and not being looked at closely (hover or focus)
    const tick = (now: number) => {
      if (playing && visible && !held) { elapsed += now - last; if (elapsed >= HOLD) show(cur + 1); }
      last = now;
      bar.style.setProperty('--t', (elapsed / HOLD).toFixed(3)); cp.style.setProperty('--t', (elapsed / HOLD).toFixed(3));
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
