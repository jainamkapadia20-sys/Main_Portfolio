---
// The real cluster screens, one at a time, grouped by driving mode. Screens share one layout, so cross-fading
// between them reads as the cluster itself changing state. Each step pairs what the sensors do with what the
// driver sees. Plays through on its own while on screen (motion allowed); any click, hover or focus takes over.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
type Block = Extract<CollectionEntry<'projects'>['data']['blocks'][number], { type: 'cluster' }>;
interface Props { block: Block }
const { block } = Astro.props;
const all = block.modes.flatMap((m, mi) => m.steps.map((s, si) => ({ ...s, mi, si })));
const pad = (n: number) => String(n).padStart(2, '0');
---
<div class="cp wrap" data-cp>
  <div class="screen" style={`aspect-ratio:${block.ratio}`}>
    {all.map((s, k) => <Image class:list={['shot', { on: k === 0 }]} src={s.src} alt={s.alt} widths={[640, 1280, 1920]} sizes="(min-width: 960px) 62vw, 100vw" data-shot={k} loading={k === 0 ? 'eager' : 'lazy'} />)}
    <span class="corners" aria-hidden="true"></span>
    <div class="bar" aria-hidden="true"><i data-bar></i></div>
  </div>

  <div class="side">
    <p class="hint mono"><span aria-hidden="true">↓</span> Pick a mode, then a moment</p>
    <div class="modes mono" role="group" aria-label="Driving mode" style={`--n:${block.modes.length}`}>
      <span class="thumb-bg" aria-hidden="true"></span>
      {block.modes.map((m, mi) => <button type="button" data-mode={mi} aria-pressed={mi === 0 ? 'true' : 'false'}>{m.name} <span class="count">{pad(m.steps.length)}</span></button>)}
    </div>
    {block.modes.map((m, mi) => (
      <ol class="steps" data-steps={mi} hidden={mi !== 0}>
        {m.steps.map((s, si) => {
          const k = all.findIndex((a) => a.mi === mi && a.si === si);
          return <li><button type="button" class="step" data-step={k} aria-current={k === 0 ? 'step' : undefined}>
            <Image class="tn" src={s.src} alt="" widths={[160]} sizes="80px" loading="lazy" />
            <span class="n mono">{pad(si + 1)}</span><span class="tt">{s.title}</span><span class="go" aria-hidden="true">→</span>
            <i class="prog" aria-hidden="true"></i>
          </button></li>;
        })}
      </ol>
    ))}
    <div class="notes" aria-live="polite">
      {all.map((s, k) => (
        <div class:list={['note', { on: k === 0 }]} data-note={k} hidden={k !== 0}>
          {s.sensors && <p><span class="mono k">Sensors</span>{s.sensors}</p>}
          <p><span class="mono k">Screen</span>{s.screen}</p>
        </div>
      ))}
    </div>
    <button type="button" class="play mono" data-play aria-pressed="false"><span class="ico" aria-hidden="true"></span><span data-play-label>Pause</span> autoplay</button>
  </div>
</div>

<style>
  .cp { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--s4); align-items: start; margin-top: var(--s8); }
  .result .cp, .flow .cp { padding-inline: 0; }
  .screen { grid-column: 1 / span 8; position: relative; background: #05060c; }
  .shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; scale: 1.015;
    transition: opacity 600ms var(--ease-smooth-out), scale 900ms var(--ease-out-expo); }
  .shot.on { opacity: 1; scale: 1; }
  .corners { position: absolute; inset: -12px; pointer-events: none; --c: var(--ink); --l: 18px;
    background:
      linear-gradient(var(--c), var(--c)) 0 0 / var(--l) 1px, linear-gradient(var(--c), var(--c)) 0 0 / 1px var(--l),
      linear-gradient(var(--c), var(--c)) 100% 0 / var(--l) 1px, linear-gradient(var(--c), var(--c)) 100% 0 / 1px var(--l),
      linear-gradient(var(--c), var(--c)) 0 100% / var(--l) 1px, linear-gradient(var(--c), var(--c)) 0 100% / 1px var(--l),
      linear-gradient(var(--c), var(--c)) 100% 100% / var(--l) 1px, linear-gradient(var(--c), var(--c)) 100% 100% / 1px var(--l);
    background-repeat: no-repeat; }
  .bar { position: absolute; left: 0; right: 0; bottom: -22px; height: 2px; background: var(--rule); }
  .bar i { position: absolute; inset: 0; background: linear-gradient(90deg, var(--dusk), var(--accent)); transform-origin: 0 50%; scale: var(--t, 0) 1; }

  .side { grid-column: 9 / -1; display: grid; gap: var(--s2); align-content: start; }
  .hint { color: var(--dusk); }
  /* segmented control with a sliding thumb */
  .modes { position: relative; display: grid; grid-template-columns: repeat(var(--n), 1fr); padding: 4px; border: 1px solid var(--rule-strong);
    background: color-mix(in srgb, var(--surface) 80%, transparent); border-radius: 999px; }
  .thumb-bg { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc((100% - 8px) / var(--n)); border-radius: 999px;
    background: var(--ink); translate: calc(var(--m, 0) * 100%) 0; transition: translate 450ms var(--ease-out-expo); box-shadow: 0 0 24px color-mix(in srgb, var(--ink) 25%, transparent); }
  .modes button { position: relative; min-height: 44px; border-radius: 999px; color: var(--graphite); letter-spacing: inherit; text-transform: inherit; cursor: pointer; transition: color 250ms; }
  .modes button:hover { color: var(--ink); }
  .modes button[aria-pressed="true"] { color: var(--paper); }
  .count { opacity: .55; margin-left: 4px; }
  /* steps: cards with a thumbnail, clearly buttons */
  .steps { display: grid; gap: 8px; }
  .step { position: relative; overflow: hidden; display: grid; grid-template-columns: 72px auto 1fr auto; gap: 14px; align-items: center; width: 100%;
    padding: 8px 14px 8px 8px; border: 1px solid var(--rule-strong); border-radius: 12px; background: color-mix(in srgb, var(--surface) 70%, transparent);
    text-align: left; color: var(--graphite); font-size: var(--t-small); cursor: pointer;
    transition: border-color 200ms, background-color 200ms, color 200ms, translate 300ms var(--ease-out-expo); }
  .step :global(.tn) { width: 72px; height: 36px; object-fit: cover; border-radius: 6px; opacity: .7; transition: opacity 200ms; }
  .step .n { color: var(--graphite); }
  .step .tt { color: inherit; font-weight: 500; }
  .step .go { opacity: .4; translate: -4px 0; transition: opacity 200ms, translate 300ms var(--ease-out-expo); }
  .step:hover { border-color: var(--ink); color: var(--ink); translate: 4px 0; }
  .step:hover .go { opacity: 1; translate: 0 0; }
  .step:hover :global(.tn), .step[aria-current] :global(.tn) { opacity: 1; }
  .step[aria-current] { color: var(--ink); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--surface)); }
  .step[aria-current] .n, .step[aria-current] .go { color: var(--accent); opacity: 1; }
  .prog { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: linear-gradient(90deg, var(--dusk), var(--accent)); transform-origin: 0 50%; scale: 0 1; }
  .step[aria-current] .prog { scale: var(--t, 0) 1; }
  .notes { display: grid; min-height: 7.5em; margin-top: var(--s1); }
  .note { grid-area: 1 / 1; display: grid; gap: 10px; }
  .note p { font-size: var(--t-small); line-height: 1.5; color: var(--graphite); }
  .note .k { display: block; color: var(--dusk); margin-bottom: 2px; }
  .play { justify-self: start; display: inline-flex; align-items: center; gap: 10px; min-height: 40px; padding: 0 16px; border: 1px solid var(--rule-strong); border-radius: 999px; color: var(--graphite); cursor: pointer; }
  .play:hover { color: var(--ink); border-color: var(--ink); }
  .ico { width: 10px; height: 10px; border-left: 3px solid currentColor; border-right: 3px solid currentColor; }
  .play[aria-pressed="true"] .ico { border: 0; width: 0; height: 0; border-left: 10px solid currentColor; border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
  @media (prefers-reduced-motion: reduce) { .shot { scale: 1; transition: opacity 300ms; } }
  @media (max-width: 960px) { .screen, .side { grid-column: 1 / -1; } .side { margin-top: var(--s3); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cp]').forEach((cp) => {
    const shots = [...cp.querySelectorAll<HTMLElement>('[data-shot]')];
    const notes = [...cp.querySelectorAll<HTMLElement>('[data-note]')];
    const steps = [...cp.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const lists = [...cp.querySelectorAll<HTMLElement>('[data-steps]')];
    const modes = [...cp.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    const bar = cp.querySelector<HTMLElement>('[data-bar]')!, play = cp.querySelector<HTMLButtonElement>('[data-play]')!;
    const modeOf = (k: number) => lists.findIndex((l) => l.contains(steps.find((s) => +s.dataset.step! === k)!));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const HOLD = 3600;
    let cur = 0, playing = !reduce, held = false, visible = false, elapsed = 0, last = performance.now();

    const show = (k: number) => {
      cur = (k + shots.length) % shots.length; elapsed = 0;
      shots.forEach((s, i) => s.classList.toggle('on', i === cur));
      notes.forEach((n, i) => (n.hidden = i !== cur));
      steps.forEach((s) => (+s.dataset.step! === cur ? s.setAttribute('aria-current', 'step') : s.removeAttribute('aria-current')));
      const m = modeOf(cur);
      lists.forEach((l, i) => (l.hidden = i !== m));
      modes.forEach((b, i) => b.setAttribute('aria-pressed', String(i === m)));
      cp.querySelector<HTMLElement>('.modes')!.style.setProperty('--m', String(m));
    };
    const label = play.querySelector<HTMLElement>('[data-play-label]')!;
    const setPlaying = (p: boolean) => { playing = p; elapsed = 0; label.textContent = p ? 'Pause' : 'Play'; play.setAttribute('aria-pressed', String(!p)); };
    setPlaying(playing);

    steps.forEach((s) => s.addEventListener('click', () => { show(+s.dataset.step!); setPlaying(false); }));
    modes.forEach((b, i) => b.addEventListener('click', () => { show(+lists[i].querySelector<HTMLElement>('[data-step]')!.dataset.step!); }));
    play.addEventListener('click', () => setPlaying(!playing));
    cp.addEventListener('pointerenter', () => (held = true)); cp.addEventListener('pointerleave', () => (held = false));
    cp.addEventListener('focusin', () => (held = true)); cp.addEventListener('focusout', () => (held = false));
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(cp);

    // the step timer only runs while playing, on screen and not being looked at closely (hover or focus)
    const tick = (now: number) => {
      if (playing && visible && !held) { elapsed += now - last; if (elapsed >= HOLD) show(cur + 1); }
      last = now;
      bar.style.setProperty('--t', (elapsed / HOLD).toFixed(3)); cp.style.setProperty('--t', (elapsed / HOLD).toFixed(3));
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
