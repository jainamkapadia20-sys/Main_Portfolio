---
// The project wall (src/fx/carousel.ts): every project as a panel on a wall that curves around the viewer. Drag or
// use the buttons to turn it; click a side panel to bring it to the centre and the centred one to open it.
// A plain list of the same links sits underneath for screen readers and for visitors without JS.
import { getImage } from 'astro:assets';
import { sortedProjects } from '../lib/projects';
import { withBase } from '../lib/url';

const projects = await sortedProjects();
const items = await Promise.all(projects.map(async (p) => ({
  title: p.data.title,
  tag: p.data.category,
  subtitle: p.data.placeholder ? `${p.data.category} · Coming soon` : `${p.data.type}, ${p.data.year}`,
  href: withBase(`/work/${p.id}`),   // JSON props aren't rebased after the build, so prefix here
  src: p.data.cover ? (await getImage({ src: p.data.cover, width: 900, format: 'webp' })).src : undefined,
})));
const first = items[0];
const pad = (n: number) => String(n).padStart(2, '0');
---
<div class="cc" data-carousel={JSON.stringify(items)}>
  <div class="cc-stage" data-cc-stage tabindex="0" role="group" aria-roledescription="carousel"
    aria-label="Projects. Arrow keys turn the wall, Enter opens the centred project, Space pauses.">
    <div class="cc-wall" data-cc-wall></div>
  </div>
  <div class="cc-foot">
    <a class="cap" href={first.href} data-cap-link>
      <span class="cap-title" data-cap-title>{first.title}</span>
      <span class="cap-sub" data-cap-sub>{first.subtitle}</span>
    </a>
    <div class="ctrl">
      <button class="arrow" type="button" aria-label="Previous project" data-cc-prev><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg></button>
      <span class="count" data-cc-count>{pad(1)} / {pad(items.length)}</span>
      <button class="arrow" type="button" aria-label="Next project" data-cc-next><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg></button>
    </div>
  </div>
  <ul class="sr-only">
    {items.map((it) => <li><a href={it.href}>{it.title}, {it.subtitle}</a></li>)}
  </ul>
</div>

<style>
  .cc { display: grid; grid-template-rows: 1fr auto; height: min(78svh, 760px); min-height: 440px; }
  .cc-stage { position: relative; display: grid; place-items: center; overflow: hidden; cursor: grab; touch-action: pan-y; user-select: none; }
  .cc-stage:active { cursor: grabbing; }
  .cc-stage:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 12px; }
  .cc-wall { position: relative; transform-style: preserve-3d; pointer-events: none; }  /* hits go to the panels, never the empty wall box */
  /* panels are placed by JS; edges are rounded at the centre and scale with perspective */
  .cc-wall :global(.cc-panel) { position: absolute; inset: 0; display: block; border-radius: var(--cc-r); --bt-r: var(--cc-r); pointer-events: auto; transform-style: preserve-3d; backface-visibility: hidden; will-change: transform; }
  .cc-wall :global(.cc-panel img) { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: var(--cc-r); }
  /* the floor reflection: a flipped copy that fades out fast */
  .cc-wall :global(.cc-ref) { position: absolute; left: 0; top: calc(100% + 6px); opacity: .06; transform: scaleY(-1);
    mask-image: linear-gradient(to top, #000, transparent 45%); -webkit-mask-image: linear-gradient(to top, #000, transparent 45%); }
  .cc-wall :global(.cc-dim) { position: absolute; inset: 0 0 -100% 0; background: var(--paper); opacity: 0; border-radius: var(--cc-r); pointer-events: none; }

  .cc-foot { display: grid; justify-items: center; gap: 14px; padding: 4px var(--pad) 0; text-align: center; }
  .cap { display: grid; gap: 4px; transition: opacity 150ms var(--ease-smooth-out), translate 150ms var(--ease-smooth-out); }
  .cap-title { font-size: var(--t-lead); font-weight: 600; letter-spacing: -.02em; }
  .cap-sub { color: var(--graphite); font-size: var(--t-small); }
  .cap-out .cap { opacity: 0; translate: 0 6px; }
  .ctrl { display: flex; align-items: center; gap: 14px; }
  .count { min-width: 6ch; color: var(--graphite); font-size: var(--t-small); font-variant-numeric: tabular-nums; }
  .arrow { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--surface); color: var(--ink);
    transition: background-color var(--duration-fast) var(--ease-smooth-out); }
  .arrow:hover { background: var(--surface-2); }
  .arrow svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
</style>

<script>
  import { mountCarousel } from '../fx/carousel';
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((el) => mountCarousel(el, JSON.parse(el.dataset.carousel!)));
</script>
