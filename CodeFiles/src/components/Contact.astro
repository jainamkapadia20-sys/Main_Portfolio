---
// The close of every page: a full-screen stage where a red beam lands on the one field (src/fx/beam.ts). The field
// writes an email (there is no form backend), so the message opens in the visitor's mail app, ready to send.
interface Props { email: string; heading: string }
const { email, heading } = Astro.props;
---
<div class="stage" data-contact>
  <canvas class="laser" data-beam aria-hidden="true"></canvas>
  <div class="box" data-beam-box>
    <h2 class="h" id="contact-h">{heading}</h2>
    <form class="form" data-mail={email}>
      <label class="sr-only" for="contact-msg">Your message</label>
      <input id="contact-msg" name="msg" type="text" placeholder="Write a message" autocomplete="off" />
      <button type="submit" aria-label="Write the email">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </form>
    <p class="note">Opens your mail app with the message filled in, sent to {email}.</p>
  </div>
</div>

<style>
  .stage { position: relative; min-height: 100svh; display: grid; place-items: end center; padding: 0 var(--edge) clamp(56px, 9vw, 120px); overflow: hidden; }
  .laser { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .box { position: relative; width: min(640px, 100%); padding: clamp(28px, 4vw, 48px); border-radius: var(--radius); background: var(--surface); display: grid; gap: 20px; }
  .h { font-size: clamp(1.75rem, 1rem + 2.4vw, 2.75rem); }
  .form { position: relative; }
  input { width: 100%; height: 64px; padding: 0 64px 0 22px; border: 0; border-radius: 999px; background: var(--paper); font-size: var(--t-body); outline: none;
    transition: box-shadow var(--duration-fast) var(--ease-smooth-out); }
  input::placeholder { color: var(--graphite); }
  input:focus-visible { box-shadow: inset 0 0 0 2px var(--accent); }
  button { position: absolute; right: 8px; top: 8px; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
    background: var(--accent); color: var(--on-accent); transition: scale var(--duration-quick) var(--ease-smooth-out); }
  button:hover { scale: 1.06; }
  button:active { scale: .94; }
  button svg { width: 18px; height: 18px; }
  .note { font-size: var(--t-small); color: var(--graphite); }
</style>

<script>
  import { mountBeam } from '../fx/beam';
  document.querySelectorAll<HTMLElement>('[data-contact]').forEach((s) => {
    mountBeam(s.querySelector('[data-beam]')!, s.querySelector('[data-beam-box]')!);
    const form = s.querySelector<HTMLFormElement>('[data-mail]')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const msg = (new FormData(form).get('msg') as string).trim();
      location.href = `mailto:${form.dataset.mail}?subject=${encodeURIComponent('Hello from your portfolio')}${msg ? `&body=${encodeURIComponent(msg)}` : ''}`;
    });
  });
</script>
