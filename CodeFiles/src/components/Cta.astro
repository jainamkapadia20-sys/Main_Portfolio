---
// The primary action: a pill in the accent, or silver on the home screen's black aurora. On hover a point of light laps its border; on press it pulses outward.
// The shape and the effect live in global.css (.cta) so any link can carry them.
interface Props { href: string; tone?: 'accent' | 'quiet' | 'silver' }
const { href, tone = 'accent' } = Astro.props;
---
<a class:list={['btn', 'cta', { primary: tone === 'accent', silver: tone === 'silver' }]} href={href}><slot /></a>
