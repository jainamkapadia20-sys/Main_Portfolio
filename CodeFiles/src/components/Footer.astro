---
// The close of every page (after Jahed's Motion Footer). It sits fixed beneath the page and is uncovered as the page
// scrolls up off it, like lifting a curtain. A tilted band of tracked words runs across the top; "Let's connect?"
// rises in, large, in a cool gradient; glass pills to write, or find me elsewhere; and my name, huge and faint, sits
// behind it all. The bottom bar holds the copyright, a small credit and a way back to the top. Always dark.
import { site } from '../site';
const year = new Date().getFullYear();
const band = ['UI/UX design', 'HMI', 'Graphic design', 'Service design', 'Open to internships', 'Based in India'];
---
<div class="reveal" id="contact" data-reveal-footer>
  <footer class="foot" aria-labelledby="contact-h">
    <div class="grid" aria-hidden="true"></div>
    <div class="band" aria-hidden="true">
      <div class="band-track">
        {[0, 1].map(() => band.map((w) => <span>{w}<i>✦</i></span>))}
      </div>
    </div>

    <div class="body">
      <h2 id="contact-h" class="ask" data-ask>Let's connect?</h2>
      <div class="actions">
        <a class="pill big" href={`mailto:${site.email}`} data-copy-email={site.email}>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5.5h14v9H3z" /><path d="m3.5 6 6.5 5 6.5-5" /></svg>Email me
        </a>
        <a class="pill big" href={site.linkedin} rel="me">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 8v7M5 5.2v.1M9 15v-4.2c0-1.6 1-2.8 2.5-2.8S14 9.2 14 10.8V15M9 8v7" /></svg>LinkedIn
        </a>
      </div>
      <nav class="links" aria-label="Footer">
        <a class="pill" href="/work">Work</a>
        <a class="pill" href="/about">About</a>
        <a class="pill" href="/car">Off the clock</a>
        <a class="pill" href={site.instagram} rel="me">Instagram</a>
      </nav>
    </div>

    <p class="word" aria-hidden="true">{site.name}</p>

    <div class="bar">
      <p class="meta">© {year} {site.name}</p>
      <p class="credit meta">Designed &amp; built by <b>Jainam</b></p>
      <a class="top" href="#main" aria-label="Back to top">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 15V5M5.5 9.5 10 5l4.5 4.5" /></svg>
      </a>
    </div>
  </footer>
</div>

<style>
  /* the curtain: this box takes the footer's height in the page and clips it; the footer itself is pinned to the
     bottom of the screen, so the page scrolling up uncovers it */
  .reveal { position: relative; height: max(100svh, 640px); clip-path: inset(0); }
  .foot { position: fixed; inset: auto 0 0; height: max(100svh, 640px); overflow: hidden; display: grid; grid-template-rows: auto 1fr auto;
    background: #0B0A10; color: #EDEBF3; --line: hsl(0 0% 100% / .08); }
  .grid { position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 72px 72px; -webkit-mask: radial-gradient(70% 60% at 50% 40%, #000, transparent); mask: radial-gradient(70% 60% at 50% 40%, #000, transparent); }

  /* the band: tracked words on a slight tilt, running sideways */
  .band { position: relative; margin-top: clamp(32px, 6vh, 64px); rotate: -2deg; padding-block: 14px; overflow: hidden;
    border-block: 1px solid var(--line); background: hsl(0 0% 100% / .02); }
  .band-track { display: flex; width: max-content; animation: band 38s linear infinite; }
  .band span { display: inline-flex; align-items: center; gap: 28px; padding-inline: 14px; font-family: var(--font-mono); font-size: .8rem;
    letter-spacing: .32em; text-transform: uppercase; color: hsl(0 0% 100% / .62); white-space: nowrap; }
  .band i { font-style: normal; color: hsl(0 0% 100% / .3); padding-right: 14px; }
  @keyframes band { to { transform: translateX(-50%); } }

  .body { position: relative; z-index: 1; display: grid; justify-items: center; align-content: center; gap: clamp(24px, 4vh, 40px); padding-inline: var(--inset); text-align: center; }
  .ask { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(3rem, 1rem + 8vw, 9.5rem); letter-spacing: -.035em; line-height: .95;
    background: linear-gradient(180deg, #ffffff 30%, #8a8794); -webkit-background-clip: text; background-clip: text; color: transparent;
    transform-origin: 50% 80%; }
  .actions, .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .pill { display: inline-flex; align-items: center; gap: 10px; min-height: 40px; padding: 0 18px; border-radius: 999px; font-size: .95rem; color: hsl(0 0% 100% / .62);
    background: hsl(0 0% 100% / .04); box-shadow: inset 0 0 0 1px hsl(0 0% 100% / .1); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    transition: color 200ms ease, background-color 200ms ease, box-shadow 200ms ease, translate 300ms cubic-bezier(.3, 1.5, .4, 1); }
  .pill:hover, .pill:focus-visible { color: #fff; background: hsl(0 0% 100% / .09); box-shadow: inset 0 0 0 1px hsl(0 0% 100% / .22); translate: 0 -2px; }
  .pill.big { min-height: 56px; padding: 0 28px; font-size: 1.05rem; font-weight: 500; color: #fff; background: hsl(0 0% 100% / .06); }
  .pill svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  /* my name, huge and faint, behind everything */
  .word { position: absolute; left: 50%; bottom: -.18em; translate: -50% 0; margin: 0; white-space: nowrap; pointer-events: none;
    font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(3rem, 11.5vw, 15rem); letter-spacing: -.04em; line-height: 1;
    color: transparent; -webkit-text-stroke: 1px hsl(0 0% 100% / .14); background: linear-gradient(180deg, hsl(0 0% 100% / .1), transparent 80%);
    -webkit-background-clip: text; background-clip: text; }

  .bar { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding: 0 var(--inset) clamp(20px, 4vh, 36px); }
  .bar .meta { color: hsl(0 0% 100% / .5); }
  .credit { justify-self: center; padding: 10px 18px; border-radius: 999px; background: hsl(0 0% 100% / .04); box-shadow: inset 0 0 0 1px hsl(0 0% 100% / .1); }
  .credit b { color: #fff; font-weight: 600; letter-spacing: .08em; }
  .top { justify-self: end; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; color: #fff;
    background: hsl(0 0% 100% / .05); box-shadow: inset 0 0 0 1px hsl(0 0% 100% / .14); transition: background-color 200ms ease, translate 300ms cubic-bezier(.3, 1.5, .4, 1); }
  .top:hover { background: hsl(0 0% 100% / .12); translate: 0 -3px; }
  .top svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  @media (max-width: 720px) {
    .bar { grid-template-columns: 1fr auto; }
    .credit { display: none; }
  }
  :global(:root[data-motion="calm"]) .band-track { animation: none; }
</style>

<script>
  import { calm } from '../lib/motion';
  // As the curtain lifts, the question rises and grows into place and the band and name brighten with it.
  const box = document.querySelector<HTMLElement>('[data-reveal-footer]');
  const ask = box?.querySelector<HTMLElement>('[data-ask]');
  if (box && ask && !calm()) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = box.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / r.height));   // 0 as it starts to show, 1 fully open
      const e = 1 - Math.pow(1 - p, 3);
      ask.style.opacity = String(Math.min(1, e * 1.4));
      ask.style.transform = `translateY(${(1 - e) * 60}px) scale(${0.86 + 0.14 * e})`;
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    update();
  }
</script>
