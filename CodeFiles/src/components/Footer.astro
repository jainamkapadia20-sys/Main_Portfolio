---
// The close of every page: the full-screen laser contact, then links, then the name set across the full width.
import Contact from './Contact.astro';
import { site } from '../site';
---
<footer class="foot" id="contact" aria-labelledby="contact-h">
  <Contact email={site.email} heading="Have a project or an internship in mind?" />

  <div class="cols wrap">
    <div>
      <h3>Pages</h3>
      <a href="/work">Work</a><a href="/about">About</a><a href="/car">Off the clock</a>
    </div>
    <div>
      <h3>Elsewhere</h3>
      <a href={site.instagram} rel="me">Instagram</a><a href={site.linkedin} rel="me">LinkedIn</a>
      <a href={`mailto:${site.email}`} data-copy-email={site.email}>Copy my email</a>
    </div>
    <p class="status"><span class="dot" aria-hidden="true"></span>{site.status}</p>
  </div>

  <p class="name" aria-hidden="true">{site.name}</p>
  <p class="legal wrap small muted">© {new Date().getFullYear()} {site.name}</p>
</footer>

<style>
  .foot { margin-top: var(--section); padding-bottom: var(--edge); overflow: hidden; }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; padding-block: 72px 48px; }
  .cols div { display: grid; align-content: start; gap: 8px; }
  h3 { font-size: var(--t-small); font-weight: 500; letter-spacing: 0; color: var(--graphite); margin-bottom: 4px; }
  .cols a { justify-self: start; transition: color var(--duration-fast) var(--ease-smooth-out); }
  .cols a:hover { color: var(--accent); }
  .status { justify-self: end; display: inline-flex; align-items: center; gap: 10px; align-self: start; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  /* the name returns at full width as the last word on every page */
  .name { max-width: none; padding-inline: var(--edge); font-size: 12.4vw; font-weight: 500; letter-spacing: -.055em; line-height: .8; white-space: nowrap; }
  .legal { margin-top: 16px; }
  @media (max-width: 720px) {
    .cols { grid-template-columns: 1fr 1fr; }
    .status { grid-column: 1 / -1; justify-self: start; }
  }
</style>
