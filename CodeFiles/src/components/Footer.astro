---
// The close of every page, in the manner of davidecarusio.it's footer. A short ask on the page's own ground ("Let's
// connect?", a muted second line, one small button), then the footer itself in the page's inverse colours (light on
// the dark themes, dark on the light one): three columns of large links under small mono labels, a meta row, a hairline,
// and my name set as one huge lowercase word across the full width. As it scrolls in, the footer slides out from
// under the ask (it starts a quarter of its height higher) and a shade of the page colour lifts off it.
import { site } from '../site';
const year = new Date().getFullYear();
const arrow = '<svg class="ar" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg>';
const up = '<svg class="ar" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 10V2M2.5 5.5 6 2l3.5 3.5" /></svg>';
---
<div class="close" id="contact" data-reveal-footer>
  <section class="ask" aria-labelledby="contact-h">
    <div class="ask-in">
      <h2 id="contact-h">Let's connect?<span>Open to design internships.</span></h2>
      <a class="say" href={`mailto:${site.email}`} data-copy-email={site.email}>Email me <Fragment set:html={arrow} /></a>
    </div>
  </section>

  <footer class="wrap-f" data-footer-parallax>
    <div class="foot" data-footer-inner>
      <div class="cols">
        <nav class="col nav-c" aria-label="Footer">
          <p class="lab">Navigation</p>
          <a class="ln" href="/work">Work</a>
          <a class="ln" href="/about">About</a>
          <a class="ln" href="/car">Off the clock</a>
          <a class="ln top" href="#main">Back to top <Fragment set:html={up} /></a>
        </nav>
        <div class="col">
          <p class="lab">Social</p>
          <a class="ln" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn <Fragment set:html={arrow} /></a>
          <a class="ln" href={site.instagram} rel="me noopener" target="_blank">Instagram <Fragment set:html={arrow} /></a>
        </div>
        <div class="col">
          <p class="lab">Contact</p>
          <a class="ln" href={`mailto:${site.email}`} data-copy-email={site.email}>Email me <Fragment set:html={arrow} /></a>
        </div>
      </div>

      <div class="meta-row">
        <p class="lab">©{year} {site.name}</p>
        <p class="lab">Based in India · <a class="credit" href="/credits">Credits</a></p>
        <p class="lab end">{site.status}</p>
      </div>
      <p class="mark" aria-hidden="true"><span data-fit>{site.name.toLowerCase()}</span></p>
    </div>
    <div class="shade" aria-hidden="true" data-footer-shade></div>
  </footer>
</div>

<style>
  .close { position: relative; }

  /* THE ASK: on the page's own ground, set into the second column */
  .ask { padding: clamp(96px, 12vw, 180px) var(--fx-pad) clamp(32px, 3.4vw, 48px); }
  .ask-in { display: grid; justify-items: start; gap: 18px; margin-left: 25%; }
  .ask h2 { display: grid; font-family: var(--font); font-weight: 600; font-size: clamp(1.5rem, 1.05rem + 1.1vw, 2rem); letter-spacing: -.04em; line-height: 1.08; color: var(--ink); }
  .ask h2 span { color: var(--graphite); }
  /* a small, square-cornered button, as in the reference; its hit area is padded out to 44 px */
  .say { position: relative; display: inline-flex; align-items: center; gap: 6px; padding: 7px 9px; border-radius: 2px; background: var(--ink); color: var(--paper);
    font-size: 13px; font-weight: 600; letter-spacing: -.02em; line-height: 1; transition: opacity var(--duration-fast) var(--ease-smooth-out); }
  .say::before { content: ''; position: absolute; inset: -8px -4px; }
  .say:hover { opacity: .86; }
  .say:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* THE FOOTER: the page's colours turned over */
  .wrap-f { --fx-ink: var(--paper); --fx-ground: var(--ink); --fx-soft: color-mix(in srgb, var(--paper) 55%, var(--ink));
    position: relative; overflow: clip; background: var(--fx-ground); color: var(--fx-ink); }
  .foot { display: grid; grid-template-columns: minmax(0, 1fr); padding: 40px var(--fx-pad) 0; will-change: transform; }
  .shade { position: absolute; inset: 0; background: var(--paper); opacity: 0; pointer-events: none; }
  .lab { font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: -.02em; line-height: 1; text-transform: uppercase; color: var(--fx-soft); }
  .cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .col { display: grid; justify-items: start; align-content: start; gap: 4px; }
  .col .lab { margin-bottom: 30px; }
  .nav-c { grid-column: span 2; }
  .ln { position: relative; display: inline-flex; align-items: center; gap: .14em; font-family: var(--font); font-size: clamp(1.6rem, 1.1rem + 1.2vw, 2rem); font-weight: 600;
    letter-spacing: -.04em; line-height: 1.1; color: var(--fx-ink); }
  .ln.top { margin-top: 26px; }
  /* the underline draws in from the left on hover and leaves to the right */
  .ln::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: currentColor; scale: 0 1; transform-origin: 100% 50%;
    transition: scale 450ms cubic-bezier(.65, .05, .36, 1); }
  .ln:hover::after, .ln:focus-visible::after { scale: 1 1; transform-origin: 0 50%; }
  .ln:focus-visible { outline: none; }
  :global(.ar) { width: .62em; height: .62em; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: square;
    transition: translate 300ms cubic-bezier(.3, 1.5, .4, 1); }
  .ln:hover :global(.ar), .say:hover :global(.ar) { translate: 1px -1px; }
  .ln.top:hover :global(.ar) { translate: 0 -2px; }

  .meta-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin-top: clamp(72px, 9vw, 128px); padding-bottom: 20px;
    border-bottom: 1px solid color-mix(in srgb, var(--fx-ink) 14%, transparent); }
  .meta-row .lab:nth-child(2) { grid-column: 3; }
  .credit { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .credit:hover { color: var(--fx-ink); }
  .meta-row .end { grid-column: 4; justify-self: end; text-align: right; }

  /* the name across the full width: sized by the script to fit exactly (the vw size is the no-script fallback) */
  /* my name has descenders (j, p), so the line keeps room for them below and trims the empty space above */
  .mark { margin: -.04em 0 0; padding: 0 0 clamp(6px, 1vw, 16px); white-space: nowrap; font-family: var(--font-name); font-weight: 700; font-size: 15.4vw;
    letter-spacing: -.055em; line-height: 1.04; color: var(--fx-ink); }
  .mark span { display: inline-block; }

  .close { --fx-pad: clamp(16px, 2.8vw, 40px); }
  @media (max-width: 720px) {
    .ask-in { margin-left: 0; }
    .foot { padding-top: 32px; }
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 36px; }
    .col .lab { margin-bottom: 14px; }
    .ln { font-size: 1.5rem; }
    .ln.top { margin-top: 14px; }
    .meta-row { margin-top: 48px; padding-bottom: 14px; }
    .meta-row { grid-template-columns: 1fr auto; row-gap: 10px; }
    .meta-row .lab:nth-child(2) { grid-column: auto; justify-self: end; }
    .meta-row .end { grid-column: 1 / -1; justify-self: start; text-align: left; }
  }
  :global(:root[data-motion="calm"]) .ln::after, :global(:root[data-motion="calm"]) :global(.ar) { transition: none; }
</style>

<script>
  import { calm } from '../lib/motion';
  // the name fills the footer's width exactly, whatever the face or the screen
  const fit = document.querySelector<HTMLElement>('[data-fit]');
  if (fit) {
    const box = fit.parentElement!;
    const size = () => {
      const w = fit.getBoundingClientRect().width, avail = box.clientWidth;
      if (w && Math.abs(w - avail) > 0.5) fit.style.fontSize = `${(parseFloat(getComputedStyle(fit).fontSize) * avail) / w}px`;
    };
    // re-fit whenever the box or the word changes size (a resize, or the face arriving late); a fit word stays put
    new ResizeObserver(size).observe(fit);
    new ResizeObserver(size).observe(box);
  }

  // the footer slides out from under the ask: a quarter of its height higher as it enters, home when the page ends,
  // with a half-strength shade of the page colour lifting off it on the way
  const wrap = document.querySelector<HTMLElement>('[data-footer-parallax]');
  const inner = wrap?.querySelector<HTMLElement>('[data-footer-inner]');
  const shade = wrap?.querySelector<HTMLElement>('[data-footer-shade]');
  if (wrap && inner && shade && !calm()) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = wrap.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / Math.min(r.height, innerHeight)));
      inner.style.transform = `translate3d(0, ${(-25 * (1 - p)).toFixed(2)}%, 0)`;
      shade.style.opacity = (0.5 * (1 - p)).toFixed(3);
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
