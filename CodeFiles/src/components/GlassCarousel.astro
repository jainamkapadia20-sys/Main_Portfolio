---
// The projects in the liquid-glass carousel (src/fx/glass-carousel.ts). Each panel is a portrait cover drawn for the
// project in the site's colours until real covers exist. The title of the centred project sits above the row and
// its count below; a "View" label follows the pointer over a panel. Click the centred panel to focus it, then open
// the project or close. A plain list of the same links is there for screen readers and without JS.
import { sortedProjects } from '../lib/projects';
import { withBase } from '../lib/url';

const projects = await sortedProjects();
const items = projects.map((p) => ({
  title: p.data.title,
  tag: p.data.category,
  sub: p.data.placeholder ? 'Coming soon' : `${p.data.type}, ${p.data.year}`,
  href: withBase(`/work/${p.id}`),   // JSON props aren't rebased after the build, so prefix here
}));
---
<div class="glass-carousel" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Projects" data-glass-carousel={JSON.stringify(items)}>
  <div class="mount" data-mount></div>
  <p class="title" data-title aria-hidden="true">{items[0]?.title}</p>
  <p class="count meta" data-count aria-hidden="true">01/{String(items.length).padStart(2, '0')}</p>
  <div class="view" data-view aria-hidden="true">View</div>
  <div class="focus-actions" data-actions>
    <a class="btn primary open" href={items[0]?.href} data-open>Open project</a>
    <button class="btn close" type="button" data-close>Close</button>
  </div>
  <p class="sr-only" aria-live="polite" data-live></p>
  <ul class="sr-only">
    {items.map((it) => <li><a href={it.href}>{it.title}, {it.tag}</a></li>)}
  </ul>
</div>

<style>
  .glass-carousel { position: relative; height: min(92svh, 920px); min-height: 520px; overflow: hidden; outline: none; }
  .glass-carousel:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .mount { position: absolute; inset: 0; }
  .title { position: absolute; left: 50%; top: 4.5%; z-index: 10; translate: -50% 0; margin: 0; pointer-events: none; text-align: center;
    font-size: clamp(15px, 1.2vw, 18px); font-weight: 500; letter-spacing: -.02em; color: var(--ink); opacity: 0; transition: opacity 600ms ease, translate 400ms ease; }
  .count { position: absolute; left: 50%; bottom: 6%; z-index: 10; translate: -50% 0; margin: 0; pointer-events: none; opacity: 0; transition: opacity 600ms ease 180ms; }
  .ready .title, .ready .count { opacity: 1; }
  .focused .title { translate: -50% -40%; }
  .focused .count { opacity: 0; }
  .view { position: absolute; left: 0; top: 0; z-index: 20; pointer-events: none; font-size: 13px; font-weight: 500; color: #fff; mix-blend-mode: difference; }
  .focus-actions { position: absolute; left: 50%; bottom: 6%; z-index: 20; display: flex; gap: var(--s-3); translate: -50% 12px; opacity: 0; pointer-events: none;
    transition: opacity 300ms ease, translate 400ms cubic-bezier(.22, 1, .36, 1); }
  .focused .focus-actions { opacity: 1; translate: -50% 0; pointer-events: auto; }
</style>

<script>
  import { createCarousel, type LiquidGlassCarouselHandle } from '../fx/glass-carousel';
  import { onTheme, palette } from '../lib/theme';

  type Item = { title: string; tag: string; sub: string; href: string };
  const pad = (n: number) => String(n).padStart(2, '0');

  // a portrait cover for a project that has no picture yet: a field of the accent, a mark, the title
  function cover(it: Item, i: number) {
    const W = 900, H = 1200, c = document.createElement('canvas');
    c.width = W; c.height = H;
    const g = c.getContext('2d')!;
    const { paper, ink, accent } = palette();
    const bg = g.createLinearGradient(0, 0, W, H);
    bg.addColorStop(0, accent); bg.addColorStop(1, mix(accent, ink, 0.55));
    g.fillStyle = bg; g.fillRect(0, 0, W, H);
    g.fillStyle = mix(accent, paper, 0.75); g.globalAlpha = 0.9;
    g.beginPath();
    switch (i % 7) {
      case 0: g.arc(W * 0.62, H * 0.36, W * 0.26, 0, Math.PI * 2); break;
      case 1: g.roundRect(W * 0.16, H * 0.26, W * 0.68, H * 0.18, H * 0.09); break;
      case 2: g.moveTo(W * 0.16, H * 0.56); g.lineTo(W * 0.52, H * 0.14); g.lineTo(W * 0.86, H * 0.56); break;
      case 3: g.arc(W * 0.5, H * 0.56, W * 0.36, Math.PI, Math.PI * 2); break;
      case 4: g.roundRect(W * 0.2, H * 0.14, W * 0.6, H * 0.42, 40); break;
      case 5: g.arc(W * 0.5, H * 0.36, W * 0.3, Math.PI * 0.85, Math.PI * 2.15); g.lineTo(W * 0.5, H * 0.36); break;
      default: g.rect(W * 0.46, H * 0.16, W * 0.34, W * 0.34); g.arc(W * 0.4, H * 0.42, W * 0.18, 0, Math.PI * 2);
    }
    g.fill(); g.globalAlpha = 1;
    const font = getComputedStyle(document.documentElement);
    const display = font.getPropertyValue('--font-display'), mono = font.getPropertyValue('--font-mono');
    g.fillStyle = '#ffffff';
    g.font = `500 30px ${mono}`;
    g.fillText(`${pad(i + 1)} — ${it.tag.toUpperCase()}`, 60, 92);
    g.font = `800 92px ${display}`;
    const words = it.title.split(' '), lines: string[] = [];
    let line = '';
    for (const w of words) { const t = line ? `${line} ${w}` : w; if (g.measureText(t).width > W - 120 && line) { lines.push(line); line = w; } else line = t; }
    lines.push(line);
    lines.forEach((l, k) => g.fillText(l, 60, H - 150 - (lines.length - 1 - k) * 100));
    g.font = `500 30px ${mono}`; g.globalAlpha = 0.8;
    g.fillText(it.sub.toUpperCase(), 60, H - 70);
    return c.toDataURL('image/jpeg', 0.9);
  }
  // '#rrggbb' blended toward another, t = 0 → a, 1 → b
  function mix(a: string, b: string, t: number) {
    const q = (h: string) => [1, 3, 5].map((k) => parseInt(h.slice(k, k + 2), 16));
    const A = q(a), B = q(b);
    return `rgb(${A.map((v, k) => Math.round(v + (B[k] - v) * t)).join(',')})`;
  }

  document.querySelectorAll<HTMLElement>('[data-glass-carousel]').forEach((root) => {
    const items: Item[] = JSON.parse(root.dataset.glassCarousel!);
    const mount = root.querySelector<HTMLElement>('[data-mount]')!;
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const open = root.querySelector<HTMLAnchorElement>('[data-open]')!;
    let engine: LiquidGlassCarouselHandle | null = null, active = 0, started = false, entry = true;

    const build = () => {
      engine?.destroy();
      engine = createCarousel(mount, root.querySelector<HTMLElement>('[data-view]'), {
        items: items.map((it, i) => ({ title: it.title, src: cover(it, i), aspect: 3 / 4 })),
        panelHeight: 520,
        gap: 14,
        background: palette().paper,
        entry,
        onActiveChange: (i) => {
          active = i;
          title.textContent = items[i].title;
          count.textContent = `${pad(i + 1)}/${pad(items.length)}`;
          open.href = items[i].href;
          live.textContent = `${items[i].title}, ${pad(i + 1)} of ${pad(items.length)}`;
        },
        onFocusChange: (on) => { root.classList.toggle('focused', on); if (on) open.focus({ preventScroll: true }); },
        onEntryDone: (done) => root.classList.toggle('ready', done),
      });
      entry = false;   // a rebuild (theme change) skips the rise-and-grow
    };
    // start when it first comes into view, so the entrance plays where it can be seen
    new IntersectionObserver(([e], io) => { if (e.isIntersecting) { started = true; build(); io.disconnect(); } }, { threshold: 0.25 }).observe(root);
    onTheme(() => { if (started) build(); });

    root.querySelector('[data-close]')!.addEventListener('click', () => engine?.closeFocus());
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); engine?.next(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); engine?.previous(); }
      else if (e.key === 'Escape') { e.preventDefault(); engine?.closeFocus(); }
      else if (e.key === 'Enter' && e.target === root) { location.href = items[active].href; }
    });
  });
</script>
