---
// The name in Apple's display style: SF Pro Display semibold where the system has it (Apple devices), Inter
// elsewhere, lit from above (bright ink fading to grey down each letter). Once the opening room has cleared, the
// letters rise into place one after another out of a mask. The h1 around it carries the name as text; this is the
// visible setting. Reduced motion shows it still.
import { site } from '../site';
const letters = [...site.name];
---
<span class="hello" aria-hidden="true" data-hello>{letters.map((c, i) => <span class="c" style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>)}</span>

<style>
  .hello { display: block; overflow: hidden; padding-block: .06em; font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, var(--font); font-weight: 600;
    font-size: var(--name-size, clamp(2.2rem, 7.2vw, 7.5rem)); letter-spacing: -.03em; line-height: 1; white-space: nowrap; color: var(--ink); }
  /* each letter carries the same top-lit gradient, so the word reads as one sheen */
  .c { display: inline-block; color: transparent; -webkit-background-clip: text; background-clip: text;
    background-image: linear-gradient(180deg, var(--ink) 30%, color-mix(in srgb, var(--ink) 52%, var(--paper)) 100%);
    animation: rise 1100ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: calc(250ms + var(--i) * 45ms); }
  @keyframes rise { from { translate: 0 105%; } }
  /* while the opening room plays, the letters wait below the line */
  :global(html.intro) .c { animation-play-state: paused; }
  :global(:root[data-motion="calm"]) .c { animation: none; }
</style>
