---
// The name, set in the display face (Cenios, or its stand-in until the licensed file is in /fonts). Once the opening
// room has cleared, the letters rise into place one after another out of a mask. The h1 around it carries the name
// as text; this is the visible setting. Reduced motion shows it still.
import { site } from '../site';
const letters = [...site.name];
---
<span class="hello" aria-hidden="true" data-hello>{letters.map((c, i) => <span class="c" style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>)}</span>

<style>
  .hello { display: block; overflow: hidden; padding-block: .06em; font-family: var(--font-display); font-weight: var(--display-weight);
    font-size: var(--name-size, clamp(2.2rem, 7.2vw, 7.5rem)); letter-spacing: var(--name-track, -.035em); line-height: .95; white-space: nowrap; color: var(--ink); }
  .c { display: inline-block; animation: rise 1100ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: calc(250ms + var(--i) * 45ms); }
  @keyframes rise { from { translate: 0 105%; } }
  /* while the opening room plays, the letters wait below the line */
  :global(html.intro) .c { animation-play-state: paused; }
  :global(:root[data-motion="calm"]) .c { animation: none; }
</style>
