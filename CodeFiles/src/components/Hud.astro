---
// Speed readout, bottom right: scroll speed shown as km/h with a segmented bar (redline segments at the end).
// Decorative, so it is hidden from assistive tech; the section label stays readable in the page itself.
interface Props { section: string }
const { section } = Astro.props;
---
<div class="hud mono" aria-hidden="true">
  <span class="sec muted">{section}</span>
  <span class="bars">{Array.from({ length: 14 }, (_, i) => <i class={i >= 11 ? 'red' : undefined} />)}</span>
  <span class="kmh"><b data-kmh>000</b> km/h</span>
</div>
<style>
  .hud { position: fixed; right: var(--gutter); bottom: var(--gutter); z-index: var(--z-chrome); display: flex; align-items: center; gap: 14px;
    padding: 8px 12px; border: 1px solid var(--rule); background: color-mix(in srgb, var(--paper) 70%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    opacity: 0; translate: 0 6px; transition: opacity 400ms var(--ease-smooth-out), translate 400ms var(--ease-smooth-out); pointer-events: none; }
  .hud:global(.live) { opacity: 1; translate: 0 0; transition-duration: 200ms; }
  .bars { display: flex; gap: 3px; align-items: end; height: 12px; }
  .bars i { width: 4px; height: 100%; background: var(--rule-strong); transition: background-color 120ms; }
  .bars i:nth-child(-n+4) { height: 55%; } .bars i:nth-child(n+5):nth-child(-n+9) { height: 78%; }
  .bars i.on { background: var(--dusk); }
  .bars i.red.on { background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .kmh b { font-weight: 400; color: var(--ink); font-variant-numeric: tabular-nums; display: inline-block; min-width: 3ch; text-align: right; }
  @media (max-width: 720px) { .hud { bottom: 12px; right: 12px; } .sec { display: none; } }
</style>
