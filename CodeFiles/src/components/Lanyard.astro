---
// My ID card on a lanyard (React Bits' Lanyard, ported to src/fx/lanyard.ts): it hangs from the top of its box, swings,
// can be grabbed and thrown, and flips over on a click. The card and the strap are drawn here: a white card with my
// photo as a black and white sticker, a faint JK watermark and my handle; the back the JK monogram; the strap repeats JK.
// Reduced motion: it hangs still (no breeze, no drop-in). Without WebGL the box shows the card's front as a picture.
import { withBase } from '../lib/url';
import { site } from '../site';
interface Props { size?: number; strap?: number; class?: string }
const { size = 0.6, strap = 0.5, class: cls } = Astro.props;
---
<div class:list={['lanyard', cls]} data-lanyard data-face={withBase('/media/lanyard-152c3d0a.webp')   /* the name carries a hash of the picture, so a new picture is never served from an old cache */} data-size={size} data-strap={strap}
  role="img" aria-label={`${site.name}'s ID card on a lanyard: a black and white photo of him and his handle. Drag it to swing it; click to flip it.`}></div>

<style>
  .lanyard { position: relative; width: 100%; height: 100%; overflow: hidden; touch-action: pan-y; }
  /* the strap comes down out of the dark rather than starting at a hard edge */
  .lanyard.fade { -webkit-mask: linear-gradient(to bottom, transparent, #000 22%); mask: linear-gradient(to bottom, transparent, #000 22%); }
</style>

<script>
  import { mountLanyard } from '../fx/lanyard';
  import { site } from '../site';

  const W = 1024, H = 1440;   // the card's portrait face, 1.6 × 2.25
  // the JK monogram (public/monogram.svg), as paths in a 120 × 120 box, stroke 15
  const monogram = ['M60 12V76a23 23 0 0 1-46 0', 'M60 66L100 12', 'M76 45L106 108'].map((d) => new Path2D(d));
  const mark = (g: CanvasRenderingContext2D, x: number, y: number, size: number, color: string) => {
    g.save(); g.translate(x, y); g.scale(size / 120, size / 120);
    g.strokeStyle = color; g.lineWidth = 15; g.lineCap = 'butt';
    monogram.forEach((p) => g.stroke(p));
    g.restore();
  };
  const css = getComputedStyle(document.documentElement);
  const mono = css.getPropertyValue('--font-mono').trim() || 'monospace';
  const body = css.getPropertyValue('--font').trim() || 'sans-serif';
  const load = (src: string) => new Promise<HTMLImageElement | null>((done) => { const i = new Image(); i.onload = () => done(i); i.onerror = () => done(null); i.src = src; });
  const canvas = (w: number, h: number) => { const c = document.createElement('canvas'); c.width = w; c.height = h; return [c, c.getContext('2d')!] as const; };

  const handle = `@${site.instagram.replace(/\/+$/, '').split('/').pop()}`;
  const paper = (g: CanvasRenderingContext2D) => {
    const bg = g.createLinearGradient(0, 0, 0, H); bg.addColorStop(0, '#F8F8F6'); bg.addColorStop(1, '#ECECE9');
    g.fillStyle = bg; g.fillRect(0, 0, W, H);
  };

  // FRONT: a white card; the JK monogram as a faint watermark top left, my handle top right, and the photo as a black and
  // white sticker (white die-cut border) standing up from the bottom edge, its shoulders running off the card
  function front(face: HTMLImageElement | null) {
    const [c, g] = canvas(W, H);
    paper(g);
    mark(g, 70, 70, 190, 'rgba(20,20,22,.07)');
    g.font = `500 44px ${body}`; g.fillStyle = '#2B2B2E'; g.textAlign = 'right'; g.textBaseline = 'alphabetic';
    g.fillText(handle, W - 70, 168);
    if (face) {
      const w = 1080, h = (face.height / face.width) * w;   // a little wider than the card: the shoulders run off its sides
      g.drawImage(face, (W - w) / 2, H - h + 24, w, h);
    }
    return c.toDataURL('image/png');
  }
  // BACK: the same white card with the monogram large, and how to reach me
  function back() {
    const [c, g] = canvas(W, H);
    paper(g);
    mark(g, W / 2 - 200, 420, 400, '#141416');
    g.textAlign = 'center'; g.fillStyle = 'rgba(20,20,22,.55)'; g.font = `500 28px ${mono}`;
    g.fillText(handle.toUpperCase(), W / 2, 1110);
    g.fillText(site.email.toUpperCase(), W / 2, 1160);
    return c.toDataURL('image/png');
  }
  // STRAP: black webbing with the JK monogram alone, spaced out. One tile runs along the strap (the lanyard turns it a
  // quarter turn), so the mark is drawn a quarter turn back to stand upright on the hanging strap.
  function strap() {
    const along = 520, across = 192;
    const [c, g] = canvas(along, across);
    g.fillStyle = '#111113'; g.fillRect(0, 0, along, across);
    g.save(); g.translate(along / 2, across / 2); g.rotate(-Math.PI / 2);
    mark(g, -46, -46, 92, '#F2F2F0');
    g.restore();
    return c.toDataURL('image/png');
  }

  document.querySelectorAll<HTMLElement>('[data-lanyard]').forEach(async (box) => {
    await Promise.all([`500 44px ${body}`, `500 28px ${mono}`].map((f) => document.fonts.load(f).catch(() => {})));
    const face = await load(box.dataset.face!);
    const frontImage = front(face);
    mountLanyard(box, {
      frontImage, backImage: back(), strapImage: strap(),
      cardColor: '#F2F2F0', finish: 'glossy', metal: 'silver', strapColor: '#111113',
      size: Number(box.dataset.size), strapLength: Number(box.dataset.strap), cornerRadius: 0.3,
    });
    // without WebGL, nothing mounts: show the card's front as a picture instead
    if (!box.querySelector('canvas')) box.style.background = `center / contain no-repeat url(${frontImage})`;
  });
</script>
