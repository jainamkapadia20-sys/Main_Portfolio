---
// The JK monogram in liquid metal (src/fx/metal.ts). With `reform`, clicking it dissolves it out and back in.
interface Props { reform?: boolean; label?: string }
const { reform = false, label = 'Replay the monogram' } = Astro.props;
---
<div class="metal">
  <canvas data-metal={reform ? 'reform' : ''} aria-hidden="true"></canvas>
  {reform && <button class="sr-only" type="button" data-metal-again>{label}</button>}
</div>

<style>
  .metal { position: relative; width: 100%; height: 100%; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  canvas[data-metal="reform"] { cursor: pointer; }
</style>

<script>
  import { mountMetal } from '../fx/metal';
  document.querySelectorAll<HTMLCanvasElement>('[data-metal]').forEach((c) => {
    mountMetal(c, { reform: c.dataset.metal === 'reform' });
    c.parentElement!.querySelector('[data-metal-again]')?.addEventListener('click', () => c.click());
  });
</script>
