---
// Why I do this: "I design to" holds still while the reasons roll past it on a reel, one at a time. The section pins
// for a while; each stretch of scroll belongs to one reason, which holds, then the reel clicks on to the next with a
// short, eased glide (a slot-machine detent, not a free scroll). The reason on the line is in full ink, its neighbours
// fade away above and below. A counter ticks 01 → 06. Calm motion: no pin, the reasons read as a plain list.
const reasons = [
  'make the complex feel simple.',
  'make people feel at home.',
  'make every drive a little safer.',
  'turn a sketch into something real.',
  'make someone smile.',
  'keep learning, every project.',
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="why" aria-labelledby="why-h" data-why style={`--n:${reasons.length}`}>
  <div class="stage">
    <div class="line">
      <h2 id="why-h" class="lead-in">I design to</h2>
      <div class="reel" aria-hidden="false">
        <ul data-why-list>{reasons.map((r) => <li>{r}</li>)}</ul>
      </div>
    </div>
    <p class="count meta" aria-hidden="true"><span class="digits" data-why-count>01</span> / {pad(reasons.length)}</p>
    <span class="ticks" aria-hidden="true">{reasons.map(() => <i></i>)}</span>
  </div>
</section>

<style>
  .why { position: relative; height: calc(var(--n) * 62svh + 100svh); }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; display: grid; align-content: center; padding-inline: var(--inset);
    font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(1.7rem, .6rem + 2.5vw, 4.2rem); letter-spacing: -.03em; line-height: 1.12; }
  .line { display: grid; grid-template-columns: auto 1fr; gap: 0 .35em; align-items: center; max-width: 1400px; width: 100%; margin-inline: auto; }
  .lead-in { font: inherit; letter-spacing: inherit; margin: 0; white-space: nowrap; }
  /* the reel: a window three lines tall, faded at the top and bottom; the list slides inside it */
  .reel { position: relative; height: 3.6em; overflow: hidden;
    -webkit-mask: linear-gradient(transparent, #000 32%, #000 68%, transparent); mask: linear-gradient(transparent, #000 32%, #000 68%, transparent); }
  .reel ul { position: absolute; left: 0; right: 0; top: 50%; will-change: transform; transform: translate3d(0, var(--y, 0px), 0); }
  /* one line each on wide screens, so every reason lands level with "I design to" */
  .reel li { min-height: 1.2em; display: flex; align-items: center; white-space: nowrap; opacity: var(--lit, .14);
    color: color-mix(in srgb, var(--accent) calc(var(--lit, 0) * 100%), var(--ink)); }
  .count { position: absolute; left: var(--inset); bottom: clamp(28px, 6svh, 56px); font-family: var(--font-mono); }
  .digits { color: var(--ink); }
  .ticks { position: absolute; right: var(--inset); bottom: clamp(32px, 6svh, 60px); display: flex; gap: 6px; }
  .ticks i { width: 22px; height: 3px; border-radius: 3px; background: color-mix(in srgb, var(--ink) 18%, transparent); transition: background-color 300ms var(--ease-smooth-out); }
  .ticks i.on { background: var(--accent); }
  @media (max-width: 720px) {
    .line { grid-template-columns: 1fr; gap: .2em; }
    .reel { height: 4.2em; }
    .reel li { white-space: normal; }
  }
  /* calm: no pin, no reel; the reasons read as a list under the lead-in */
  :global(:root[data-motion="calm"]) .why { height: auto; }
  :global(:root[data-motion="calm"]) .stage { position: relative; height: auto; padding-block: 16svh; }
  :global(:root[data-motion="calm"]) .line { align-items: start; }
  :global(:root[data-motion="calm"]) .reel { height: auto; overflow: visible; -webkit-mask: none; mask: none; }
  :global(:root[data-motion="calm"]) .reel ul { position: static; transform: none; }
  :global(:root[data-motion="calm"]) .reel li { --lit: 1; color: var(--ink); }
  :global(:root[data-motion="calm"]) .count, :global(:root[data-motion="calm"]) .ticks { display: none; }
</style>

<script>
  import { calm } from '../lib/motion';
  document.querySelectorAll<HTMLElement>('[data-why]').forEach((sec) => {
    if (calm()) return;
    const list = sec.querySelector<HTMLElement>('[data-why-list]')!;
    const items = [...list.children] as HTMLElement[];
    const count = sec.querySelector<HTMLElement>('[data-why-count]')!;
    const ticks = [...sec.querySelectorAll<HTMLElement>('.ticks i')];
    const n = items.length;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    // the detent: each step holds for most of its stretch, then glides to the next in the last 40% of it
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const detent = (t: number) => { const i = Math.floor(t), f = t - i; return i + ease(clamp((f - 0.55) / 0.4)); };
    let centres: number[] = [];
    const measure = () => { centres = items.map((li) => li.offsetTop + li.offsetHeight / 2); };
    let target = 0, shown = 0, raf = 0, last = -1;
    const paint = () => {
      // where the reel sits: between two items' centres, so lines that wrap still land dead centre
      const i = Math.min(n - 1, Math.floor(shown)), f = shown - i, j = Math.min(n - 1, i + 1);
      const y = centres[i] + (centres[j] - centres[i]) * f;
      list.style.setProperty('--y', `${(-y).toFixed(2)}px`);
      items.forEach((li, k) => li.style.setProperty('--lit', Math.max(0.14, 1 - Math.abs(k - shown) * 0.86).toFixed(3)));
      const now = Math.round(shown);
      if (now !== last) { last = now; count.textContent = String(now + 1).padStart(2, '0'); ticks.forEach((t, k) => t.classList.toggle('on', k <= now)); }
    };
    const glide = () => {
      // the shown position eases toward the target every frame, so a fast wheel or a jumpy trackpad never jerks it
      shown += (target - shown) * 0.16;
      if (Math.abs(target - shown) < 0.001) shown = target;
      paint();
      raf = shown === target ? 0 : requestAnimationFrame(glide);
    };
    const update = () => {
      const r = sec.getBoundingClientRect();
      const p = clamp(-r.top / Math.max(1, r.height - innerHeight));
      target = detent(p * (n - 1));
      if (!raf) raf = requestAnimationFrame(glide);
    };
    measure();
    addEventListener('resize', () => { measure(); update(); });
    document.fonts.ready.then(() => { measure(); update(); });
    addEventListener('scroll', update, { passive: true });
    update();
  });
</script>
