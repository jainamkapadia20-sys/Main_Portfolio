---
// The projects' title card (after React Bits' Neon Reveal, built from scratch in CSS so it costs nothing to run):
// a neon tube along the top flickers on as it scrolls into view, runs out from the middle, and pours its light
// down over the heading, which stands in it as a dark cut-out. The light fades out before the stage ends, so the
// carousel underneath sits on plain ground. Colours come from the era (--neon-* in global.css).
interface Props { title: string; id: string }
const { title, id } = Astro.props;
---
<div class="neon" data-neon>
  <span class="tube" aria-hidden="true"></span>
  <span class="spill" aria-hidden="true"></span>
  <h2 class="title" id={id}>{title}</h2>
</div>

<style>
  .neon { position: relative; isolation: isolate; display: grid; place-items: center; height: clamp(300px, 52svh, 560px); }
  .tube { position: absolute; top: 24px; left: 6%; right: 6%; height: 3px; border-radius: 3px; background: var(--neon-tube);
    box-shadow: 0 0 4px 1px var(--neon-tube), 0 0 16px 3px var(--neon-light), 0 0 44px 10px color-mix(in srgb, var(--neon-light) 55%, transparent); }
  /* the light it pours: brightest under the tube, through the light colour into a deep shade, then nothing */
  .spill { position: absolute; inset: 24px 0 0; z-index: -1; transform-origin: 50% 0;
    background: radial-gradient(70% 100% at 50% 0%, color-mix(in srgb, var(--neon-tube) 70%, var(--neon-light)) 0%, var(--neon-light) 28%,
      var(--neon-deep) 58%, transparent 88%);
    /* feathered at the sides, so the light has no box edge */
    -webkit-mask: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent); mask: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent); }
  .title { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(2.75rem, 1rem + 7vw, 8rem); letter-spacing: -.035em;
    line-height: 1; color: var(--neon-title); translate: 0 10%; }

  /* switched off until it scrolls into view (only when JS can switch it on) */
  :global(.js) .neon:not(.lit) .tube { opacity: 0; transform: scaleX(0); }
  :global(.js) .neon:not(.lit) .spill { opacity: 0; transform: scale(.4, 0); }
  :global(.js) .neon:not(.lit) .title { opacity: 0; }
  /* on: the tube stutters, runs out from the middle, then the light pours down and the heading appears in it */
  .lit .tube { animation: tube-run 1400ms cubic-bezier(.19, 1, .22, 1) both, flicker 900ms steps(1) both, hum 4s ease-in-out 2.4s infinite; }
  .lit .spill { animation: pour 2500ms cubic-bezier(.19, 1, .22, 1) 250ms both; }
  .lit .title { animation: show 900ms ease-out 700ms both; }
  @keyframes tube-run { from { transform: scaleX(.04); } }
  @keyframes flicker { 0% { opacity: 0; } 8% { opacity: 1; } 14% { opacity: .15; } 22% { opacity: 1; } 30% { opacity: .35; } 38%, 100% { opacity: 1; } }
  @keyframes hum { 50% { opacity: .9; } }
  @keyframes pour { from { opacity: 0; transform: scale(.4, 0); } 30% { opacity: 1; } }
  @keyframes show { from { opacity: 0; } }
  :global(:root[data-motion="calm"]) .lit :is(.tube, .spill, .title) { animation: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-neon]').forEach((el) =>
    new IntersectionObserver(([e], io) => { if (e.isIntersecting) { el.classList.add('lit'); io.disconnect(); } }, { threshold: 0.35 }).observe(el));
</script>
