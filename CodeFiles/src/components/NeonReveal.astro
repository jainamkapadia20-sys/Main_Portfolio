---
// The projects' title card (after React Bits' Neon Reveal, built from scratch in CSS so it costs nothing to run):
// a neon tube along the top flickers on when the line from the hero reaches it, runs out from that point, and pours its light down
// over the heading, which lights up in it. Scroll back up past it and it all plays in reverse: the light draws back
// up, the tube shrinks into its middle and goes out. The light fades before the stage ends, so the carousel
// underneath sits on plain ground. Colours come from the era (--neon-* in global.css).
interface Props { title: string; id: string }
const { title, id } = Astro.props;
---
<div class="neon" data-neon>
  <span class="tube" aria-hidden="true"></span>
  <span class="spill" aria-hidden="true"></span>
  <h2 class="title" id={id}>{title}</h2>
</div>

<style>
  .neon { position: relative; isolation: isolate; display: grid; place-items: center; height: clamp(300px, 46svh, 500px); }
  .tube { position: absolute; top: 24px; left: 6%; right: 6%; height: 3px; border-radius: 3px; background: var(--neon-tube); transform-origin: var(--ox, 50%) 50%;
    box-shadow: 0 0 4px 1px var(--neon-tube), 0 0 16px 3px var(--neon-light), 0 0 44px 10px color-mix(in srgb, var(--neon-light) 55%, transparent); }
  /* the light it pours: brightest under the tube, through the light colour into a deep shade, then nothing */
  .spill { position: absolute; inset: 24px 0 0; z-index: -1; transform-origin: var(--ox, 50%) 0;
    background: radial-gradient(70% 100% at 50% 0%, color-mix(in srgb, var(--neon-tube) 55%, var(--neon-light)) 0%, var(--neon-light) 26%,
      var(--neon-deep) 56%, transparent 86%);
    /* feathered at the sides, so the light has no box edge */
    -webkit-mask: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent); mask: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent); }
  /* the heading glows in the tube's light */
  .title { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(2.75rem, 1rem + 7vw, 8rem); letter-spacing: -.035em;
    line-height: 1; color: var(--neon-title); translate: 0 10%;
    text-shadow: 0 0 18px color-mix(in srgb, var(--neon-light) 75%, transparent), 0 0 56px color-mix(in srgb, var(--neon-light) 45%, transparent); }

  /* Off (only when JS can switch it on). Leaving runs the other way round: the heading dims, the light draws back
     up, then the tube shrinks into its middle and goes out. A transition plays with the timing of the state it is
     heading to, so these are the switching-off timings and .lit below holds the switching-on ones. */
  :global(.js) .neon .tube { transition: transform 700ms cubic-bezier(.7, 0, .84, 0) 350ms, opacity 300ms ease-in 900ms; }
  :global(.js) .neon .spill { transition: transform 650ms cubic-bezier(.7, 0, .84, 0) 150ms, opacity 500ms ease-in 250ms; }
  :global(.js) .neon .title { transition: opacity 350ms ease-in, translate 350ms ease-in; }
  :global(.js) .neon:not(.lit) .tube { opacity: 0; transform: scaleX(0); }
  :global(.js) .neon:not(.lit) .spill { opacity: 0; transform: scale(.4, 0); }
  :global(.js) .neon:not(.lit) .title { opacity: 0; translate: 0 calc(10% + 16px); }
  /* on: the tube stutters, runs out from the middle, then the light pours down and the heading lights up in it */
  :global(.js) .neon.lit .tube { transition: transform 1400ms cubic-bezier(.19, 1, .22, 1), opacity 1ms;
    animation: flicker 900ms steps(1) both, hum 4s ease-in-out 2.4s infinite; }
  :global(.js) .neon.lit .spill { transition: transform 2500ms cubic-bezier(.19, 1, .22, 1) 250ms, opacity 900ms ease-out 250ms; }
  :global(.js) .neon.lit .title { transition: opacity 900ms ease-out 700ms, translate 1200ms cubic-bezier(.19, 1, .22, 1) 700ms; }
  @keyframes flicker { 0% { opacity: 0; } 8% { opacity: 1; } 14% { opacity: .15; } 22% { opacity: 1; } 30% { opacity: .35; } 38%, 100% { opacity: 1; } }
  @keyframes hum { 50% { opacity: .9; } }
  :global(:root[data-motion="calm"]) .neon :is(.tube, .spill, .title) { transition: none; animation: none; }
</style>

<script>
  import { calm } from '../lib/motion';
  // On the home page the line from "See my work" switches it on (index.astro). Anywhere else, or with reduced motion,
  // it lights up as it scrolls in and goes out once it has scrolled away.
  if (calm() || !document.querySelector('[data-wire]'))
    document.querySelectorAll<HTMLElement>('[data-neon]').forEach((el) =>
      new IntersectionObserver(([e]) => el.classList.toggle('lit', e.isIntersecting), { threshold: 0.3 }).observe(el));
</script>
