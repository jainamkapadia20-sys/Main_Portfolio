---
// Button or link with a status dot, like a cluster warning light (ref: 02-lusion).
interface Props { href?: string; label: string; tone?: 'accent' | 'neutral'; attrs?: Record<string, string> }
const { href, label, tone = 'neutral', attrs = {} } = Astro.props;
---
{href
  ? <a class:list={['pill', 'mono', tone]} href={href} {...attrs}><span class="dot" aria-hidden="true"></span>{label}</a>
  : <button class:list={['pill', 'mono', tone]} type="button" {...attrs}><span class="dot" aria-hidden="true"></span>{label}</button>}
<style>
  .pill { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 18px; border: 1px solid var(--rule-strong); color: var(--ink); }
  .pill:hover { border-color: var(--ink); }
  .dot { width: 7px; height: 7px; background: var(--graphite); }
  .accent .dot { background: var(--accent); }
</style>
