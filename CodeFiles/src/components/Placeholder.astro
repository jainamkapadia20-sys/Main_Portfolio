---
// Stand-in image for work not yet supplied: a flat tonal panel that says what goes there. It reserves the final
// aspect ratio, so nothing shifts when the real image replaces it.
interface Props { ratio?: string; label?: string; size?: string; name?: string; decorative?: boolean }
const { ratio = '4 / 3', label = 'Image', size, name, decorative = false } = Astro.props;
---
<div class="ph" style={`aspect-ratio:${ratio};${name ? `view-transition-name:${name}` : ''}`} role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : `Placeholder image: ${label}`} aria-hidden={decorative ? 'true' : undefined}>
  <span>Placeholder<br /><span class="muted">{label}{size && `, ${size}`}</span></span>
</div>
<style>
  .ph { position: relative; width: 100%; display: grid; place-items: center; text-align: center; background: var(--surface-2); color: var(--ink); font-size: var(--t-small); font-weight: 500; line-height: 1.4; }
</style>
