---
// The way into the projects: the section pins, "My projects" rises in letter by letter out of a mask, holds, then
// opens up (it grows, its letters spread and it blurs away) while the carousel rises over it from below. The page
// pulls the carousel up over the last stretch of this pin (index.astro, .featured), and the words leave as its middle
// climbs the screen, so they always overlap. Progress is eased every frame so the words never jump with the wheel.
// Calm motion: no pin; the heading simply sits above the carousel.
interface Props { id: string; next: string; label?: string }   // next: the id of the section that rides up over the words
const { id, next, label = 'Selected work' } = Astro.props;
const word = 'My projects';
---
<section class="pr" data-pr data-next={next} aria-labelledby={id}>
  <div class="stage">
    <p class="kick meta" data-pr-kick>{label}</p>
    <h2 id={id} class="word" data-pr-word>
      <span class="sr-only">{word}</span>
      <span class="letters" aria-hidden="true">{[...word].map((c, i) => <span class="m"><span class="c" style={`--k:${i}`}>{c === ' ' ? ' ' : c}</span></span>)}</span>
    </h2>
    <span class="rule" aria-hidden="true" data-pr-rule></span>
  </div>
</section>

<style>
  .pr { position: relative; height: 170svh; }
  .stage { position: sticky; top: 0; height: 100svh; display: grid; place-content: center; justify-items: center; gap: var(--s-5); overflow: hidden; padding-inline: var(--edge); }
  .kick { opacity: calc(var(--ki, 0) * (1 - var(--o, 0))); translate: 0 calc((1 - var(--ki, 0)) * 12px); }
  .word { margin: 0; font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(3rem, 13vw, 14rem); letter-spacing: -.045em; line-height: .92;
    white-space: nowrap; color: var(--ink); will-change: transform, filter, opacity;
    opacity: calc(1 - var(--o, 0)); transform: scale(calc(1 + var(--o, 0) * .35)); filter: blur(calc(var(--o, 0) * 14px)); }
  .letters { display: inline-flex; letter-spacing: calc(-.045em + var(--o, 0) * .12em); }
  .m { display: inline-block; overflow: hidden; padding-block: .06em; margin-block: -.06em; }
  .c { display: inline-block; white-space: pre; transform: translate3d(0, calc((1 - var(--r, 1)) * 110%), 0) rotate(calc((1 - var(--r, 1)) * 8deg)); transform-origin: 0 100%; }
  .rule { width: min(240px, 40vw); height: 1px; background: color-mix(in srgb, var(--ink) 40%, transparent); transform: scaleX(var(--ki, 0)); opacity: calc(1 - var(--o, 0)); }
  :global(:root[data-motion="calm"]) .pr { height: auto; }
  :global(:root[data-motion="calm"]) .stage { position: relative; height: auto; padding-block: 18svh 6svh; }
  :global(:root[data-motion="calm"]) .kick { --ki: 1; }
</style>

<script>
  import { calm } from '../lib/motion';
  document.querySelectorAll<HTMLElement>('[data-pr]').forEach((sec) => {
    if (calm()) return;
    const word = sec.querySelector<HTMLElement>('[data-pr-word]')!;
    const letters = [...sec.querySelectorAll<HTMLElement>('.c')];
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const outQuart = (t: number) => 1 - Math.pow(1 - t, 4);
    const inOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const next = document.getElementById(sec.dataset.next!);   // the carousel that rides up over the words
    let target = 0, shown = 0, outTarget = 0, out = 0, raf = 0;
    const paint = () => {
      // in: the letters rise one after another over the first stretch of the pin
      letters.forEach((c, k) => c.style.setProperty('--r', outQuart(clamp((shown - k * 0.022) / 0.2)).toFixed(4)));
      sec.style.setProperty('--ki', outQuart(clamp((shown - 0.12) / 0.22)).toFixed(4));
      // out: the words open up and blur away as the carousel's middle climbs from the bottom of the screen to the
      // middle, so the words and the cards always overlap and the screen is never empty in between
      sec.style.setProperty('--o', inOut(out).toFixed(4));
    };
    const glide = () => {
      shown += (target - shown) * 0.14;
      out += (outTarget - out) * 0.14;
      if (Math.abs(target - shown) < 0.0005) shown = target;
      if (Math.abs(outTarget - out) < 0.0005) out = outTarget;
      paint();
      raf = shown === target && out === outTarget ? 0 : requestAnimationFrame(glide);
    };
    const update = () => {
      const r = sec.getBoundingClientRect();
      // 0 when the section's top reaches the bottom third of the screen, 1 as the pin lets go
      target = clamp((innerHeight * 0.66 - r.top) / (r.height - innerHeight + innerHeight * 0.66));
      if (next) {
        const n = next.getBoundingClientRect(), mid = n.top + n.height / 2;
        outTarget = clamp((innerHeight * 1.05 - mid) / (innerHeight * 0.5));
      } else outTarget = clamp((target - 0.5) / 0.42);
      if (!raf) raf = requestAnimationFrame(glide);
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
    shown = target; out = outTarget; paint();
  });
</script>
