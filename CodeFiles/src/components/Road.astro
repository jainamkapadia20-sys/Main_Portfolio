---
// A full-screen night road (src/fx/road.ts) with the slot's copy laid over it. Press and hold to speed up.
---
<div class="road" data-own-pointer>
  <canvas data-road aria-hidden="true"></canvas>
  <div class="over"><slot /></div>
</div>

<style>
  .road { position: relative; height: 100svh; min-height: 560px; overflow: hidden; background: var(--paper); user-select: none; -webkit-user-select: none; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; cursor: pointer; touch-action: pan-y; }
  .over { position: absolute; inset: auto 0 0; padding: 0 var(--inset) clamp(40px, 7vw, 96px); pointer-events: none;
    background: linear-gradient(to top, var(--paper) 10%, transparent); }
  .over :global(a) { pointer-events: auto; }
</style>

<script>
  import { mountRoad } from '../fx/road';
  document.querySelectorAll<HTMLCanvasElement>('[data-road]').forEach(mountRoad);
</script>
