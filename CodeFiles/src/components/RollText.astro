---
// Per-letter roll on hover (ref: 02-lusion). Letters are aria-hidden and the real text stays in the DOM for
// assistive tech. The roll itself arrives in the motion pass; here the letters are static.
interface Props { text: string }
const { text } = Astro.props;
---
<span class="roll"><span class="letters" aria-hidden="true">{[...text].map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</span><span class="sr-only">{text}</span></span>
<style>
  .roll { display: inline-flex; overflow: hidden; vertical-align: bottom; }
  .letters span { display: inline-block; white-space: pre; }
</style>
