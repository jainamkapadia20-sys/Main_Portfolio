---
// Side work (after the Dynamic Frame Layout): one big rectangle cut into a 3 × 3 of frames, "Side work" in the
// middle and a category in each frame around it. Point at a frame and its row and column swell while the rest give
// way, and the frame fills with a preview; click it and the category opens, laid out as a small gallery. Pieces
// without a picture yet are labelled placeholders.
interface Piece { title: string; note?: string; src?: string; alt?: string }
interface Category { name: string; pieces: Piece[] }
interface Props { categories: Category[] }
const { categories } = Astro.props;
// eight categories round the middle; the middle (index 4) is the heading
const cells = [...categories.slice(0, 4), null, ...categories.slice(4, 8)];
---
<section class="side section" aria-labelledby="side-h">
  <div class="frames" data-frames>
    {cells.map((c, i) => c === null ? (
      <div class="cell centre" data-cell={i}>
        <p class="label">Things I make</p>
        <h2 id="side-h">Side work</h2>
      </div>
    ) : (
      <button type="button" class="cell" data-cell={i} data-open={i} aria-haspopup="dialog">
        <span class="preview" aria-hidden="true">
          {c.pieces[0]?.src ? <img src={c.pieces[0].src} alt="" loading="lazy" /> : <span class="ph"><span class="meta">{String(c.pieces.length).padStart(2, '0')} pieces</span></span>}
        </span>
        <span class="name">{c.name}</span>
        <span class="count meta">{String(c.pieces.length).padStart(2, '0')}</span>
      </button>
    ))}
  </div>

  {cells.map((c, i) => c && (
    <dialog class="sheet" data-sheet={i} aria-labelledby={`side-${i}`}>
      <div class="sheet-head">
        <p class="label">Side work</p>
        <h3 id={`side-${i}`}>{c.name}</h3>
        <button type="button" class="btn close" data-close>Close</button>
      </div>
      <ul class="pieces">
        {c.pieces.map((p) => (
          <li>
            <figure>
              {p.src ? <img src={p.src} alt={p.alt ?? ''} loading="lazy" /> : <span class="ph" role="img" aria-label={`Placeholder: ${p.title}`}><span class="meta">Placeholder</span></span>}
              <figcaption><span>{p.title}</span>{p.note && <span class="meta">{p.note}</span>}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </dialog>
  ))}
</section>

<style>
  .side { padding-inline: var(--edge); }
  /* the rectangle: three columns and three rows whose sizes ease when a frame is pointed at */
  .frames { --c0: 1fr; --c1: 1fr; --c2: 1fr; --r0: 1fr; --r1: 1fr; --r2: 1fr;
    display: grid; grid-template-columns: var(--c0) var(--c1) var(--c2); grid-template-rows: var(--r0) var(--r1) var(--r2); gap: 6px;
    height: min(92svh, 860px); min-height: 560px; padding: 6px; border-radius: calc(var(--radius) + 6px); background: var(--surface);
    transition: grid-template-columns 600ms cubic-bezier(.22, 1, .36, 1), grid-template-rows 600ms cubic-bezier(.22, 1, .36, 1); }
  .cell { position: relative; min-width: 0; min-height: 0; overflow: hidden; border-radius: var(--radius); background: var(--paper);
    display: grid; place-items: center; text-align: center; color: var(--ink); container-type: size; }
  .centre { align-content: center; gap: var(--s-3); background: transparent; }
  .centre h2 { font-size: clamp(2rem, 9cqi, 5.5rem); }
  button.cell { cursor: pointer; }
  .name { position: relative; z-index: 1; font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: -.02em; line-height: 1;
    font-size: clamp(1rem, 7.5cqi, 3.25rem); padding-inline: 8%; transition: color 300ms ease, opacity 300ms ease; }
  .count { position: absolute; z-index: 1; top: 14px; right: 16px; }
  .preview { position: absolute; inset: 0; opacity: 0; scale: 1.06; transition: opacity 450ms ease, scale 700ms cubic-bezier(.22, 1, .36, 1); }
  .preview img { width: 100%; height: 100%; object-fit: cover; }
  .ph { display: grid; place-items: end start; width: 100%; height: 100%; padding: 16px;
    background: radial-gradient(120% 90% at 20% 10%, color-mix(in srgb, var(--accent) 55%, var(--paper)), color-mix(in srgb, var(--accent) 22%, var(--ink)) 90%); }
  .ph .meta { color: hsl(0 0% 100% / .8); }
  /* the frame you point at fills with its preview; its name sits over it */
  .cell.hot .preview { opacity: 1; scale: 1; }
  .cell.hot .name { color: #fff; }
  .cell.hot .count { color: hsl(0 0% 100% / .8); }
  .cell:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }

  /* a category, opened */
  .sheet { width: min(1200px, 94vw); max-height: 90vh; padding: 0; border: 0; border-radius: calc(var(--radius) + 6px); background: var(--paper); color: var(--ink);
    box-shadow: 0 40px 120px -30px hsl(0 0% 0% / .45); }
  .sheet::backdrop { background: hsl(0 0% 0% / .5); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .sheet[open] { animation: sheet-in 500ms cubic-bezier(.22, 1, .36, 1); }
  @keyframes sheet-in { from { opacity: 0; translate: 0 24px; scale: .98; } }
  .sheet-head { position: sticky; top: 0; z-index: 1; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 8px 16px;
    padding: var(--s-6) var(--s-6) var(--s-5); background: var(--paper); }
  .sheet-head .label { grid-column: 1; }
  .sheet-head h3 { grid-column: 1; font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(2rem, 1rem + 3vw, 3.5rem); }
  .sheet-head .close { grid-column: 2; grid-row: 1 / 3; align-self: center; }
  .pieces { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--s-4); padding: 0 var(--s-6) var(--s-6); }
  .pieces figure { margin: 0; display: grid; gap: var(--s-2); }
  .pieces img, .pieces .ph { aspect-ratio: 4 / 3; width: 100%; border-radius: var(--radius); object-fit: cover; }
  .pieces figcaption { display: flex; justify-content: space-between; gap: 12px; font-weight: 500; }

  @media (max-width: 720px) {
    .frames { grid-template-columns: 1fr 1fr; grid-template-rows: none; grid-auto-rows: 150px; height: auto; min-height: 0; }
    .centre { grid-column: 1 / -1; order: -1; }
    .cell.hot .preview { opacity: 0; }
  }
  :global(:root[data-motion="calm"]) .frames, :global(:root[data-motion="calm"]) .preview { transition: none; }
</style>

<script>
  // Point at a frame: its row and column swell to twice the others. Click: open the category.
  document.querySelectorAll<HTMLElement>('[data-frames]').forEach((grid) => {
    const cells = [...grid.querySelectorAll<HTMLElement>('[data-cell]')];
    const wide = matchMedia('(min-width: 721px)');
    const focus = (i: number | null) => {
      cells.forEach((c) => c.classList.toggle('hot', i !== null && Number(c.dataset.cell) === i && c.matches('button')));
      for (let k = 0; k < 3; k++) {
        grid.style.setProperty(`--c${k}`, i !== null && wide.matches && i % 3 === k ? '2fr' : '1fr');
        grid.style.setProperty(`--r${k}`, i !== null && wide.matches && Math.floor(i / 3) === k ? '2fr' : '1fr');
      }
    };
    cells.forEach((c) => {
      const i = Number(c.dataset.cell);
      c.addEventListener('pointerenter', () => focus(i));
      c.addEventListener('focus', () => focus(i));
    });
    grid.addEventListener('pointerleave', () => focus(null));
    grid.addEventListener('focusout', (e) => { if (!grid.contains(e.relatedTarget as Node)) focus(null); });
  });
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => {
    const sheet = document.querySelector<HTMLDialogElement>(`[data-sheet="${b.dataset.open}"]`);
    b.addEventListener('click', () => sheet?.showModal());
  });
  document.querySelectorAll<HTMLDialogElement>('[data-sheet]').forEach((d) => {
    d.querySelector('[data-close]')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });   // a click on the backdrop closes it
  });
</script>
