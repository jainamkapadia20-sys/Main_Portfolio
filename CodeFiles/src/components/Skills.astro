---
// What I do: one large word, and beside it filled bars that open in place (transitions.dev accordion).
interface Props { heading?: string; intro?: string }
const { heading = 'Skills', intro = 'Five disciplines, one way of working: start with people, sketch early, make it clear.' } = Astro.props;
const skills = [
  { name: 'UI/UX design', does: 'Flows, wireframes, interfaces and prototypes for apps and the web.', tools: 'Figma, prototyping, usability testing' },
  { name: 'HMI design', does: 'Screens, alerts and controls inside cars, designed from the sensor up.', tools: 'Figma, scenario mapping, tabletop prototyping' },
  { name: 'Graphic design', does: 'Identities, posters, layout and typography.', tools: 'Illustrator, Figma' },
  { name: 'Service design', does: 'Journeys, blueprints and the systems behind a service.', tools: 'Miro, interviews, journey maps' },
  { name: 'Research', does: 'Interviews, observation and usability tests that turn into a clear brief.', tools: 'Miro, affinity mapping' },
  { name: 'Sketching and 3D', does: 'Concept drawings, storyboards, and models built from scratch.', tools: 'Pencil and paper, Blender' },
];
---
<div class="skills">
  <div class="lhs">
    <h2 class="word" id="skills-h">{heading}</h2>
    <p class="muted">{intro}</p>
  </div>
  <div class="bars">
    {skills.map((s, i) => (
      <div class="t-acc" data-open={i === 0 ? 'true' : 'false'} data-reveal style={`--i:${i}`}>
        <button class="t-acc-head" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`sk-${i}`}>
          {s.name}
          <span class="t-acc-chevron" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 6.5L8 10.5L12 6.5" /></svg></span>
        </button>
        <div class="t-acc-panel" id={`sk-${i}`}><div class="t-acc-panel-inner"><p>{s.does}</p><p class="muted">{s.tools}</p></div></div>
      </div>
    ))}
  </div>
</div>

<style>
  .skills { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: start; }
  .lhs { position: sticky; top: calc(var(--nav-h) + 32px); container-type: inline-size; }
  .word { font-size: 27cqw; font-weight: 500; letter-spacing: -.06em; line-height: .8; margin-bottom: 24px; }
  .bars { display: grid; gap: 6px; }
  .t-acc { border-radius: 14px; background: var(--surface); }
  .t-acc-head { display: flex; width: 100%; align-items: center; justify-content: space-between; min-height: 64px; padding: 0 22px; text-align: left;
    font-size: var(--t-lead); font-weight: 500; letter-spacing: -.01em; }
  .t-acc-head:hover { color: var(--accent); }
  .t-acc-chevron svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }

  /* transitions.dev accordion: grid rows 0fr → 1fr, content cross-blurs in, chevron flips */
  .t-acc-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 250ms var(--ease-smooth-out); }
  .t-acc[data-open="true"] .t-acc-panel { grid-template-rows: 1fr; }
  .t-acc-panel-inner { overflow: hidden; opacity: 0; filter: blur(2px); transition: opacity 250ms var(--ease-smooth-out), filter 250ms var(--ease-smooth-out); }
  .t-acc[data-open="true"] .t-acc-panel-inner { opacity: 1; filter: blur(0); }
  .t-acc-panel-inner p { padding: 0 22px; }
  .t-acc-panel-inner p:last-child { padding-bottom: 22px; margin-top: 4px; font-size: var(--t-small); }
  .t-acc-chevron { display: inline-flex; transform: scaleY(1); transition: transform 250ms var(--ease-smooth-out); }
  .t-acc-chevron path { vector-effect: non-scaling-stroke; }
  .t-acc[data-open="true"] .t-acc-chevron { transform: scaleY(-1); }
  :global(:root[data-motion="calm"]) .t-acc-panel, :global(:root[data-motion="calm"]) .t-acc-panel-inner, :global(:root[data-motion="calm"]) .t-acc-chevron { transition: none; }

  @media (max-width: 860px) {
    .skills { grid-template-columns: 1fr; }
    .lhs { position: static; }
    .word { font-size: 24vw; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.t-acc').forEach((acc) => {
    const head = acc.querySelector<HTMLButtonElement>('.t-acc-head')!;
    head.addEventListener('click', () => {
      const open = acc.dataset.open === 'true';
      acc.dataset.open = String(!open);
      head.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
