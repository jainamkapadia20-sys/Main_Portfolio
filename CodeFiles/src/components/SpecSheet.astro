---
// Lettered data plate (ref: 03-aristide-benoist), shared by case studies and the car page.
interface Props { items: { label: string; value: string }[]; caption?: string }
const { items, caption } = Astro.props;
---
<div class="spec">
  {caption && <p class="mono muted cap">{caption}</p>}
  <dl class="mono">
    {items.map((it, i) => (
      <div class="row"><span class="key muted" aria-hidden="true">{String.fromCharCode(65 + i)}</span><dt>{it.label}</dt><dd>{it.value}</dd></div>
    ))}
  </dl>
</div>
<style>
  .cap { margin-bottom: var(--s2); }
  dl { border-top: 1px solid var(--ink); }
  .row { display: grid; grid-template-columns: 2.5em 10em 1fr; gap: var(--s2); padding: 10px 0; border-bottom: 1px solid var(--rule); }
  dt { color: var(--graphite); }
  @media (max-width: 480px) { .row { grid-template-columns: 2em 1fr; row-gap: 2px; } dd { grid-column: 2; } }
</style>
