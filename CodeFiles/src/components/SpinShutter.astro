---
// The project orbit (src/fx/shutter.ts): every project as a card on a slowly spinning ring. Point at a card to pull
// focus to it; click it to bring it to the front, click again to open it. The caption names the card in focus.
// A plain list of the same links sits underneath for screen readers and for visitors without JS.
import { getImage } from 'astro:assets';
import { sortedProjects } from '../lib/projects';
import { withBase } from '../lib/url';

const projects = await sortedProjects();
const items = await Promise.all(projects.map(async (p) => ({
  title: p.data.title,
  tag: p.data.category,
  subtitle: p.data.placeholder ? `${p.data.category} · Coming soon` : `${p.data.type}, ${p.data.year}`,
  href: withBase(`/work/${p.id}`),   // JSON props aren't rebased after the build, so prefix here
  src: p.data.cover ? (await getImage({ src: p.data.cover, width: 900, format: 'webp' })).src : undefined,
})));
const first = items[0];
---
<div class="shutter" data-shutter={JSON.stringify(items)}>
  <canvas tabindex="0" aria-label="Project orbit. Arrow keys bring the next project forward, Enter opens it, Space pauses."></canvas>
  <div class="cap">
    <a class="cap-link" href={first.href} data-cap-link>
      <span class="cap-title" data-cap-title>{first.title}</span>
      <span class="cap-sub" data-cap-sub>{first.subtitle}</span>
    </a>
  </div>
  <ul class="sr-only">
    {items.map((it) => <li><a href={it.href}>{it.title}, {it.subtitle}</a></li>)}
  </ul>
</div>

<style>
  .shutter { position: relative; display: grid; grid-template-rows: 1fr auto; height: min(96svh, 960px); min-height: 520px; }
  canvas { width: 100%; height: 100%; min-height: 0; cursor: grab; touch-action: pan-y; }
  canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 12px; }
  .cap { display: grid; justify-items: center; padding: 4px var(--pad) 0; text-align: center; }
  .cap-link { display: grid; gap: 4px; transition: opacity 160ms var(--ease-smooth-out), translate 160ms var(--ease-smooth-out); }
  .cap-title { font-size: var(--t-lead); font-weight: 600; letter-spacing: -.02em; }
  .cap-sub { color: var(--graphite); font-size: var(--t-small); }
  .cap-out .cap-link { opacity: 0; translate: 0 6px; }
</style>

<script>
  import { mountShutter } from '../fx/shutter';
  document.querySelectorAll<HTMLElement>('[data-shutter]').forEach((el) => mountShutter(el, JSON.parse(el.dataset.shutter!)));
</script>
