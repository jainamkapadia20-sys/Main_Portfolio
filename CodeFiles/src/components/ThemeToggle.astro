---
// Switches between the light and dark themes; the choice is remembered (see the head script in Base.astro).
---
<button class="theme mono" type="button" data-theme-toggle>
  <span class="dot" aria-hidden="true"></span><span data-theme-label>Light</span><span class="sr-only"> theme</span>
</button>
<style>
  .theme { display: inline-flex; align-items: center; gap: 8px; min-height: 24px; color: var(--graphite); }
  .theme:hover { color: var(--ink); }
  .dot { width: 9px; height: 9px; border: 1px solid currentColor; background: linear-gradient(90deg, currentColor 50%, transparent 50%); }
</style>
