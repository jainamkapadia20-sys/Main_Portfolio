---
// Ruler-style progress (ref: 03-aristide-benoist): one tick per step, a major tick every fifth, and an accent
// cursor at `value` (0 to 1).
interface Props { ticks?: number; value?: number; label?: string }
const { ticks = 40, value = 0, label = 'Progress' } = Astro.props;
---
<div class="ruler" role="img" aria-label={`${label}: ${Math.round(value * 100)}%`} data-ruler data-label={label}>
  {Array.from({ length: ticks + 1 }, (_, i) => <span class={i % 5 === 0 ? 'major' : ''} />)}
  <i class="cursor" style={`--v:${value}`}></i>
</div>
<style>
  .ruler { position: relative; display: flex; justify-content: space-between; align-items: end; height: 14px; container-type: inline-size; }
  .ruler span { width: 1px; height: 5px; background: var(--rule-strong); }
  .ruler span.major { height: 10px; background: var(--graphite); }
  .cursor { position: absolute; bottom: 0; left: 0; translate: calc(var(--v) * (100cqw - 2px)) 0; width: 2px; height: 14px; background: var(--accent); }
</style>
