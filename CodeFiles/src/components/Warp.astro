---
// The site's background (src/fx/warp.ts), fixed behind every page: the ribbon on the first screen, fading out as
// you scroll. Decorative.
---
<canvas class="warp" data-warp aria-hidden="true"></canvas>
<div class="road" data-hyperspeed aria-hidden="true"></div>

<style>
  .warp { position: fixed; inset: 0; width: 100vw; height: 100lvh; z-index: -1; pointer-events: none; }
  /* the Wangan era's light-trail highway, over the warp's plain ground and under the page */
  .road { position: fixed; inset: 0; z-index: -1; pointer-events: none; display: none; }
  :global(html[data-era="apex"]) .road { display: block; }
  .road :global(canvas) { display: block; width: 100%; height: 100%; }
</style>

<script>
  import { mountWarp } from '../fx/warp';
  import { onTheme, theme } from '../lib/theme';
  const c = document.querySelector<HTMLCanvasElement>('[data-warp]');
  if (c) mountWarp(c);
  // the highway loads only the first time someone lands in the Wangan era, and runs only while they're there
  const road = document.querySelector<HTMLElement>('[data-hyperspeed]');
  let run: ((on: boolean) => void) | null = null, loading = false;
  if (road) onTheme(async (t) => {
    const on = t === 'apex';
    if (on && !run && !loading) { loading = true; run = (await import('../fx/hyperspeed')).mountHyperspeed(road); }
    run?.(theme() === 'apex');
  });
</script>
