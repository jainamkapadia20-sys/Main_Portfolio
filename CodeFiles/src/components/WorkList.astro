---
// Project names are the index. Hover or focus a name and the framed preview beside it crossfades to that project;
// opening one hands the frame to the case study, where it grows into the stage (cross-document view transition).
// Every row is a plain link, so the list stays clickable wherever the page is scrolled.
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Placeholder from './Placeholder.astro';
import { withBase } from '../lib/url';
interface Props { projects: CollectionEntry<'projects'>[]; filter?: boolean }
const { projects, filter = false } = Astro.props;
const covers = await Promise.all(projects.map(async (p) => {
  const c = p.data.cover;
  if (!c) return undefined;
  return c.format === 'svg' ? c.src : (await getImage({ src: c, width: 1200, format: 'webp' })).src;
}));
const cats = [...new Set(projects.map((p) => p.data.category))];
---
<div class="work" data-work>
  {filter && (
    <div class="filters" role="group" aria-label="Filter by discipline" data-filters>
      <span class="pill" aria-hidden="true" data-pill></span>
      <button type="button" aria-pressed="true" data-cat="">All</button>
      {cats.map((c) => <button type="button" aria-pressed="false" data-cat={c}>{c}</button>)}
    </div>
  )}
  <div class="grid">
    <ol class="names">
      {projects.map((p, i) => (
        <li data-cat-of={p.data.category}>
          <a href={`/work/${p.id}`} data-row={i} aria-current={i === 0 ? 'true' : undefined}>
            <span class="pic" aria-hidden="true">
              {p.data.preview ? <video src={withBase(p.data.preview)} muted loop playsinline preload="none" poster={covers[i]}></video>
                : covers[i] ? <img src={covers[i]} alt="" loading="lazy" /> : <Placeholder ratio="4 / 3" label="Cover" decorative />}
            </span>
            <span class="nm">{p.data.title}</span>
            <span class="meta">{p.data.category}, {p.data.year}{p.data.placeholder && <span class="tag">Placeholder</span>}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="frame" aria-hidden="true">
      {projects.map((p, i) => (
        <div class:list={['layer', { on: i === 0 }]} data-layer={i}>
          {p.data.preview ? <video src={withBase(p.data.preview)} muted loop playsinline preload="metadata" data-autoplay poster={covers[i]}></video>
            : covers[i] ? <img src={covers[i]} alt="" loading={i === 0 ? 'eager' : 'lazy'} /> : <Placeholder ratio="4 / 3" label="Cover" decorative />}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: start; }
  .names { display: grid; }
  .names a { display: grid; justify-items: start; gap: 8px; padding-block: 14px; color: var(--graphite);
    transition: color var(--duration-fast) var(--ease-smooth-out); }
  .nm { font-size: clamp(2.5rem, 1rem + 4vw, 5rem); font-weight: 500; letter-spacing: -.04em; line-height: 1;
    transition: translate 500ms var(--ease-out-expo); }
  .meta { display: inline-flex; align-items: center; gap: 10px; font-size: var(--t-small); }
  .names a[aria-current] { color: var(--ink); }
  .names a[aria-current] .nm { translate: 12px 0; }
  .names a[aria-current] .meta { color: var(--accent); }
  .pic { display: none; }
  .frame { position: sticky; top: 18vh; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .layer { position: absolute; inset: 0; opacity: 0; scale: 1.04; filter: blur(6px);
    transition: opacity 450ms var(--ease-smooth-out), scale 800ms var(--ease-out-expo), filter 450ms var(--ease-smooth-out); }
  .layer.on { opacity: 1; scale: 1; filter: none; }
  .layer img, .layer video, .pic img, .pic video { width: 100%; height: 100%; object-fit: cover; }
  .layer :global(.ph), .pic :global(.ph) { height: 100%; }

  /* filter tabs: transitions.dev tabs sliding (the pill travels to the pressed tab) */
  .filters { position: relative; display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; margin-bottom: 40px; border-radius: 999px; background: var(--surface); }
  .filters button { position: relative; z-index: 1; min-height: 40px; padding: 0 18px; border-radius: 999px; color: var(--graphite); font-weight: 500;
    transition: color var(--duration-fast) var(--ease-smooth-out); }
  .filters button:hover { color: var(--ink); }
  .filters button[aria-pressed="true"] { color: var(--paper); }
  .pill { position: absolute; top: 4px; left: 0; height: 40px; width: var(--w, 0); translate: var(--x, 0) 0; border-radius: 999px; background: var(--ink);
    transition: translate var(--duration-fast) var(--ease-smooth-out), width var(--duration-fast) var(--ease-smooth-out); }
  .pill.no-anim { transition: none; }
  [data-cat-of][hidden] { display: none; }

  :global(:root[data-motion="calm"]) .layer { scale: 1; filter: none; transition: opacity 300ms; }
  :global(:root[data-motion="calm"]) .names a[aria-current] .nm { translate: 0 0; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .frame { display: none; }
    .names { gap: 40px; }
    .names a { color: var(--ink); }
    .names a[aria-current] .nm { translate: 0 0; }
    .names a .meta { color: var(--graphite); }
    .pic { display: block; width: 100%; aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; background: var(--surface); margin-bottom: 8px; }
    .nm { font-size: 9.5vw; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-work]').forEach((w) => {
    const rows = [...w.querySelectorAll<HTMLAnchorElement>('[data-row]')];
    const layers = [...w.querySelectorAll<HTMLElement>('[data-layer]')];
    const show = (i: number) => {
      rows.forEach((r, k) => (k === i ? r.setAttribute('aria-current', 'true') : r.removeAttribute('aria-current')));
      layers.forEach((l, k) => l.classList.toggle('on', k === i));
    };
    rows.forEach((r, i) => {
      r.addEventListener('pointerenter', () => show(i));
      r.addEventListener('focus', () => show(i));
      // the chosen preview becomes the shared element the case-study stage grows out of
      r.addEventListener('click', () => {
        const media = matchMedia('(max-width: 860px)').matches ? r.querySelector<HTMLElement>('.pic') : layers[i];
        if (media) media.style.viewTransitionName = 'case-media';
      });
    });
    // phone: the row's own picture plays while it is on screen
    w.querySelectorAll<HTMLVideoElement>('.pic video').forEach((v) => new IntersectionObserver(([e]) => {
      if (e.isIntersecting && document.documentElement.dataset.motion !== 'calm') v.play().catch(() => {}); else v.pause();
    }, { threshold: 0.4 }).observe(v));

    const bar = w.querySelector<HTMLElement>('[data-filters]');
    if (!bar) return;
    const pill = bar.querySelector<HTMLElement>('[data-pill]')!;
    const tabs = [...bar.querySelectorAll<HTMLButtonElement>('[data-cat]')];
    const place = (b: HTMLButtonElement, animate = true) => {
      pill.classList.toggle('no-anim', !animate);
      pill.style.setProperty('--x', `${b.offsetLeft}px`); pill.style.setProperty('--w', `${b.offsetWidth}px`); pill.style.top = `${b.offsetTop}px`;
      if (!animate) { void pill.offsetWidth; pill.classList.remove('no-anim'); }
    };
    const pick = (cat: string, animate = true) => {
      const b = tabs.find((t) => t.dataset.cat === cat) ?? tabs[0];
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === b)));
      place(b, animate);
      w.querySelectorAll<HTMLElement>('[data-cat-of]').forEach((li) => (li.hidden = !!b.dataset.cat && li.dataset.catOf !== b.dataset.cat));
      const first = rows.findIndex((r) => !r.closest('li')!.hidden);
      if (first >= 0) show(first);
      const url = new URL(location.href);
      b.dataset.cat ? url.searchParams.set('cat', b.dataset.cat) : url.searchParams.delete('cat');
      history.replaceState(null, '', url);
    };
    tabs.forEach((t) => t.addEventListener('click', () => pick(t.dataset.cat!)));
    pick(new URLSearchParams(location.search).get('cat') ?? '', false);
    addEventListener('resize', () => place(tabs.find((t) => t.getAttribute('aria-pressed') === 'true')!, false));
  });
</script>
