---
// The Adaptive Dashboard case study, told like a drive (after Arnav Srinath's "Cooked", which tells its story as a
// meal). It opens on the result, the cluster cycling through its states (the result film, once there is one), then
// the drive: a night in traffic, what research found, the route chosen, the testing, the finished cluster, and the
// same drive again with it. A road line draws itself down the page as you go. Shared behaviour (the dock, the
// count-up numbers, section snapping, the next-project link) lives in src/pages/work/[slug].astro.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ClusterPlayer from '../ClusterPlayer.astro';
import { withBase } from '../../lib/url';
import startup from '../../assets/hmi/01-startup.png';
import cruise from '../../assets/hmi/02-dashboard-main.png';
import traffic from '../../assets/hmi/03-traffic-main.png';
import exit from '../../assets/hmi/04-nav-highway.png';
import blind from '../../assets/hmi/05-blindspot.png';
import alongside from '../../assets/hmi/06-blindspot-traffic.png';
import closing from '../../assets/hmi/07-proximity-warning.png';
import cutin from '../../assets/hmi/08-proximity-alert.png';
import pedestrian from '../../assets/hmi/09-proximity-alert-2.png';
import autopark from '../../assets/hmi/10-park-auto.png';
import reversing from '../../assets/hmi/11-parking-manual.png';
import braking from '../../assets/hmi/12-crash-alert.png';
import wall from '../../assets/hmi/research.jpg';
import flows from '../../assets/hmi/flows.jpg';
import sketches from '../../assets/hmi/sketches.jpg';
import sbBlind from '../../assets/hmi/sb-blindspot.jpg';
import sbExit from '../../assets/hmi/sb-exit.jpg';
import sbPed from '../../assets/hmi/sb-pedestrian.jpg';
import sbPark from '../../assets/hmi/sb-parking.jpg';
import toyLane from '../../assets/hmi/toy-lane.jpg';
import toyChange from '../../assets/hmi/toy-change.jpg';
import toyKeep from '../../assets/hmi/toy-keep.jpg';
import toyPark from '../../assets/hmi/toy-park.jpg';

type P = CollectionEntry<'projects'>;
interface Props { project: P; next: P }
const { project, next } = Astro.props;
const p = project.data;
const film = p.blocks.find((b) => b.type === 'video' && b.src) as Extract<typeof p.blocks[number], { type: 'video' }> | undefined;
const cluster = p.blocks.find((b) => b.type === 'cluster') as Extract<typeof p.blocks[number], { type: 'cluster' }> | undefined;

// the result reel: the cluster's states in the order a drive meets them (stands in for the result film)
const reel = [
  { src: startup, t: 'Startup' }, { src: cruise, t: 'Highway cruise' }, { src: exit, t: 'Exit guidance' }, { src: blind, t: 'Blind spot' },
  { src: traffic, t: 'Traffic mode' }, { src: alongside, t: 'Car alongside' }, { src: closing, t: 'Closing in' }, { src: cutin, t: 'Cut-in' },
  { src: pedestrian, t: 'Pedestrian' }, { src: braking, t: 'Emergency braking' }, { src: autopark, t: 'Auto park' }, { src: reversing, t: 'Reversing' },
];
const phases = [
  { id: 'result', label: 'Result', stage: 'The cluster' },
  { id: 'start', label: 'Ignition', stage: 'The problem' },
  { id: 'discover', label: 'Scan', stage: 'Discover' },
  { id: 'define', label: 'Route', stage: 'Define' },
  { id: 'develop', label: 'Drive', stage: 'Develop' },
  { id: 'deliver', label: 'Arrive', stage: 'Deliver' },
  { id: 'outcome', label: 'Park', stage: 'Outcome' },
];
const notes = [
  { t: 'Small touchscreen buttons are hard to hit while driving', c: 'y' },
  { t: 'Pop-up alerts interrupt navigation', c: 'w' },
  { t: 'Important alerts get buried', c: 'g' },
  { t: 'Too much information at once', c: 'y' },
  { t: 'Navigation instructions appear too late', c: 'w' },
  { t: 'Looking away from the road for settings', c: 'g' },
  { t: 'Distracted by unnecessary animations', c: 'y' },
  { t: 'Feels stressed in heavy traffic', c: 'w' },
];
const noticed = [
  { t: 'Speed is checked constantly', d: 'On highways, drivers glance at speed every few seconds.', shot: cruise, alt: 'Highway cruise screen with the speed large on the left' },
  { t: 'Priority moves with the road', d: 'New places need navigation; tight spaces need cameras.', shot: traffic, alt: 'Traffic mode with map and proximity view' },
  { t: 'Alerts get buried', d: 'Too many notifications, and the one that matters gets lost.', shot: cutin, alt: 'Red alert ring and warning sign' },
  { t: 'Touch pulls eyes away', d: 'Small targets and deep menus take attention off the road.', shot: autopark, alt: 'Auto park asks for a single tap to confirm' },
];
const modes = {
  highway: { img: cruise, alt: 'Highway mode: speed and rpm gauges, limit sign and ACC', shows: ['Speed and the limit', 'Range for planning stops', 'Exit guidance', 'Blind spot and lane keeping', 'Fatigue alerts'] },
  traffic: { img: traffic, alt: 'Traffic mode: speed ring, map and 360° proximity, rpm gauge removed', shows: ['360° proximity', 'Pedestrians and cyclists', 'The next turn, early', 'Parking cameras', 'Start-stop and climate'] },
};
const ring = [
  { src: traffic, c: '#3FD07A', t: 'Green', d: 'All clear' },
  { src: alongside, c: '#E8D53A', t: 'Yellow', d: 'A car alongside' },
  { src: closing, c: '#F08A2C', t: 'Orange', d: 'Closing in' },
  { src: cutin, c: '#E8343C', t: 'Red', d: 'Act now' },
];
const edges = [
  { src: braking, t: 'Emergency braking', d: 'The whole cluster turns red. One message, nothing else competes.', alt: 'The cluster washed red with the words Emergency Braking' },
  { src: pedestrian, t: 'Pedestrian ahead', d: 'A red cone points at the person, not a generic warning.', alt: 'Pedestrian Detected warning with a red cone ahead of the car' },
  { src: reversing, t: 'Reversing', d: 'The cluster becomes the rear camera, with arcs that go green, amber, red.', alt: 'Rear camera view beside a top-down car with sensor arcs' },
  { src: startup, t: 'Startup', d: 'Every warning light checks itself once, then clears.', alt: 'Startup screen with gauges at zero and all warning lights on' },
];
const chips = [{ k: 'Discipline', v: 'HMI' }, { k: 'Duration', v: p.duration }, { k: 'Tools', v: p.tools.join(' · ') }];
const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8" /><path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12" /></svg>';
const check = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg>';
---
<article class="drive" aria-labelledby="case-h">
  <!-- the road line: a lane marking that draws itself down the page as the drive goes on -->
  <svg class="road-line" viewBox="0 0 100 1000" preserveAspectRatio="none" aria-hidden="true">
    <defs><mask id="road-reveal"><path class="reveal" d="M50 0 C 10 120, 90 230, 50 340 S 10 560, 50 670 S 90 880, 50 1000" pathLength="1" data-road /></mask></defs>
    <path class="edge" d="M50 0 C 10 120, 90 230, 50 340 S 10 560, 50 670 S 90 880, 50 1000" mask="url(#road-reveal)" />
    <path class="dash" d="M50 0 C 10 120, 90 230, 50 340 S 10 560, 50 670 S 90 880, 50 1000" mask="url(#road-reveal)" />
  </svg>

  <!-- RESULT: the finished cluster, first -->
  <section id="result" class="sec hero" data-sec>
    <div class="wrap">
      <div class="film">
        {film ? <video src={withBase(film.src!)} muted loop playsinline autoplay preload="metadata" aria-label={film.alt}></video> : (
          <div class="reel" data-reel role="img" aria-label="The cluster cycling through its twelve states, from startup to reversing">
            {reel.map((r, i) => <Image class:list={['frame', { on: i === 0 }]} src={r.src} alt="" widths={[800, 1400, 2000]} sizes="(min-width: 1300px) 1240px, 100vw" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />)}
            <p class="reel-cap meta" aria-hidden="true"><span class="dot"></span><span data-reel-cap>{reel[0].t}</span><span class="count" data-reel-n>01 / {reel.length}</span></p>
          </div>
        )}
      </div>
    </div>
    <header class="title wrap">
      <p class="kicker meta">An HMI case study</p>
      <h1 id="case-h">{p.title}</h1>
      <p class="tagline">Less on the screen, more on the road</p>
      <p class="sum muted">{p.summary}</p>
      <ul class="chips">{chips.map((c) => <li><span class="muted">{c.k}</span> {c.v}</li>)}</ul>
      <p class="hint meta"><span class="dot"></span>Scroll to start the drive</p>
    </header>
  </section>

  <!-- IGNITION: the scene, and the tension -->
  <section id="start" class="sec scene" data-sec>
    <p class="big center" data-reveal>Imagine this.</p>
    <p class="big center" data-reveal>9 pm. Rain. Bumper to bumper.<br /><span class="muted">Your cluster shows everything at once.</span></p>
    <p class="big center" data-reveal>…and you <span class="accent">look down.</span></p>
    <div class="balance" data-balance data-reveal>
      <div class="pan left"><b>Everything on screen</b><span class="muted">speed · revs · media · maps · alerts</span></div>
      <div class="pan right"><b class="accent">Eyes on the road</b><span class="muted">what driving actually needs</span></div>
      <svg class="beam" viewBox="0 0 600 160" aria-hidden="true">
        <g class="arm"><rect x="40" y="56" width="520" height="10" rx="5" /><rect x="70" y="40" width="12" height="20" rx="3" /><rect x="518" y="40" width="12" height="20" rx="3" /></g>
        <path class="pivot" d="M300 66 L260 140 L340 140 Z" /><rect class="pivot" x="230" y="140" width="140" height="10" rx="4" />
      </svg>
    </div>
    <div class="who wrap">
      <h2 class="h2" data-reveal>Who's behind the wheel</h2>
      <ul class="people">
        <li class="card" data-reveal><svg viewBox="0 0 64 40" aria-hidden="true"><path d="M2 30 L62 30" /><path d="M8 30 V22 L18 12 H44 L56 22 V30" /><circle cx="18" cy="32" r="5" /><circle cx="46" cy="32" r="5" /></svg><b>Highway commuters</b><span class="muted">Long, fast drives. Speed, range and the next exit.</span></li>
        <li class="card" data-reveal style="--i:1"><svg viewBox="0 0 64 40" aria-hidden="true"><path d="M2 30 L62 30" /><rect x="6" y="14" width="22" height="16" rx="4" /><rect x="36" y="14" width="22" height="16" rx="4" /><circle cx="12" cy="32" r="3" /><circle cx="24" cy="32" r="3" /><circle cx="42" cy="32" r="3" /><circle cx="54" cy="32" r="3" /></svg><b>City drivers</b><span class="muted">Stop and go. Gaps, people, parking.</span></li>
      </ul>
      <p class="muted center small" data-reveal>Primary audience: drivers aged 25 to 35.</p>
    </div>
  </section>

  <!-- SCAN / DISCOVER -->
  <section id="discover" class="sec wrap" data-sec>
    <p class="phase meta" data-reveal><span class="no">01</span>Discover</p>
    <h2 class="display" data-reveal>Reading<br />the road</h2>
    <div class="stats" data-reveal>
      <p><span class="num" data-count="4">4</span><span class="meta">research questions</span></p>
      <p><span class="num" data-count="2">2</span><span class="meta">driving contexts</span></p>
      <p><span class="num" data-count="9">9</span><span class="meta">pain points</span></p>
      <p><span class="num" data-count="7">7</span><span class="meta">scenarios</span></p>
    </div>

    <h3 class="h2 sub" data-reveal>What came up</h3>
    <ul class="notes">{notes.map((n, i) => <li class:list={['note', n.c]} style={`--r:${(i % 3 - 1) * 1.6}deg; --i:${i % 4}`} data-reveal>{n.t}</li>)}</ul>

    <h3 class="h2 sub" data-reveal>What we noticed</h3>
    <ul class="noticed">
      {noticed.map((n, i) => (
        <li class="card" data-reveal style={`--i:${i}`}>
          <span class="meta accent">{String(i + 1).padStart(2, '0')}</span>
          <b>{n.t}</b>
          <span class="muted">{n.d}</span>
          <figure class="from"><Image src={n.shot} alt={n.alt} widths={[400, 800]} sizes="280px" /><figcaption class="meta">From the cluster</figcaption></figure>
        </li>
      ))}
    </ul>

    <figure class="fig" data-reveal>
      <Image src={wall} alt="Miro wall of sticky notes under four research questions, with highway and traffic clusters, the brief and the scenarios" widths={[800, 1400, 2000]} sizes="(min-width: 1300px) 1240px, 100vw" />
      <figcaption class="muted">The research wall: four questions, then what matters on the highway and in traffic.</figcaption>
    </figure>
  </section>

  <!-- ROUTE / DEFINE -->
  <section id="define" class="sec wrap" data-sec>
    <p class="phase meta" data-reveal><span class="no">02</span>Define</p>
    <h2 class="display" data-reveal>Planning<br />the route</h2>
    <p class="meta accent hmw-k" data-reveal>How might we</p>
    <p class="hmw" data-reveal>How might we let the cluster <span class="accent">show less</span>, without the driver ever <span class="accent">missing what matters?</span></p>
    <p class="pull" data-reveal>Drivers don't need more information. They need the right information at the right moment.</p>

    <div class="modes" data-modes data-reveal>
      <div class="modes-head">
        <h3 class="h2">Two modes, one cluster</h3>
        <div class="switch" role="group" aria-label="Driving mode">
          <button type="button" aria-pressed="true" data-mode="highway">Highway</button>
          <button type="button" aria-pressed="false" data-mode="traffic">Traffic</button>
        </div>
      </div>
      <div class="modes-body">
        <div class="modes-shot">
          <Image class="m on" data-shot="highway" src={modes.highway.img} alt={modes.highway.alt} widths={[800, 1400]} sizes="(min-width: 1100px) 760px, 100vw" />
          <Image class="m" data-shot="traffic" src={modes.traffic.img} alt={modes.traffic.alt} widths={[800, 1400]} sizes="(min-width: 1100px) 760px, 100vw" />
        </div>
        <ul class="shows" data-list="highway">{modes.highway.shows.map((s) => <li>{s}</li>)}</ul>
        <ul class="shows" data-list="traffic" hidden>{modes.traffic.shows.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>

    <div class="brief card" data-reveal>
      <p class="meta accent">The brief</p>
      <h3 class="h3">Show less, warn better</h3>
      <ul class="checks">
        {['Only what the road needs right now', 'A hierarchy you read in one glance', 'Controls without menus', 'Awareness without overload'].map((t) => <li><span class="tick" set:html={check} />{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- DRIVE / DEVELOP -->
  <section id="develop" class="sec wrap" data-sec>
    <p class="phase meta" data-reveal><span class="no">03</span>Develop</p>
    <h2 class="display" data-reveal>Test<br />drives</h2>

    <h3 class="h2 sub" data-reveal>Seven moments, storyboarded</h3>
    <p class="muted lede" data-reveal>Each told in six shots, from calm to safe. Four of them:</p>
    <div class="grid2" data-reveal>
      {[[sbBlind, 'Blind spot, highway'], [sbExit, 'Exit guidance, highway'], [sbPed, 'Pedestrian, traffic'], [sbPark, 'Parking assist, traffic']].map(([src, t]) => (
        <figure><Image src={src as ImageMetadata} alt={`Storyboard: ${t}`} widths={[600, 1100]} sizes="(min-width: 1100px) 600px, 100vw" /><figcaption class="meta">{t}</figcaption></figure>
      ))}
    </div>

    <h3 class="h2 sub" data-reveal>Paper first</h3>
    <p class="muted lede" data-reveal>Three traffic and three highway layouts, then four revised ones.</p>
    <figure class="fig" data-reveal><Image src={sketches} alt="Four hand-drawn cluster layouts with speed, rpm, range and status bars" widths={[800, 1400, 2000]} sizes="(min-width: 1300px) 1240px, 100vw" /></figure>

    <h3 class="h2 sub" data-reveal>On a paper road</h3>
    <p class="muted lede" data-reveal>Toy cars acting out each scenario, with warnings drawn where the screen would show them.</p>
    <div class="grid2" data-reveal>
      {[[toyLane, 'Lane drift'], [toyChange, 'Safe lane change'], [toyKeep, 'Lane keeping'], [toyPark, 'Too close to park']].map(([src, t]) => (
        <figure><Image src={src as ImageMetadata} alt={`Model cars on a paper road: ${t}`} widths={[500, 900]} sizes="(min-width: 1100px) 600px, 100vw" /><figcaption class="meta">{t}</figcaption></figure>
      ))}
    </div>

    <h3 class="h2 sub" data-reveal>The full flow</h3>
    <p class="muted lede" data-reveal>From sensor to screen, with the points where a warning becomes an alert.</p>
    <figure class="fig" data-reveal><Image src={flows} alt="User and system flowcharts for lane change, speed breaker and traffic mode" widths={[800, 1400, 2000]} sizes="(min-width: 1300px) 1240px, 100vw" /></figure>

    <div class="flip card" data-reveal>
      <p class="meta accent">A turn in the road</p>
      <h3 class="h3">Traffic mode dropped the rev counter</h3>
      <div class="ba">
        <figure><Image src={cruise} alt="Highway screen with speed and rpm gauges" widths={[500, 900]} sizes="(min-width: 1100px) 520px, 100vw" /><figcaption><span class="meta">Before</span>Sketches kept speed and rpm side by side in both modes.</figcaption></figure>
        <figure><Image src={traffic} alt="Traffic screen with the rpm gauge removed" widths={[500, 900]} sizes="(min-width: 1100px) 520px, 100vw" /><figcaption><span class="meta accent">After</span>In traffic, revs mean little. The map and 360° view take their place.</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- ARRIVE / DELIVER -->
  <section id="deliver" class="sec wrap" data-sec>
    <p class="phase meta" data-reveal><span class="no">04</span>Deliver</p>
    <h2 class="display" data-reveal>The finished<br />cluster</h2>

    <h3 class="h2 sub" data-reveal>One ring that warns</h3>
    <p class="muted lede" data-reveal>The ring around the speed shifts colour, so the level is felt before any text is read.</p>
    <ol class="ring">
      {ring.map((r, i) => (
        <li data-reveal style={`--i:${i}; --c:${r.c}`}>
          <Image src={r.src} alt={`${r.t} ring: ${r.d}`} widths={[400, 800]} sizes="(min-width: 1100px) 300px, 50vw" />
          <p><span class="swatch"></span><b>{r.t}</b> <span class="muted">{r.d}</span></p>
        </li>
      ))}
    </ol>

    {cluster && (
      <div class="try">
        <h3 class="h2 sub" data-reveal>Try it yourself</h3>
        <p class="muted lede" data-reveal>Pick a mode, then a moment.</p>
        <ClusterPlayer block={cluster} />
      </div>
    )}

    <h3 class="h2 sub" data-reveal>When it matters most</h3>
    <ul class="edges">
      {edges.map((e, i) => (
        <li class="card" data-reveal style={`--i:${i % 2}`}>
          <Image src={e.src} alt={e.alt} widths={[600, 1100]} sizes="(min-width: 1100px) 560px, 100vw" />
          <b>{e.t}</b><span class="muted">{e.d}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- PARK / OUTCOME: the same drive, again -->
  <section id="outcome" class="sec" data-sec>
    <p class="big center" data-reveal>Imagine this <span class="accent">again.</span></p>
    <p class="big center" data-reveal>9 pm. Rain. Bumper to bumper.<br /><span class="muted">The cluster shows the car ahead, the gap, the next turn.</span></p>
    <p class="big center" data-reveal>…and your eyes <span class="accent">stay up.</span></p>
    <div class="wrap"><div class="again" data-reveal><Image src={traffic} alt="The traffic-mode cluster: speed ring, car ahead, map and range" widths={[800, 1400, 2000]} sizes="(min-width: 1300px) 1240px, 100vw" /></div></div>

    <div class="wrap back-look">
      <h3 class="h2 sub" data-reveal>Looking back</h3>
      <div class="cols">
        {[
          { k: 'Went well', v: ['Every screen traces back to a research question', 'One ring carries four warning levels', 'Toy-car runs made each scenario concrete'] },
          { k: 'Hurdles', v: ['Speed and range stay static across screens', 'Three storyboarded scenarios never reached a screen'] },
          { k: 'Next time', v: ['Screens for fatigue, speed breaker and motorcycle alerts', 'Sound and haptic cues for each ring colour', 'Glance tests with drivers in a simulator'] },
        ].map((c, i) => <div class="card" data-reveal style={`--i:${i}`}><p class="meta accent">{c.k}</p><ul class="dots">{c.v.map((x) => <li>{x}</li>)}</ul></div>)}
      </div>
      <p class="muted small" data-reveal>Concept work, not affiliated with Porsche.</p>
    </div>
  </section>

  <section class="sec wrap next" aria-labelledby="next-h">
    <p class="meta accent">Next on the road</p>
    <a class="next-link" href={`/work/${next.id}`} id="next-h">{next.data.title} <span class="t-learn-chevron" set:html={arrow} /></a>
  </section>

  <nav class="dock" aria-label="Case study sections" data-dock>
    <span class="pill" aria-hidden="true"></span>
    {phases.map((s) => <a href={`#${s.id}`} data-dock-link={s.id}><b>{s.label}</b><span>{s.stage}</span></a>)}
  </nav>
</article>

<style>
  .drive { position: relative; overflow-x: clip; }
  .sec { position: relative; padding-top: clamp(110px, 13vw, 200px); scroll-margin-top: 24px; max-width: 1300px; margin-inline: auto; }
  .accent { color: var(--accent); }
  .muted { color: var(--graphite); }
  .center { text-align: center; }
  .small { font-size: var(--t-small); }
  .card { background: var(--surface); border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent); border-radius: var(--radius); padding: clamp(18px, 2.2vw, 28px); }
  .h2 { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(1.9rem, 1rem + 2.6vw, 3.4rem); letter-spacing: -.03em; line-height: 1.02; text-wrap: balance; }
  .h3 { font-size: clamp(1.3rem, 1rem + .8vw, 1.7rem); font-weight: 600; letter-spacing: -.015em; line-height: 1.2; }
  .sub { margin-top: clamp(80px, 9vw, 130px); }
  .lede { margin-top: var(--s-3); max-width: 52ch; line-height: 1.45; }
  p, li { text-wrap: pretty; }

  /* the road line, down the left */
  .road-line { position: absolute; top: 100svh; bottom: 0; left: max(4px, calc(50% - 700px)); width: 90px; height: calc(100% - 100svh); overflow: visible; pointer-events: none; }
  .road-line .edge { fill: none; stroke: color-mix(in srgb, var(--ink) 14%, transparent); stroke-width: 26; vector-effect: non-scaling-stroke; }
  .road-line .dash { fill: none; stroke: var(--accent); stroke-width: 3; stroke-dasharray: 18 16; vector-effect: non-scaling-stroke; }
  .road-line .reveal { fill: none; stroke: #fff; stroke-width: 40; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--draw, 0)); }

  /* RESULT */
  .hero { padding-top: clamp(64px, 7vw, 96px); max-width: none; }
  .film { max-width: 1240px; margin-inline: auto; border-radius: var(--radius); overflow: hidden; background: #050505; aspect-ratio: 2 / 1;
    box-shadow: 0 30px 90px hsl(0 0% 0% / .45); }
  .film video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .reel { position: relative; width: 100%; height: 100%; }
  .reel :global(.frame) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; scale: 1.02;
    transition: opacity 700ms var(--ease-smooth-out), scale 2400ms linear; }
  .reel :global(.frame.on) { opacity: 1; scale: 1; }
  .reel-cap { position: absolute; left: 16px; bottom: 14px; display: flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px; color: #fff;
    background: hsl(0 0% 0% / .5); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .reel-cap .count { opacity: .6; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent); }
  .title { display: grid; justify-items: center; gap: var(--s-4); text-align: center; margin-top: clamp(40px, 6vw, 80px); }
  .kicker { color: var(--accent); }
  .title h1 { font-family: var(--font-display); font-weight: var(--display-weight); font-size: min(var(--t-display), 11vw); letter-spacing: -.035em; line-height: .92; overflow-wrap: anywhere; text-wrap: balance; }
  .tagline { font-size: clamp(1.4rem, 1rem + 1.2vw, 2rem); font-weight: 600; letter-spacing: -.02em; color: var(--accent); }
  .sum { max-width: 44ch; line-height: 1.45; }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2); margin-top: var(--s-2); }
