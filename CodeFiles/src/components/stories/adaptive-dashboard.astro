  .display { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(3rem, 1rem + 6vw, 7.5rem); letter-spacing: -.04em; line-height: .92; margin-top: var(--s-4); }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: clamp(48px, 6vw, 80px); border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); border-radius: var(--radius); }
  .stats p { display: grid; gap: var(--s-2); padding: clamp(18px, 2.4vw, 32px); }
  .stats p + p { border-left: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); }
  .num { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(2.6rem, 1rem + 4vw, 5rem); letter-spacing: -.04em; line-height: .9; color: var(--accent); font-variant-numeric: tabular-nums; }

  .notes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); margin-top: var(--s-6); }
  .note { position: relative; min-height: 150px; padding: 30px 18px 18px; border-radius: 6px; font-weight: 600; line-height: 1.35; rotate: var(--r); color: #1a1414;
    box-shadow: 0 10px 24px hsl(0 0% 0% / .3); }
  .note::before { content: ''; position: absolute; top: -10px; left: 50%; translate: -50% 0; width: 56px; height: 20px; border-radius: 3px; background: hsl(0 0% 100% / .35); }
  .note.y { background: #F6D77A; } .note.w { background: #F2EEE8; } .note.g { background: #BFE3C2; }
  .noticed { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); margin-top: var(--s-6); }
  .noticed li { display: grid; gap: var(--s-2); align-content: start; }
  .noticed b { font-size: 1.1rem; line-height: 1.25; }
  .from { margin-top: var(--s-3); display: grid; gap: 6px; }
  .from :global(img) { width: 100%; height: auto; border-radius: 10px; }
  .from figcaption { color: var(--accent); }
  .fig { margin-top: clamp(48px, 6vw, 80px); display: grid; gap: var(--s-3); }
  .fig :global(img) { width: 100%; height: auto; border-radius: var(--radius); background: var(--surface); }

  /* ROUTE */
  .hmw-k { margin-top: clamp(64px, 8vw, 110px); }
  .hmw { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(2rem, 1rem + 3.2vw, 4.2rem); letter-spacing: -.03em; line-height: 1.04; margin-top: var(--s-4); max-width: 22ch; text-wrap: balance; }
  .pull { margin-top: var(--s-6); padding-left: var(--s-5); border-left: 3px solid var(--accent); font-size: var(--t-lead); line-height: 1.35; max-width: 46ch; }
  .modes { margin-top: clamp(80px, 9vw, 130px); }
  .modes-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--s-4); }
  .switch { display: inline-flex; padding: 4px; border-radius: 999px; background: var(--surface); border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent); }
  .switch button { min-height: 44px; padding: 0 22px; border-radius: 999px; border: 0; background: none; color: var(--graphite); font: inherit; font-weight: 600; cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-smooth-out), color var(--duration-fast) var(--ease-smooth-out); }
  .switch button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .switch button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .modes-body { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--s-6); margin-top: var(--s-6); align-items: center; }
  .modes-shot { position: relative; aspect-ratio: 2 / 1; border-radius: var(--radius); overflow: hidden; background: #050505; }
  .modes-shot :global(.m) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 500ms var(--ease-smooth-out); }
  .modes-shot :global(.m.on) { opacity: 1; }
  .shows { display: grid; gap: var(--s-3); font-size: 1.1rem; }
  .shows li { padding: 12px 16px; border-radius: 12px; background: var(--surface); }
  .brief { margin-top: clamp(64px, 8vw, 110px); display: grid; gap: var(--s-3); max-width: 640px; }
  .checks { display: grid; gap: var(--s-3); margin-top: var(--s-2); }
  .checks li { display: grid; grid-template-columns: 26px 1fr; gap: 12px; align-items: center; }
  .tick { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 6px; background: var(--accent); }
  .tick :global(svg) { width: 15px; height: 15px; fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  /* DRIVE */
  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); margin-top: var(--s-6); }
  .grid2 figure { display: grid; gap: var(--s-2); }
  .grid2 :global(img) { width: 100%; height: auto; border-radius: 12px; background: var(--surface); }
  .flip { margin-top: clamp(80px, 9vw, 130px); display: grid; gap: var(--s-3); }
  .ba { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); margin-top: var(--s-3); }
  .ba figure { display: grid; gap: var(--s-3); }
  .ba :global(img) { width: 100%; height: auto; border-radius: 12px; }
  .ba figcaption { display: grid; gap: 4px; line-height: 1.45; }

  /* ARRIVE */
  .ring { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); margin-top: var(--s-6); }
  .ring li { display: grid; gap: var(--s-3); }
  .ring :global(img) { width: 100%; height: auto; border-radius: 12px; outline: 2px solid var(--c); outline-offset: 3px; }
  .ring p { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .swatch { width: 12px; height: 12px; border-radius: 50%; background: var(--c); }
  .try { margin-inline: calc(var(--inset) * -1); }
  .try > :not(:global(.cp)) { padding-inline: var(--inset); }
  .try :global(.cp) { margin-top: var(--s-6); }
  .edges { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); margin-top: var(--s-6); }
  .edges li { display: grid; gap: var(--s-2); align-content: start; }
  .edges :global(img) { width: 100%; height: auto; border-radius: 10px; margin-bottom: var(--s-2); }
  .edges b { font-size: 1.2rem; }

  /* PARK */
  .again { margin-top: clamp(64px, 8vw, 110px); border-radius: var(--radius); overflow: hidden; max-width: 1240px; margin-inline: auto; box-shadow: 0 30px 90px hsl(0 0% 0% / .45); }
  .again :global(img) { width: 100%; height: auto; display: block; }
  .back-look { display: grid; gap: var(--s-5); }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
  .cols .card { display: grid; gap: var(--s-3); align-content: start; }
  .dots { display: grid; gap: var(--s-3); }
  .dots li { position: relative; padding-left: 18px; line-height: 1.45; }
  .dots li::before { content: ''; position: absolute; left: 0; top: .6em; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }

  .next { display: grid; gap: 8px; padding-bottom: 160px; }
  .next-link { display: inline-flex; align-items: center; gap: 16px; font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(2.4rem, 1rem + 5vw, 6rem);
    letter-spacing: -.04em; line-height: 1; transition: color var(--duration-fast) var(--ease-smooth-out); }
  .next-link:hover { color: var(--accent); }
  .next-link :global(svg) { width: .5em; height: .5em; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }

  /* the dock: two-line tags (the drive's word over the design stage), a highlight slides to the one in view */
  .dock { position: fixed; z-index: 40; left: 50%; bottom: max(14px, env(safe-area-inset-bottom)); display: flex; gap: 2px; padding: 5px; max-width: calc(100vw - 20px);
    overflow-x: auto; scrollbar-width: none; border-radius: 18px; background: color-mix(in srgb, var(--surface) 75%, transparent);
    backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4); border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    box-shadow: 0 10px 40px hsl(0 0% 0% / .35); opacity: 0; translate: -50% 16px; pointer-events: none;
    transition: opacity 350ms var(--ease-smooth-out), translate 450ms var(--ease-out-expo); }
  .dock:global(.show) { opacity: 1; translate: -50% 0; pointer-events: auto; }
  .dock a { position: relative; z-index: 1; display: grid; gap: 1px; padding: 8px 14px; min-height: 44px; border-radius: 13px; white-space: nowrap; color: var(--graphite);
    transition: color var(--duration-fast) var(--ease-smooth-out); }
  .dock a b { font-size: var(--t-small); font-weight: 600; }
  .dock a span { font-size: 11px; opacity: .75; }
  .dock a:hover, .dock a[aria-current='true'] { color: var(--ink); }
  .dock a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .pill { position: absolute; z-index: 0; top: 5px; bottom: 5px; left: 0; width: 0; border-radius: 13px; background: color-mix(in srgb, var(--ink) 12%, transparent);
    transition: translate 400ms var(--ease-smooth-out), width 400ms var(--ease-smooth-out); }
  :global(html) { scroll-padding-bottom: 96px; }

  @media (max-width: 900px) {
    .notes, .noticed, .ring { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats p:nth-child(3) { border-left: 0; }
    .stats p:nth-child(n + 3) { border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); }
    .modes-body, .cols, .edges, .ba { grid-template-columns: 1fr; }
    .road-line { display: none; }
  }
  @media (max-width: 560px) {
    .notes, .noticed, .grid2, .people { grid-template-columns: 1fr; }
    .pan, .pan.left, .pan.right { position: static; translate: none; }
    .balance { display: grid; gap: var(--s-4); }
    .beam { margin-top: 0; }
  }
  :global(:root[data-motion="calm"]) .reel :global(.frame), :global(:root[data-motion="calm"]) .arm, :global(:root[data-motion="calm"]) .pan,
  :global(:root[data-motion="calm"]) .dock, :global(:root[data-motion="calm"]) .pill { transition-duration: 0ms; }
</style>

<script>
  import { calm } from '../../lib/motion';
  const still = calm();

  // the result reel plays while it is on screen (calm: the first frame, still)
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  if (reel && !still) {
    const frames = [...reel.querySelectorAll<HTMLElement>('.frame')];
    const cap = reel.querySelector<HTMLElement>('[data-reel-cap]')!, n = reel.querySelector<HTMLElement>('[data-reel-n]')!;
    const names = ['Startup', 'Highway cruise', 'Exit guidance', 'Blind spot', 'Traffic mode', 'Car alongside', 'Closing in', 'Cut-in', 'Pedestrian', 'Emergency braking', 'Auto park', 'Reversing'];
    let i = 0, timer = 0;
    const step = () => {
      frames[i].classList.remove('on');
      i = (i + 1) % frames.length;
      frames[i].classList.add('on');
      cap.textContent = names[i];
      n.textContent = `${String(i + 1).padStart(2, '0')} / ${frames.length}`;
    };
    new IntersectionObserver(([e]) => {
      clearInterval(timer);
      if (e.isIntersecting) timer = window.setInterval(step, 2400);
    }).observe(reel);
  }

  // the balance tips toward "everything on screen" as the scene plays out; the road line draws as you go
  const balance = document.querySelector<HTMLElement>('[data-balance]');
  const road = document.querySelector<SVGPathElement>('[data-road]');
  const article = document.querySelector<HTMLElement>('.drive');
  const frame = () => {
    raf = 0;
    if (balance) {
      const r = balance.getBoundingClientRect();
      const k = Math.min(1, Math.max(0, (innerHeight * 0.9 - r.top) / (innerHeight * 0.5)));
      balance.style.setProperty('--tilt', `${(-9 * k).toFixed(2)}`);
    }
    if (road && article) {
      const r = article.getBoundingClientRect();
      road.style.setProperty('--draw', Math.min(1, Math.max(0, (innerHeight * 0.7 - r.top - innerHeight) / (r.height - innerHeight))).toFixed(4));
    }
  };
  let raf = 0;
  if (still) { balance?.style.setProperty('--tilt', '-9'); road?.style.setProperty('--draw', '1'); }
  else { addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(frame); }, { passive: true }); frame(); }

  // two modes, one cluster: the switch swaps the screen and what it shows
  const modes = document.querySelector<HTMLElement>('[data-modes]');
  modes?.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
    const m = b.dataset.mode!;
    modes.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    modes.querySelectorAll<HTMLElement>('[data-shot]').forEach((x) => x.classList.toggle('on', x.dataset.shot === m));
    modes.querySelectorAll<HTMLElement>('[data-list]').forEach((x) => { x.hidden = x.dataset.list !== m; });
  }));
</script>
