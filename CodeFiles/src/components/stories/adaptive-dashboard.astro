<script>
  import { calm } from '../../lib/motion';
  const still = calm();

  // how far through a pinned section the page is: 0 as it pins, 1 as it lets go
  const through = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight))); };
  const story = document.querySelector<HTMLElement>('[data-pin="story"]');
  const beats = story ? [...story.querySelectorAll<HTMLElement>('[data-beat]')] : [];
  const ticks = story ? [...story.querySelectorAll<HTMLElement>('[data-tick]')] : [];
  const scrubs = [...document.querySelectorAll<HTMLElement>('[data-scrub]')];
  const delays = scrubs.map((el) => Number(el.style.getPropertyValue('--d') || 0));
  const gauge = document.querySelector<HTMLElement>('[data-pin="gauge"]');
  const needle = document.querySelector<SVGGElement>('[data-needle]');
  const verdict = document.querySelector<HTMLElement>('[data-verdict]');
  const asks = [...document.querySelectorAll<HTMLElement>('[data-ask]')];

  // the road: signposts sit where their chapter starts along the page; the car drives down it with the scroll
  const trip = document.querySelector<HTMLElement>('[data-trip]')!;
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const fill = document.querySelector<HTMLElement>('[data-fill]');
  const car = document.querySelector<HTMLElement>('[data-car]');
  const topbar = document.querySelector<HTMLElement>('.topbar');
  const road = document.querySelector<HTMLElement>('[data-road]');
  let lastY = scrollY;
  const stops = [...document.querySelectorAll<HTMLAnchorElement>('[data-stop]')];
  const chapters = stops.map((a) => document.getElementById(a.dataset.stop!)!);
  let starts: number[] = [];
  const place = () => {
    const top = trip.offsetTop, span = Math.max(1, trip.offsetHeight - innerHeight);
    starts = chapters.map((c) => Math.min(1, Math.max(0, (c.getBoundingClientRect().top + scrollY - top) / span)));
    stops.forEach((a, i) => a.parentElement!.style.setProperty('--at', `${starts[i] * 100}%`));
  };

  let raf = 0, settle = 0;
  const frame = () => {
    raf = 0;
    const span = Math.max(1, trip.offsetHeight - innerHeight);
    const p = Math.min(1, Math.max(0, (scrollY - trip.offsetTop) / span));
    if (rail && fill && car && road) {
      rail.classList.toggle('show', scrollY > innerHeight * 0.35);
      const y = `${(p * rail.offsetHeight).toFixed(1)}px`;
      car.style.setProperty('--y', y);
      fill.style.setProperty('--y', y);
      // lane markings stream past faster than the car moves, so it reads as driving; it leans into quick scrolls
      road.style.setProperty('--off', `${(-scrollY * 0.35).toFixed(1)}px`);
      const sway = Math.max(-10, Math.min(10, (scrollY - lastY) * 0.25));
      car.style.setProperty('--sway', `${sway.toFixed(2)}deg`);
      clearTimeout(settle);
      settle = window.setTimeout(() => car.style.setProperty('--sway', '0deg'), 120);
      let cur = 0;
      starts.forEach((s, i) => { if (p + 0.002 >= s) cur = i; });
      stops.forEach((a, i) => { a.classList.toggle('passed', i <= cur); a.setAttribute('aria-current', String(i === cur)); });
    }
    topbar?.style.setProperty('--p', p.toFixed(4));
    lastY = scrollY;
    if (story && beats.length && !still) {
      // each beat owns an equal slice of the scroll: it rises in, its words light up, then it lifts away for the next
      const t = through(story) * beats.length;
      beats.forEach((b, i) => {
        const l = t - i, last = i === beats.length - 1;
        const inn = Math.min(1, Math.max(0, (l + 0.15) / 0.3)), out = last ? 0 : Math.min(1, Math.max(0, (l - 0.8) / 0.2));
        b.style.setProperty('--l', Math.min(1, Math.max(0, l / 0.75)).toFixed(3));
        b.style.setProperty('--o', (inn * (1 - out)).toFixed(3));
        b.style.setProperty('--ty', `${((1 - inn) * 30 - out * 40).toFixed(1)}px`);
      });
      ticks.forEach((k, i) => k.classList.toggle('on', i <= Math.floor(Math.min(t, beats.length - 0.001))));
    }
    if (!still) {
      // measure every element first, then move them all: one layout pass per frame, not one per element
      const tops = scrubs.map((el) => el.getBoundingClientRect().top);
      scrubs.forEach((el, i) => {
        const e = Math.min(1, Math.max(0, (innerHeight * 0.98 - tops[i]) / (innerHeight * 0.4) - delays[i]));
        el.style.setProperty('--e', (e * (2 - e)).toFixed(3));   // eased out, so it settles gently
      });
    }
    if (gauge && needle && verdict) {
      const k = Math.min(1, through(gauge) * 1.15);
      needle.style.setProperty('--k', k.toFixed(4));
      asks.forEach((a, i) => a.classList.toggle('lit', k * asks.length > i + 0.2));
      const over = k > 0.72;
      verdict.classList.toggle('over', over);
      verdict.textContent = over ? 'Over budget' : 'Within budget';
    }
  };
  const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };
  place();
  addEventListener('resize', () => { place(); kick(); });
  addEventListener('load', () => { place(); kick(); });
  addEventListener('scroll', kick, { passive: true });
  frame();

</script>
