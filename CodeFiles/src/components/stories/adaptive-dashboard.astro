---
// The Adaptive Dashboard case study, written for someone who has never heard of the project. It opens by saying, in
// plain words, what an instrument cluster is and what changed, with the finished screen labelled part by part. Then
// the problem is told as a short scenario in words, an attention gauge fills into the red, and five chapters walk
// through it: the brief, research, prototyping, the cluster, the debrief. Everything moves with the scroll. On the left a road runs down the page:
// a car drives down it as you scroll, and the signposts beside it jump to each chapter. Shared behaviour (count-up
// numbers, the next-project link) lives in src/pages/work/[slug].astro.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ClusterPlayer from '../ClusterPlayer.astro';
import startup from '../../assets/hmi/01-startup.png';
import cruise from '../../assets/hmi/02-dashboard-main.png';
import traffic from '../../assets/hmi/03-traffic-main.png';
import alongside from '../../assets/hmi/06-blindspot-traffic.png';
import closing from '../../assets/hmi/07-proximity-warning.png';
import cutin from '../../assets/hmi/08-proximity-alert.png';
import pedestrian from '../../assets/hmi/09-proximity-alert-2.png';
import autopark from '../../assets/hmi/10-park-auto.png';
import reversing from '../../assets/hmi/11-parking-manual.png';
import braking from '../../assets/hmi/12-crash-alert.png';
import flows from '../../assets/hmi/flows.jpg';
import sbBlind from '../../assets/hmi/sb-blindspot.jpg';
import sbExit from '../../assets/hmi/sb-exit.jpg';
import sbPed from '../../assets/hmi/sb-pedestrian.jpg';
import sbPark from '../../assets/hmi/sb-parking.jpg';
import toyLane from '../../assets/hmi/toy-lane.jpg';
import toyChange from '../../assets/hmi/toy-change.jpg';
import toyKeep from '../../assets/hmi/toy-keep.jpg';
import toyPark from '../../assets/hmi/toy-park.jpg';

type P = CollectionEntry<'projects'>;
interface Props { project: P; next: P }
const { project, next } = Astro.props;
const p = project.data;
const cluster = p.blocks.find((b) => b.type === 'cluster') as Extract<typeof p.blocks[number], { type: 'cluster' }> | undefined;

const route = [
  { id: 'start', t: 'What it is' }, { id: 'problem', t: 'The problem' }, { id: 'brief', t: 'The brief' }, { id: 'notes', t: 'Research' },
  { id: 'proto', t: 'Prototyping' }, { id: 'cluster', t: 'The cluster' }, { id: 'debrief', t: 'Debrief' },
];
// the finished home screen, labelled: marker positions are percentages of the 1400 × 700 screenshot
const parts = [
  { x: 7, y: 27, t: 'Speed', d: "How fast you're going. The ring around it changes colour with the danger level." },
  { x: 93, y: 27, t: 'Revs', d: 'Engine revs, shown on the open road and hidden in traffic.' },
  { x: 39, y: 16, t: 'Road signs', d: "The speed limit and road rules, read by the car's camera." },
  { x: 59, y: 60, t: 'Your car', d: 'Your car and the road ahead, with the cars around it.' },
  { x: 59, y: 84, t: 'Cruise control', d: 'Adaptive cruise is on, holding 100 km/h.' },
  { x: 60, y: 96, t: 'Status bar', d: 'Fuel, drive mode and engine temperature.' },
];
const how = [
  { t: 'The car senses', d: 'Speed, map position, cameras and radar.' },
  { t: 'It picks a mode', d: 'Open road or traffic, from speed and surroundings.' },
  { t: 'It ranks the danger', d: 'Clear, aware, caution or act, shown by the ring.' },
  { t: 'It speaks up only when needed', d: 'A critical event takes over the whole screen.' },
];
// the problem, told as a short scenario; each beat's words light up as you scroll through it
const beats = [
  { k: '9:04 pm', t: "You're driving home. It's raining, and traffic has slowed to a crawl." },
  { k: '9:05 pm', t: 'Brake lights flash ahead. A scooter squeezes past on your left.' },
  { k: 'Behind the wheel', t: 'The screen shows everything at once: speed, revs, a song, a missed call, a fuel warning.' },
  { k: 'The moment', t: 'You look down to find the one thing that matters.' },
  { k: 'The problem', t: 'For two seconds, nobody is watching the road.' },
];
const load = ['Speed', 'Revs', 'Media', 'Maps', 'Calls', 'Alerts', 'Climate', 'Range'];
const log = [
  { s: 'hi', t: 'Alerts buried under everything else on screen' },
  { s: 'hi', t: 'Settings that need eyes off the road' },
  { s: 'md', t: 'Pop-ups cutting across navigation' },
  { s: 'md', t: 'Turn instructions that arrive too late' },
  { s: 'md', t: 'Targets too small to hit at speed' },
  { s: 'lo', t: 'Animation that pulls focus for nothing' },
  { s: 'lo', t: 'Text too small to read in a glance' },
  { s: 'lo', t: 'Stress climbing in heavy traffic' },
];
const patterns = [
  { t: 'Speed gets checked every few seconds', d: 'On open roads it is the one number drivers return to.', shot: cruise, alt: 'Highway screen with the speed large on the left' },
  { t: 'What matters changes with the road', d: 'Navigation in new places, cameras in tight spots, the gap in traffic.', shot: traffic, alt: 'Traffic mode with map and proximity view' },
  { t: 'Urgent and trivial look the same', d: 'When every alert shouts, the one that matters is lost.', shot: cutin, alt: 'Red ring and warning sign for a cut-in' },
  { t: 'Touch costs attention', d: 'Every tap is a look away. Fewer taps, bigger targets.', shot: autopark, alt: 'Auto park asks for one tap to confirm' },
];
// the research board's key sticky notes, grouped under the question they answer (from the project's Miro board)
const board = [
  { q: 'What matters most while driving?', c: 'y', notes: ['Speed visibility', 'Navigation directions', 'Blind spot warnings', 'Fuel or battery range'] },
  { q: 'How does that change with the situation?', c: 'g', notes: ['Navigation in unfamiliar areas', 'Parking cameras in tight spaces', 'ADAS alerts at night', 'A simpler screen in rain'] },
  { q: 'What distracts the most?', c: 'p', notes: ['Touchscreen climate controls', 'Typing a destination', 'Deep menus', 'Switching between screens'] },
  { q: 'What would reduce the effort?', c: 'b', notes: ['Larger icons and buttons', 'Information that fits the moment', 'Physical controls for essentials', 'Fewer things on screen while moving'] },
];
const spec = [
  ['Show', 'Only what this road needs, right now'],
  ['Rank', 'Safety first, everything else after'],
  ['Read', 'Whole state in one glance'],
  ['Touch', 'As little as possible, never in menus'],
];
const scale = [
  { src: traffic, c: '#3FD07A', t: 'Clear', d: 'Nothing near' },
  { src: alongside, c: '#E8D53A', t: 'Aware', d: 'Car alongside' },
  { src: closing, c: '#F08A2C', t: 'Caution', d: 'Gap closing' },
  { src: cutin, c: '#E8343C', t: 'Act', d: 'Cut-in' },
];
const pressure = [
  { src: braking, t: 'Emergency braking', d: 'The whole screen turns red. One message, nothing competing with it.', alt: 'The cluster washed red with the words Emergency Braking' },
  { src: pedestrian, t: 'Someone steps out', d: 'A red cone points at the person, so the warning says where, not just what.', alt: 'Pedestrian Detected warning with a red cone ahead of the car' },
  { src: reversing, t: 'Backing in', d: 'The cluster becomes the rear camera, with arcs that tighten as you get close.', alt: 'Rear camera view beside a top-down car with sensor arcs' },
  { src: startup, t: 'Key on', d: 'Every warning light checks itself once, then clears before you move.', alt: 'Startup screen with gauges at zero and all warning lights on' },
];
const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8" /><path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12" /></svg>';
const pad = (n: number) => String(n).padStart(2, '0');
---
<article class="trip" aria-labelledby="case-h" data-trip>
  <!-- the route rail: follows the reader; each stop jumps to its chapter -->
  <nav class="rail" aria-label="Chapters" data-rail>
    <span class="road" aria-hidden="true" data-road><span class="driven" data-fill></span>
      <svg class="car" data-car viewBox="0 0 24 40"><path class="beam" d="M5 38 L-4 70 H28 L19 38 Z" /><rect class="body" x="3" y="2" width="18" height="36" rx="6" /><rect class="glass" x="6" y="9" width="12" height="7" rx="2" /><rect class="glass" x="6" y="27" width="12" height="4" rx="1.5" /><rect class="tail" x="5" y="2" width="4" height="2" rx="1" /><rect class="tail" x="15" y="2" width="4" height="2" rx="1" /></svg>
    </span>
    <ol>{route.map((r) => <li><a href={`#${r.id}`} data-stop={r.id}><span class="sign" aria-hidden="true"></span><span class="lbl">{r.t}</span></a></li>)}</ol>
  </nav>
  <span class="topbar" aria-hidden="true"><span></span><svg class="mini" viewBox="0 0 40 24"><rect x="2" y="3" width="36" height="18" rx="6" /><rect x="26" y="6" width="7" height="12" rx="2" class="glass" /></svg></span>

  <!-- WHAT IT IS: plain words first, then the finished screen, labelled -->
  <section id="start" class="sec wrap intro" data-ch>
    <header class="ident">
      <p class="mono acc">HMI · instrument cluster concept</p>
      <h1 id="case-h">{p.title}</h1>
      <p class="line">A redesign of the screen behind the steering wheel, so it shows less as driving gets harder.</p>
    </header>
    <ol class="plain">
      <li data-scrub><p class="mono acc">The screen</p><p>An instrument cluster is the display behind the wheel. It shows your speed, fuel and warnings.</p></li>
      <li data-scrub style="--d:.12"><p class="mono acc">The problem</p><p>Today it shows everything, all the time. Warnings get lost, and drivers look away from the road to find things.</p></li>
      <li data-scrub style="--d:.24"><p class="mono acc">The idea</p><p>Let it change with the road: calm on the highway, focused in traffic, loud only when something is dangerous.</p></li>
    </ol>
    <figure class="labelled" data-scrub="pop">
      <div class="shot">
        <Image src={cruise} alt="The finished cluster's home screen on the open road" widths={[700, 1100, 1600]} sizes="(min-width: 1100px) 720px, 100vw" loading="eager" fetchpriority="high" />
        {parts.map((pt, i) => <span class="mark" style={`left:${pt.x}%; top:${pt.y}%; --k:${i}`} aria-hidden="true">{i + 1}</span>)}
      </div>
      <figcaption>
        <p class="mono muted">The home screen, on the open road</p>
        <ol class="legend">{parts.map((pt, i) => <li data-scrub="left" style={`--d:${i * 0.06}`}><span class="n" aria-hidden="true">{i + 1}</span><span><b>{pt.t}</b> {pt.d}</span></li>)}</ol>
      </figcaption>
    </figure>
    <dl class="meta-row">
      <div><dt class="mono">Role</dt><dd>{p.role.join(', ')}</dd></div>
      <div><dt class="mono">Length</dt><dd>{p.duration}</dd></div>
      <div><dt class="mono">Made with</dt><dd>{p.tools.join(', ')}</dd></div>
    </dl>
  </section>

  <!-- THE PROBLEM: a scenario in words only, one beat at a time -->
  <section id="problem" class="pin story" data-ch data-pin="story" style={`--n:${beats.length}`} aria-labelledby="pb-h">
    <div class="stage">
      <h2 id="pb-h" class="mono acc scene-k">The problem, as a scenario</h2>
      <ol class="beats">
        {beats.map((b, i) => {
          const words = b.t.split(' ');
          return <li data-beat={i} class:list={{ last: i === beats.length - 1 }} style={`--wc:${words.length}`}>
            <span class="mono when">{b.k}</span>
            <p class="beat">{words.map((w, j) => <span style={`--w:${j}`}>{w} </span>)}</p>
          </li>;
        })}
      </ol>
      <span class="ticks" aria-hidden="true">{beats.map((_, i) => <i data-tick={i}></i>)}</span>
    </div>
  </section>

  <!-- the attention gauge fills as the screen asks for more -->
  <section class="pin gauge" data-pin="gauge" aria-labelledby="g-h">
    <div class="stage">
      <p class="mono acc">Attention budget</p>
      <h2 id="g-h" class="h2">Everything asks for a look</h2>
      <svg class="dial" viewBox="0 0 240 150" aria-hidden="true">
        <path class="arc" d="M30 130 A90 90 0 0 1 210 130" pathLength="1" />
        <path class="arc red" d="M30 130 A90 90 0 0 1 210 130" pathLength="1" />
        <g class="needle" data-needle><line x1="120" y1="130" x2="120" y2="54" /><circle cx="120" cy="130" r="7" /></g>
      </svg>
      <p class="verdict mono" data-verdict>Within budget</p>
      <ul class="asks">{load.map((l) => <li data-ask>{l}</li>)}</ul>
    </div>
  </section>

  <!-- 01 THE BRIEF -->
  <section id="brief" class="sec wrap" data-ch>
    <p class="chap mono"><span>01</span>The brief</p>
    <p class="question" data-scrub>Can a cluster show <em>less</em> and still make sure nothing important is missed?</p>
    <p class="aside" data-scrub>The answer was not a quieter screen. It was a screen that knows which road it is on.</p>

    {cluster && (
      <div class="screens">
        <h3 class="h3" data-scrub>Every screen, by type</h3>
        <p class="muted lede-s" data-scrub>Highway, traffic and parking. Pick a type, then a moment, to see what the cluster shows and why.</p>
        <ClusterPlayer block={cluster} />
      </div>
    )}

    <p class="mono muted aud" data-scrub>Designed for drivers aged 25 to 35</p>
    <dl class="spec" data-scrub>
      {spec.map(([k, v]) => <div><dt class="mono acc">{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </section>

  <!-- 02 RESEARCH -->
  <section id="notes" class="sec wrap" data-ch>
    <p class="chap mono"><span>02</span>Research</p>
    <h2 class="display" data-scrub>What shaped it</h2>
    <div class="readouts" data-scrub>
      <p><b class="num" data-count="4">4</b><span class="mono">questions asked</span></p>
      <p><b class="num" data-count="2">2</b><span class="mono">road contexts</span></p>
      <p><b class="num" data-count="9">9</b><span class="mono">pain points</span></p>
      <p><b class="num" data-count="7">7</b><span class="mono">scenarios</span></p>
    </div>

    <h3 class="h3 sub" data-scrub>Logged complaints</h3>
    <ol class="log">
      {log.map((l, i) => <li data-scrub="left" style={`--d:${(i % 4) * 0.05}`}><span class="mono t">{`00:${pad(i * 7 + 3)}`}</span><span class:list={['sev', l.s]}>{l.s === 'hi' ? 'High' : l.s === 'md' ? 'Medium' : 'Low'}</span><span>{l.t}</span></li>)}
    </ol>

    <h3 class="h3 sub" data-scrub>Four patterns</h3>
    <ol class="patterns">
      {patterns.map((n, i) => (
        <li data-scrub="left">
          <span class="pn mono">{pad(i + 1)}</span>
          <div><p class="pt">{n.t}</p><p class="muted">{n.d}</p></div>
          <Image src={n.shot} alt={n.alt} widths={[500, 900]} sizes="(min-width: 1100px) 380px, 100vw" data-scrub="right" />
        </li>
      ))}
    </ol>

    <h3 class="h3 sub" data-scrub>From the research board</h3>
    <div class="board">
      {board.map((col, i) => (
        <div class="col" data-scrub style={`--d:${i * 0.08}`}>
          <p class="q">{col.q}</p>
          <ul>{col.notes.map((n, j) => <li class:list={['sticky', col.c]} style={`--r:${((i + j) % 3 - 1) * 1.4}deg`}>{n}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <!-- 03 PROTOTYPING -->
  <section id="proto" class="sec wrap" data-ch>
    <p class="chap mono"><span>03</span>Prototyping</p>
    <h2 class="display" data-scrub>From storyboard to bench test</h2>

    <div class="stage-row">
      <div class="stage-txt" data-scrub><p class="mono acc">A · Storyboards</p><p class="st">Seven moments, six frames each.</p><p class="muted">Four shown: blind spot, exit, pedestrian, parking.</p></div>
      <div class="grid2" data-scrub="pop">
        {[[sbBlind, 'Blind spot on the highway'], [sbExit, 'Taking an exit'], [sbPed, 'Pedestrian in traffic'], [sbPark, 'Parking in town']].map(([src, t]) => (
          <figure><Image src={src as ImageMetadata} alt={`Storyboard: ${t}`} widths={[600, 1100]} sizes="(min-width: 1100px) 420px, 100vw" /><figcaption class="mono muted">{t}</figcaption></figure>
        ))}
      </div>
    </div>
    <div class="stage-row">
      <div class="stage-txt" data-scrub><p class="mono acc">B · Bench test</p><p class="st">Model cars, a paper road.</p><p class="muted">Each scenario acted out, warnings drawn where the screen would put them.</p></div>
      <div class="grid2" data-scrub="pop">
        {[[toyLane, 'Drifting out of lane'], [toyChange, 'Clear to change lanes'], [toyKeep, 'Holding the lane'], [toyPark, 'Too close while parking']].map(([src, t]) => (
          <figure><Image src={src as ImageMetadata} alt={`Model cars on a paper road: ${t}`} widths={[500, 900]} sizes="(min-width: 1100px) 420px, 100vw" /><figcaption class="mono muted">{t}</figcaption></figure>
        ))}
      </div>
    </div>
    <div class="stage-row">
      <div class="stage-txt" data-scrub><p class="mono acc">C · Logic</p><p class="st">Sensor in, screen out.</p><p class="muted">Each scenario mapped, including the moment a warning becomes an alert.</p></div>
      <figure data-scrub="pop"><Image class="wide" src={flows} alt="User and system flowcharts for lane change, speed breaker and traffic mode" widths={[800, 1400]} sizes="(min-width: 1100px) 860px, 100vw" /></figure>
    </div>

    <div class="cut" data-scrub="pop">
      <p class="mono acc">What got cut</p>
      <h3 class="h3">The rev counter, in traffic</h3>
      <div class="vs">
        <figure><Image src={cruise} alt="Highway screen with speed and rpm gauges" widths={[500, 900]} sizes="(min-width: 1100px) 520px, 100vw" /><figcaption><span class="mono">Kept on the highway</span>Speed and revs side by side.</figcaption></figure>
        <figure><Image src={traffic} alt="Traffic screen with the rpm gauge removed" widths={[500, 900]} sizes="(min-width: 1100px) 520px, 100vw" /><figcaption><span class="mono acc">Dropped in traffic</span>At walking pace revs say nothing. The space goes to the map and the cars around you.</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- 04 THE CLUSTER -->
  <section id="cluster" class="sec wrap" data-ch>
    <p class="chap mono"><span>04</span>The cluster</p>
    <h2 class="display" data-scrub>One ring, four levels</h2>
    <ol class="how">{how.map((h, i) => <li data-scrub style={`--d:${i * 0.1}`}><span class="mono acc">{pad(i + 1)}</span><p class="pt">{h.t}</p><p class="muted">{h.d}</p></li>)}</ol>
    <p class="aside" data-scrub>The ring around the speed carries the threat level. You feel the colour change before you read a word.</p>
    <div class="scale" data-scrub="pop">
      <span class="bar" aria-hidden="true"></span>
      <ol>{scale.map((r) => <li style={`--c:${r.c}`}><Image src={r.src} alt={`${r.t}: ${r.d}`} widths={[400, 800]} sizes="(min-width: 1100px) 290px, 50vw" /><p><b>{r.t}</b><span class="muted">{r.d}</span></p></li>)}</ol>
    </div>

    <h3 class="h3 sub" data-scrub>Under pressure</h3>
    <ul class="pressure">
      {pressure.map((e, i) => (
        <li data-scrub="pop" style={`--d:${(i % 2) * 0.1}`}>
          <Image src={e.src} alt={e.alt} widths={[600, 1100]} sizes="(min-width: 1100px) 560px, 100vw" />
          <p class="pt">{e.t}</p><p class="muted">{e.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 05 DEBRIEF: the same clip, now with the cluster -->
  <section id="debrief" class="sec wrap" data-ch>
    <p class="chap mono"><span>05</span>Debrief</p>
    <p class="echo" data-scrub>Back to 9:04 pm. Same rain, same traffic.</p>
    <p class="echo acc" data-scrub style="--d:.1">Now the screen shows the car ahead, the gap and the next turn. Your eyes stay on the road.</p>
    <figure class="replay" data-scrub="pop">
      <Image src={traffic} alt="Traffic mode: speed ring, the car ahead, map and range" widths={[800, 1400, 2000]} sizes="(min-width: 1300px) 1240px, 100vw" />
    </figure>
    <div class="cols">
      {[
        { k: 'Worked', v: ['Every screen traces back to a research question', 'One ring carries four threat levels', 'Bench tests made each scenario concrete'] },
        { k: 'Fell short', v: ['Speed and range never change between screens', 'Three storyboarded scenarios have no final screen'] },
        { k: 'Next', v: ['Screens for fatigue, speed breakers and motorcycles', 'A sound and a vibration for each ring level', 'Glance tests with drivers in a simulator'] },
      ].map((c, i) => <div data-scrub style={`--d:${i * 0.1}`}><p class="mono acc">{c.k}</p><ul>{c.v.map((x) => <li>{x}</li>)}</ul></div>)}
    </div>
    <p class="mono muted small">Concept work, not affiliated with Porsche.</p>
  </section>

  <section class="sec wrap next" aria-labelledby="next-h">
    <p class="mono acc">Next project</p>
    <a class="next-link" href={`/work/${next.id}`} id="next-h">{next.data.title} <span class="t-learn-chevron" set:html={arrow} /></a>
  </section>
</article>

<style>
  .trip { position: relative; overflow-x: clip; }
  .mono { font-family: var(--font-mono); font-size: var(--t-label); font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .acc { color: var(--accent); }
  .muted { color: var(--graphite); }
  .small { font-size: 11px; }
  p, li { text-wrap: pretty; }
  .sec { position: relative; max-width: 1300px; margin-inline: auto; padding-top: clamp(120px, 14vw, 220px); scroll-margin-top: 16px; }
  .h2 { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(2rem, 1rem + 3vw, 3.8rem); letter-spacing: -.03em; line-height: 1.02; text-wrap: balance; }
  .h3 { font-size: clamp(1.3rem, 1rem + .8vw, 1.8rem); font-weight: 600; letter-spacing: -.015em; line-height: 1.2; }
  .sub { margin-top: clamp(80px, 9vw, 130px); }
  .display { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(2.6rem, 1rem + 5vw, 6.4rem); letter-spacing: -.04em; line-height: .95;
    margin-top: var(--s-5); max-width: 16ch; text-wrap: balance; }
  .chap { display: flex; align-items: center; gap: 14px; color: var(--graphite); }
  .chap span { color: var(--accent); font-size: 1.1rem; letter-spacing: 0; }
  .chap::after { content: ''; flex: 1; height: 1px; background: color-mix(in srgb, var(--ink) 14%, transparent); }

  /* the road: fixed at the left; its lane markings scroll past and the car drives down it as you read */
  .rail { position: fixed; z-index: 30; left: clamp(14px, 1.6vw, 28px); top: 50%; translate: 0 -50%; height: min(66vh, 560px); display: flex; opacity: 0;
    transition: opacity 400ms var(--ease-smooth-out); pointer-events: none; }
  .rail.show { opacity: 1; pointer-events: auto; }
  .road { position: absolute; left: 0; top: -16px; bottom: -16px; width: 30px; border-radius: 8px; background-color: #17110f;
    box-shadow: inset 2px 0 0 hsl(0 0% 100% / .35), inset -2px 0 0 hsl(0 0% 100% / .35), 0 8px 24px hsl(0 0% 0% / .4);
    background-image: linear-gradient(hsl(48 90% 70% / .85) 50%, transparent 50%); background-size: 2px 22px; background-repeat: repeat-y;
    background-position: 50% var(--off, 0px); }
  .driven { position: absolute; inset: 0 0 auto; height: calc(16px + var(--y, 0px)); border-radius: 8px 8px 0 0;
