---
import '../styles/global.css';
import '../styles/motion.css';
import Chrome from '../components/Chrome.astro';
import Footer from '../components/Footer.astro';
import GridOverlay from '../components/GridOverlay.astro';
import Toast from '../components/Toast.astro';
import Hud from '../components/Hud.astro';
import { site } from '../site';

interface Props { title?: string; description?: string; section: string; image?: string; noindex?: boolean }
const { title, description = site.description, section, image = '/og.png', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.role}`;
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/', Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0B0D12" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/geist-mono-400.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Apply the saved theme before first paint, so there is no flash of the wrong one -->
  <script is:inline>
    try {
      const t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      if (t === 'light') document.querySelector('meta[name="theme-color"]').content = '#F3F2EE';
    } catch {}
    // Reveal-on-scroll elements start hidden only when JS runs; if the motion script never arrives, show everything
    document.documentElement.classList.add('js');
    setTimeout(() => { if (!document.documentElement.classList.contains('motion-ready')) document.documentElement.classList.add('reveal-all'); }, 2500);
  </script>
  <slot name="head" />
</head>
<body id="top">
  <a class="skip" href="#main">Skip to content</a>
  <div class="ambient" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="progress" aria-hidden="true"></div>
  <Chrome />
  <main id="main"><slot /></main>
  <Footer />
  <GridOverlay />
  <Toast />
  <Hud section={section} />
  <script>
    // Theme toggle: flips between light and dark from whatever is showing now, and remembers the choice.
    const root = document.documentElement;
    const isDark = () => root.dataset.theme !== 'light';   // dark is the default theme
    const label = () => document.querySelectorAll('[data-theme-label]').forEach((el) => (el.textContent = isDark() ? 'Light' : 'Dark'));
    label();
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', () => {
      root.dataset.theme = isDark() ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = isDark() ? '#0B0D12' : '#F3F2EE';
      label();
    }));

    // Copy email. The elements are real mailto links, so they still work without JS or a clipboard.
    const toast = document.querySelector<HTMLElement>('[data-toast]');
    document.querySelectorAll<HTMLElement>('[data-copy-email]').forEach((b) => b.addEventListener('click', async (e) => {
      e.preventDefault();
      const email = b.dataset.copyEmail!;
      try { await navigator.clipboard.writeText(email); } catch { location.href = `mailto:${email}`; return; }
      if (!toast) return;
      toast.textContent = 'Email copied'; toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 1800);
    }));

    // The phone menu covers the page, so close it when focus leaves it (otherwise Tab lands on hidden content).
    const menu = document.getElementById('menu');
    menu?.addEventListener('focusout', (e) => { if (!menu.contains(e.relatedTarget as Node)) menu.hidePopover(); });

    // G toggles the grid overlay (ignored while typing).
    const overlay = document.querySelector<HTMLElement>('[data-grid-overlay]');
    addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key.toLowerCase() !== 'g' || e.metaKey || e.ctrlKey || e.altKey || t.closest('input, textarea, [contenteditable]')) return;
      if (overlay) overlay.hidden = !overlay.hidden;
    });
  </script>
  <script>
    import '../scripts/motion';
  </script>
</body>
</html>
