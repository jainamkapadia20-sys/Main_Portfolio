---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" noindex>
  <section class="wrap top" aria-labelledby="nf-h">
    <h1 id="nf-h" class="display">This page took a wrong turn</h1>
    <p class="lead muted">The link may be old. The work is still here.</p>
    <div class="actions"><a class="btn primary" href="/work">See the work</a><a class="btn" href="/">Home</a></div>
  </section>
</Base>

<style>
  .top { padding-top: calc(var(--nav-h) + clamp(48px, 8vw, 120px)); display: grid; gap: 24px; justify-items: start; }
  .display { max-width: 12ch; }
  .actions { display: flex; gap: 12px; }
</style>
