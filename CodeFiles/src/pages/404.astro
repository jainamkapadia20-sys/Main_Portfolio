---
import Base from '../layouts/Base.astro';
import Pill from '../components/Pill.astro';
---
<Base title="Page not found" section="404" noindex>
  <div class="page wrap">
    <p class="code display" aria-hidden="true">404</p>
    <h1>Wrong turn. This page doesn't exist, or it moved.</h1>
    <p class="actions"><Pill href="/" label="Back to the index" tone="accent" /> <Pill href="/work" label="See the work" /></p>
  </div>
</Base>

<style>
  .page { min-height: 80svh; padding-top: 120px; display: grid; align-content: center; gap: var(--s4); }
  .code { font-size: var(--t-hero); }
  h1 { font-size: var(--t-lead); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
