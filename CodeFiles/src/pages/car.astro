---
// The car page, off the main nav: a side project. The 3D model fills the first screen, the numbers and the build
// follow, and the photos come out only when the pointer crosses their full-screen panel.
import { getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CarModel from '../components/CarModel.astro';
import Trail from '../components/Trail.astro';
import { withBase } from '../lib/url';

const car = (await getEntry('car', 'city'))!;
const c = car.data;
const { Content } = await render(car);
const photos = await Promise.all(c.photos.map(async (ph) => (await getImage({ src: ph.src, width: 640, format: 'webp' })).src));
const specs = [
  { k: 'Engine', v: c.engine }, { k: 'Power', v: c.power }, { k: 'Torque', v: c.torque },
  { k: 'Gearbox', v: c.transmission }, { k: 'Size', v: c.dimensions }, { k: 'Colour', v: c.colour },
];
---
<Base title={`${c.make} ${c.title}`} description={`My ${c.year} ${c.make} City in ${c.colour}: specs, modifications and a 3D model built from scratch.`}>
  <section class="showroom" aria-labelledby="car-h">
    <CarModel versions={[{ label: 'Modified', url: withBase(c.model3d.modified) }, { label: 'Stock', url: withBase(c.model3d.stock) }]} />
    <div class="over">
      <h1 id="car-h" class="display" data-reveal>{c.make} City</h1>
      <p class="small muted" data-reveal style="--i:1">Drag to turn, pinch to zoom, double-click to reset</p>
    </div>
  </section>

  <div class="car wrap">
    <header class="intro">
      <p class="small muted" data-reveal>Off the clock</p>
      <div class="lead" data-reveal style="--i:1"><Content /></div>
      <dl class="specs" data-reveal style="--i:2">
        {specs.map((s) => <div><dt class="small muted">{s.k}</dt><dd>{s.v}</dd></div>)}
      </dl>
    </header>
    <section aria-labelledby="mods-h">
      <h2 id="mods-h" class="h2">What I've changed</h2>
      <ul class="mods">
        {c.mods.map((m, i) => <li data-reveal style={`--i:${i % 3}`}><h3>{m.name}</h3><p class="muted">{m.note}</p></li>)}
      </ul>
    </section>
  </div>

  <section class="section" aria-labelledby="ph-h">
    <div class="ph-head wrap">
      <h2 id="ph-h" class="head" data-reveal>On the road</h2>
      <p class="muted" data-reveal style="--i:1">Move across the screen and the photos follow you. {c.photos.length} shots, plates blurred.</p>
    </div>
    <Trail items={photos.map((src, i) => ({ src, alt: c.photos[i].alt }))} />
  </section>
</Base>

<style>
  .showroom { position: relative; height: 100svh; min-height: 560px; }
  .over { position: absolute; left: var(--inset); right: var(--inset); bottom: clamp(24px, 4vw, 48px); display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; pointer-events: none; }
  .car { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 48px 72px; padding-top: var(--section); align-items: start; }
  .intro { display: grid; gap: 24px; }
  .lead :global(p) { font-size: var(--t-lead); line-height: 1.4; letter-spacing: -.01em; }
  .specs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .specs div { padding: 16px 18px; border-radius: 14px; background: var(--surface); display: grid; gap: 2px; }
  .specs dd { font-weight: 500; }
  .h2 { font-size: var(--t-small); font-weight: 500; letter-spacing: 0; color: var(--graphite); margin-bottom: 20px; }
  .mods { display: grid; gap: 24px; }
  .mods h3 { font-size: clamp(1.25rem, 1rem + .8vw, 1.75rem); letter-spacing: -.02em; margin-bottom: 4px; }
  .ph-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px 24px; flex-wrap: wrap; margin-bottom: 24px; }
  @media (max-width: 860px) {
    .car { grid-template-columns: 1fr; }
    .specs { grid-template-columns: 1fr; }
  }
</style>
