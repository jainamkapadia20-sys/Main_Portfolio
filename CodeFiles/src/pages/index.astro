---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroName from '../components/HeroName.astro';
import Intro from '../components/Intro.astro';
import Roles from '../components/Roles.astro';
import Cta from '../components/Cta.astro';
import GlassCarousel from '../components/GlassCarousel.astro';
import SideWork from '../components/SideWork.astro';
import Motivation from '../components/Motivation.astro';
import Music from '../components/Music.astro';
import Road from '../components/Road.astro';
import { site } from '../site';
import render from '../assets/car/poster-mod.png';

const feels = ['intuitive', 'delightful', 'effortless', 'human', 'memorable', 'thoughtful'];
// side work, by category: the one finished piece on hand, and labelled placeholders for the rest
const honda = (await getImage({ src: render, width: 1400, format: 'webp' })).src;
const ph = (titles: string[], note?: string) => titles.map((title) => ({ title, note }));
const side = [
  { name: 'Artwork', pieces: ph(['Ink study', 'Portrait', 'Gouache landscape', 'Figure drawing'], 'Artwork') },
  { name: 'Prototypes', pieces: ph(['Booking flow', 'Smart-home app', 'Onboarding', 'Micro-interactions'], 'Prototype') },
  { name: 'Graphic design', pieces: ph(['Poster study', 'Brand mark', 'Type specimen', 'Album cover'], 'Graphic design') },
  { name: 'Sketches', pieces: ph(['Sketchbook page', 'Product sketch', 'Car sketch', 'Thumbnails'], 'Drawing') },
  { name: '3D & renders', pieces: [{ title: 'My Honda City, modelled from scratch', note: 'Blender render', src: honda, alt: 'Blender render of a grey Honda City with a rear wing.' }, ...ph(['Object study', 'Interior render'], '3D')] },
  { name: 'HMI concepts', pieces: ph(['Cluster concept', 'Infotainment home', 'Climate control'], 'HMI') },
  { name: 'Service design', pieces: ph(['Storyboard', 'Journey map', 'Blueprint'], 'Service design') },
  { name: 'Photography', pieces: ph(['Night drive', 'Street', 'Details'], 'Photography') },
];
const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8" /><path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12" /></svg>';
---
<Base>
  <!-- the opening plays on every load, never for reduced motion; decided before first paint so the page never flashes -->
  <script is:inline slot="head">
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('intro');
  </script>
  <Intro slot="intro" />
  <!-- Hero: one full screen over the glitter warp (the site background, strongest here);
       the name sits in the middle: it staggers in, then rests in a soft glitch. -->
  <section class="hero" aria-labelledby="hero-h">
    <h1 id="hero-h" class="hero-name">
      <span class="sr-only">{site.name}</span>
      <span class="name-fx" aria-hidden="true"><HeroName /></span>
    </h1>
    <div class="sheet">
        <p class="hero-roles" data-reveal style="--i:1">
          <span class="sr-only">Designing things that feel intuitive, delightful, effortless, human, memorable and thoughtful.</span>
          <Roles lead="Designing things that feel" items={feels} />
        </p>
        <div class="hero-actions" data-reveal style="--i:3">
          <Cta href="#work">See my work</Cta>
          <a class="btn" href="/about">About me</a>
        </div>
    </div>
    <span class="kana" lang="ja" aria-hidden="true">ジャイナム・カパディア</span>
    <div class="hero-bar meta"><span><span class="dot" aria-hidden="true"></span>{site.status}</span></div>
  </section>

  <!-- A neon tube lights up over the title, then every project on a spinning ring: point to focus, click to bring
       forward, click again to open -->
  <section class="featured" id="work" aria-labelledby="featured-h">
    <div class="wrap sec-head"><h2 id="featured-h" class="head" data-reveal>My Projects</h2></div>
    <GlassCarousel />
  </section>


  <SideWork categories={side} />

  <Motivation />


  <section class="section wrap note" aria-labelledby="note-h">
    <div class="letter">
      <h2 id="note-h" class="sr-only">A note from Jainam</h2>
      <span class="avatar" aria-hidden="true">JK</span>
      <p data-reveal>Hi, I'm Jainam. I'm a design student, and I like problems where people meet systems: an app on a busy commute, a warning in a car at 90 km/h, a service with too many steps.</p>
      <p data-reveal style="--i:1">I start with the people using the thing, get ideas onto paper early, and keep going until the design is clear before it is clever.</p>
      <p data-reveal style="--i:2">I'm looking for an internship where I can do that with a team.</p>
      <p class="sign" data-reveal style="--i:3">Jainam Kapadia<span class="muted small">Designer, student</span></p>
      <a class="t-learn" href="/about" data-reveal style="--i:4">More about me <span class="t-learn-chevron" set:html={arrow} /></a>
    </div>
    <aside class="panel onrepeat" aria-labelledby="music-h" data-reveal style="--i:2">
      <h3 id="music-h">On repeat while I design</h3>
      <Music uri={site.spotify.uri} label={site.spotify.label} />
    </aside>
  </section>

  <section class="section clock" aria-labelledby="clock-h">
    <Road>
      <div class="clock-copy">
        <h2 id="clock-h" class="head" data-reveal>Off the clock</h2>
        <p data-reveal style="--i:1">A 2016 Honda City that I keep changing, and a 3D model of it built from scratch in Blender. Press and hold the road to speed up.</p>
        <a class="t-learn" href="/car" data-reveal style="--i:2">See the car <span class="t-learn-chevron" set:html={arrow} /></a>
      </div>
    </Road>
  </section>
</Base>


<style>
  /* hero: one full screen. The name sits in the middle, edge to edge; the copy stacks centred under it. */
  .hero { position: relative; isolation: isolate; display: grid; grid-template-rows: 1fr auto auto 1fr auto; min-height: max(100svh, 640px); padding: var(--nav-h) var(--edge) 0; }
  /* a soft scrim in the page's own ground keeps the copy readable while the background moves behind it */
  .hero::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 46% 38% at 50% 48%, color-mix(in srgb, var(--paper) 85%, transparent), color-mix(in srgb, var(--paper) 50%, transparent) 55%, transparent 80%); }
  /* spacing on the 8-point scale: the name's drawing already holds room for its descenders, so the line sits close;
     the line and the intro belong together (16); the actions are their own group (32) */
  .hero-name { grid-row: 2; }
  .sheet { grid-row: 3; display: flex; flex-direction: column; align-items: center; padding: var(--s-2) var(--pad) 0; text-align: center; }
  .hero-actions { margin-top: var(--s-6); }
  .hero-actions { justify-content: center; }
  .hero-bar { grid-row: 5; }
  .name-fx { display: block; text-align: center; font-family: var(--font-display); font-size: var(--name-size, clamp(1.6rem, 4.6vw, 6rem)); font-weight: var(--display-weight); letter-spacing: var(--name-track, -.035em); line-height: 1.05; color: var(--ink); }
  .hero-roles { font-size: clamp(1.375rem, .95rem + 1.4vw, 2.25rem); letter-spacing: -.02em; line-height: 1.2; color: color-mix(in srgb, var(--ink) 88%, transparent); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .hero-bar { display: flex; justify-content: space-between; gap: 16px; padding: 10px var(--pad) 18px; }
  .hero-bar > span { display: inline-flex; align-items: center; gap: 10px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  :global(:root[data-motion="calm"]) .hint { display: none; }

  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap; margin-bottom: 48px; }
  .sec-head p { max-width: 44ch; }
  .featured { padding-top: 0; }
  /* the line from the primary action down to the neon tube; scripts below place it and draw it with the scroll */
  :global(#main) { position: relative; }

  .note { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: start; }
  .letter { display: grid; gap: 20px; max-width: 560px; font-size: var(--t-lead); line-height: 1.45; letter-spacing: -.01em; }
  .avatar { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: 1.125rem; font-weight: 500; }
  .sign { display: grid; gap: 2px; font-weight: 500; }
  .letter .t-learn { font-size: var(--t-body); }
  .onrepeat { margin: 0; padding: 28px; display: grid; gap: 20px; }
  .onrepeat h3 { font-size: var(--t-lead); }

  .clock-copy { display: grid; gap: 20px; justify-items: start; max-width: 520px; }

  @media (max-width: 860px) {
    .sheet { padding: 8px 8px 24px; }
    .hero-bar { flex-direction: column; padding-inline: 8px; }
    .note { grid-template-columns: 1fr; }
  }
</style>
