---
// Case study as a split stage. The stage on the left never moves: it plays the film while the column beside it
// gives the hook, the facts and the results, then crossfades to each process step's picture as that step arrives.
// The project's preview frame on the work list grows into this stage (shared view-transition name `case-media`).
import { getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import ClusterPlayer from '../../components/ClusterPlayer.astro';
import { sortedProjects } from '../../lib/projects';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const all = await sortedProjects();
  return all.map((project, i) => ({ params: { slug: project.id }, props: { project, next: all[(i + 1) % all.length] } }));
}
type P = CollectionEntry<'projects'>;
interface Props { project: P; next: P }
const { project, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);

const web = async (src: ImageMetadata, width = 1600) => (src.format === 'svg' ? src.src : (await getImage({ src, width, format: 'webp' })).src);
const film = p.blocks.find((b) => b.type === 'video' && b.src) as Extract<typeof p.blocks[number], { type: 'video' }> | undefined;
const cluster = p.blocks.find((b) => b.type === 'cluster') as Extract<typeof p.blocks[number], { type: 'cluster' }> | undefined;
const filmPoster = film?.poster ? await web(film.poster) : undefined;
const cover = p.cover ? await web(p.cover) : undefined;
// stage layers: the film (or cover) first, then one per process step that has a picture
const steps = await Promise.all(p.process.map(async (s) => ({
  ...s, img: s.media ? await web(s.media) : undefined,
  thumbs: s.gallery ? await Promise.all(s.gallery.map(async (g) => ({ src: await web(g.src, 800), alt: g.alt }))) : [],
})));
const facts = [
  { k: 'Role', v: p.role.join(', ') },
  { k: 'Type', v: p.type },
  { k: 'Tools', v: p.tools.join(', ') },
  { k: p.duration === 'To confirm' ? 'Year' : 'Duration', v: p.duration === 'To confirm' ? String(p.year) : `${p.duration}, ${p.year}` },
];
const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8" /><path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12" /></svg>';
---
<Base title={p.title} description={p.summary}>
  <div class="case">
    <!-- the stage: sticky on desktop, a framed header on phones -->
    <div class="stage" data-stage style="view-transition-name: case-media">
      <div class="layer on" data-layer="0">
        {film ? <video src={withBase(film.src!)} poster={filmPoster} muted loop playsinline autoplay controls preload="metadata" data-autoplay aria-label={film.alt}></video>
          : cover ? <img src={cover} alt={p.coverAlt} /> : <Placeholder ratio="4 / 3" label="Project film or cover" />}
      </div>
      {steps.map((s, i) => s.img && <div class="layer" data-layer={i + 1}><img src={s.img} alt={s.alt} loading="lazy" /></div>)}
      <p class="stage-cap small" data-cap aria-live="polite">{film ? 'Project film' : p.title}</p>
    </div>

    <article class="col">
      <a class="back t-learn muted small" href="/work"><span class="t-learn-chevron flip" set:html={arrow} />All work</a>
      <header class="intro">
        <p class="cat small"><span class="dot" aria-hidden="true"></span>{p.category}{p.placeholder && <span class="tag">Placeholder</span>}</p>
        <h1 class="title">{p.title}</h1>
        <p class="hook lead">{p.summary}</p>
      </header>

      <dl class="facts">
        {facts.map((f) => <div><dt class="small muted">{f.k}</dt><dd>{f.v}</dd></div>)}
      </dl>

      {p.results.length > 0 && (
        <section class="results" aria-labelledby="res-h" data-step="0">
          <h2 id="res-h" class="h2">What came out of it</h2>
          <ul>{p.results.map((r) => <li>{r}</li>)}</ul>
        </section>
      )}

      {steps.length > 0 && (
        <section class="process" aria-labelledby="proc-h">
          <h2 id="proc-h" class="h2">How I got there</h2>
          <ol class="steps">
            {steps.map((s, i) => (
              <li class="step" data-step={s.img ? i + 1 : undefined}>
                <div data-reveal>
                  <p class="phase small">{s.phase}</p>
                  <h3>{s.title}</h3>
                  <ul class="points">{s.points.map((pt) => <li>{pt}</li>)}</ul>
                  {s.img && <img class="inline" src={s.img} alt={s.alt} loading="lazy" />}
                  {s.thumbs.length > 0 && <div class="thumbs">{s.thumbs.map((t) => <img src={t.src} alt={t.alt} loading="lazy" />)}</div>}
                  {s.caption && <p class="cap small muted">{s.caption}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      {!steps.length && <div class="prose"><Content /></div>}
    </article>
  </div>

  {cluster && (
    <section class="section try" aria-labelledby="try-h">
      <div class="wrap try-head">
        <h2 id="try-h" class="head" data-reveal>Try the cluster</h2>
        <p class="muted" data-reveal style="--i:1">Pick a mode, then a moment. Each screen says what the car senses and what the driver sees.</p>
      </div>
      <ClusterPlayer block={cluster} />
    </section>
  )}

  {steps.length > 0 && (
    <section class="wrap full" aria-label="Full write-up">
      <details class="t-more">
        <summary>Read the full write-up</summary>
        <div class="prose"><Content /></div>
      </details>
    </section>
  )}

  <section class="section wrap next" aria-labelledby="next-h">
    <p class="small muted">Next project</p>
    <a class="next-link" href={`/work/${next.id}`} id="next-h">{next.data.title} <span class="t-learn-chevron" set:html={arrow} /></a>
  </section>
</Base>

<style>
  .case { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 12px; padding: var(--nav-h) var(--edge) 0; align-items: start; }
  .stage { position: sticky; top: calc(var(--nav-h)); height: calc(100svh - var(--nav-h) - var(--edge)); border-radius: var(--radius); overflow: hidden; background: #050505; }
  .layer { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; scale: 1.03; filter: blur(8px);
    transition: opacity 600ms var(--ease-smooth-out), scale 1000ms var(--ease-out-expo), filter 600ms var(--ease-smooth-out); }
  .layer.on { opacity: 1; scale: 1; filter: none; }
  .layer video, .layer img { width: 100%; height: 100%; object-fit: contain; }
  .layer :global(.ph) { height: 100%; }
  .stage-cap { position: absolute; left: 20px; bottom: 16px; padding: 6px 12px; border-radius: 999px; background: rgba(14, 14, 14, .72); color: #F2F2F0; pointer-events: none; }
  .layer video ~ * { pointer-events: none; }

  .col { padding: clamp(32px, 4vw, 64px) var(--pad) 0; display: grid; gap: 56px; align-content: start; }
  .back { justify-self: start; }
  .flip { transform: scaleX(-1); }
  .t-learn:hover .flip { transform: scaleX(-1) translateX(2px); }
  .intro { display: grid; gap: 18px; }
  .cat { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .title { font-size: clamp(2.75rem, 1rem + 4.6vw, 5.5rem); letter-spacing: -.045em; line-height: .95; }
  .hook { color: var(--ink); }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .facts div { padding: 16px 18px; border-radius: 14px; background: var(--surface); display: grid; gap: 2px; }
  .facts dd { font-weight: 500; }
  .h2 { font-size: var(--t-small); font-weight: 500; letter-spacing: 0; color: var(--graphite); margin-bottom: 20px; }
  .results ul { display: grid; gap: 14px; }
  .results li { font-size: var(--t-lead); line-height: 1.3; letter-spacing: -.015em; font-weight: 500; padding-left: 28px; position: relative; }
  .results li::before { content: ""; position: absolute; left: 0; top: .5em; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); }

  /* the process: a red line fills down the steps as you read */
  .steps { position: relative; display: grid; gap: 72px; padding-left: 28px; }
  .steps::before { content: ""; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: var(--surface-2); }
  .steps::after { content: ""; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: var(--accent);
    transform-origin: top; scale: 1 var(--fill, 0); }
  .step { position: relative; }
  .step::before { content: ""; position: absolute; left: -28px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: var(--paper); box-shadow: inset 0 0 0 2px var(--graphite);
    transition: background-color 300ms, box-shadow 300ms; z-index: 1; }
  .step.on::before { background: var(--accent); box-shadow: inset 0 0 0 2px var(--accent); }
  .phase { color: var(--accent); font-weight: 500; margin-bottom: 6px; }
  .step h3 { font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem); letter-spacing: -.03em; margin-bottom: 16px; }
  .points { display: grid; gap: 10px; }
  .points li { padding-left: 18px; position: relative; }
  .points li::before { content: ""; position: absolute; left: 0; top: .7em; width: 6px; height: 6px; border-radius: 50%; background: var(--graphite); }
  .inline { display: none; width: 100%; border-radius: 14px; margin-top: 20px; }
  .thumbs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 20px; }
  .thumbs img { border-radius: 10px; aspect-ratio: 2 / 1; object-fit: cover; width: 100%; background: var(--surface); }
  .cap { margin-top: 10px; }
  .prose { display: grid; gap: 16px; }
  .prose :global(h2) { font-size: var(--t-lead); margin-top: 24px; }

  .try-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px 24px; flex-wrap: wrap; margin-bottom: 40px; }
  .try-head p { max-width: 44ch; }
  .full { padding-top: 64px; }
  .t-more { max-width: 760px; border-radius: 14px; background: var(--surface); }
  .t-more summary { list-style: none; cursor: pointer; padding: 20px 24px; font-weight: 500; display: flex; justify-content: space-between; }
  .t-more summary::-webkit-details-marker { display: none; }
  .t-more summary::after { content: "+"; font-size: 1.25em; line-height: 1; transition: rotate var(--duration-fast) var(--ease-smooth-out); }
  .t-more[open] summary::after { rotate: 45deg; }
  .t-more .prose { padding: 0 24px 24px; }
  .next { display: grid; gap: 8px; }
  .next-link { display: inline-flex; align-items: center; gap: 16px; font-size: var(--t-display); font-weight: 500; letter-spacing: -.045em; line-height: 1; transition: color var(--duration-fast) var(--ease-smooth-out); }
  .next-link:hover { color: var(--accent); }
  .next-link :global(svg) { width: .5em; height: .5em; }
  .next-link .t-learn-chevron :global(svg) { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }

  :global(:root[data-motion="calm"]) .layer { scale: 1; filter: none; transition: opacity 300ms; }

  @media (max-width: 960px) {
    .case { grid-template-columns: 1fr; }
    .stage { position: relative; top: auto; height: auto; aspect-ratio: 16 / 10; }
    .layer:not([data-layer="0"]) { display: none; }
    .col { padding-inline: 8px; }
    .inline { display: block; }
    .facts { grid-template-columns: 1fr; }
  }
</style>

<script>
  // The stage follows the reading: whichever step crosses the middle of the screen owns the stage
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (stage) {
    const layers = [...stage.querySelectorAll<HTMLElement>('[data-layer]')];
    const cap = stage.querySelector<HTMLElement>('[data-cap]')!;
    const firstCap = cap.textContent;
    const film = stage.querySelector('video');
    const steps = [...document.querySelectorAll<HTMLElement>('.step')];
    const show = (n: number) => {
      layers.forEach((l) => l.classList.toggle('on', l.dataset.layer === String(n)));
      const step = steps.find((s) => s.dataset.step === String(n));
      cap.textContent = n === 0 ? firstCap : step?.querySelector('.cap')?.textContent ?? step?.querySelector('h3')?.textContent ?? '';
      if (film && n !== 0 && !film.paused) { film.dataset.auto = '1'; film.pause(); }
      if (film && n === 0 && film.paused && film.dataset.auto === '1') film.play().catch(() => {});
    };
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      steps.forEach((s) => s.classList.toggle('on', s === el || (steps.indexOf(s) < steps.indexOf(el))));
      if (el.dataset.step) show(+el.dataset.step);
    }), { rootMargin: '-45% 0px -45% 0px' });
    document.querySelectorAll<HTMLElement>('[data-step], .step').forEach((el) => io.observe(el));
    // back above the process: the film returns
    const res = document.querySelector('.results, .facts');
    if (res) new IntersectionObserver(([e]) => { if (e.isIntersecting) show(0); }, { rootMargin: '-45% 0px -45% 0px' }).observe(res);

    // the red line fills with how far the reader is through the steps
    const list = document.querySelector<HTMLElement>('.steps');
    if (list) {
      const fill = () => {
        const r = list.getBoundingClientRect();
        const t = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / r.height));
        list.style.setProperty('--fill', t.toFixed(3));
      };
      addEventListener('scroll', fill, { passive: true }); fill();
    }
  }
  // ← / → step to the next project (ignored while typing)
  addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' || (e.target as HTMLElement).closest('input, textarea, video')) return;
    document.querySelector<HTMLAnchorElement>('.next-link')?.click();
  });
</script>
