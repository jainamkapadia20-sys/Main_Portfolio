---
import Base from '../../layouts/Base.astro';
import WorkList from '../../components/WorkList.astro';
import { sortedProjects } from '../../lib/projects';

const projects = await sortedProjects();
const real = projects.filter((p) => !p.data.placeholder).length;
---
<Base title="Work" description="Projects by Jainam Kapadia across UI/UX, graphic, service and HMI design.">
  <section class="wrap top" aria-labelledby="work-h">
    <h1 id="work-h" class="display" data-reveal>Work</h1>
    <p class="lead muted" data-reveal style="--i:1">{projects.length} projects across UI/UX, graphic, service and HMI design. {real === 1 ? 'One is finished and documented; the rest are placeholders until their files arrive.' : ''}</p>
    <WorkList projects={projects} filter />
  </section>
</Base>

<style>
  .top { padding-top: calc(var(--nav-h) + clamp(48px, 8vw, 120px)); }
  .lead { margin: 20px 0 56px; max-width: 46ch; }
</style>
